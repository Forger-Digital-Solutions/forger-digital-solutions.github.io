# Kayla Copilot - Environment Configuration

# ============================================
# Kayla AI Provider Configuration
# ============================================

# Enable/disable Kayla AI features
KAYLA_ENABLED=false

# AI provider: 'mock' (for testing), 'openrouter', or leave empty for local-only mode
KAYLA_PROVIDER=

# Model to use (provider-specific)
KAYLA_MODEL=openrouter/free

# API key for the AI provider (NEVER commit real keys)
KAYLA_API_KEY=

# Custom API endpoint (optional)
KAYLA_ENDPOINT=

# ============================================
# Serverless Deployment Configuration
# ============================================

# Public API URL for deployed Kayla backend (set in GitHub Actions or hosting platform)
PUBLIC_KAYLA_API_URL=

# Allowed CORS origins (comma-separated, empty means same-origin or allow all)
KAYLA_ALLOWED_ORIGINS=https://forger-digital-solutions.github.io

# ============================================
# Request Limits
# ============================================

# Maximum message length in characters
KAYLA_MAX_MESSAGE_LENGTH=2000

# Maximum conversation history messages to include
KAYLA_MAX_HISTORY_MESSAGES=10

# Rate limit: requests per minute per IP
KAYLA_RATE_LIMIT_PER_MINUTE=5
KAYLA_RATE_LIMIT_PER_HOUR=20

# Globally coordinated OpenRouter request allowance (local answers do not consume it)
KAYLA_AI_DAILY_REQUEST_LIMIT=40

# Server secret used only to hash limiter identities (minimum 16 random characters)
KAYLA_RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Application-level request body limit
KAYLA_MAX_PAYLOAD_BYTES=16384

# Request timeout in milliseconds
KAYLA_PROVIDER_TIMEOUT_MS=12000

# Maximum retries for transient failures
KAYLA_MAX_RETRIES=0
