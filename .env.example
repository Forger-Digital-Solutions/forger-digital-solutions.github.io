# Kayla Copilot - Environment Configuration

# ============================================
# Kayla AI Provider Configuration
# ============================================

# Enable/disable Kayla AI features
KAYLA_ENABLED=false

# Ordered inference chain (Kayla 2.0): pipe-separated "provider:model"
# entries, tried in order. Every entry must be on the verified-free list —
# the server rejects anything else. Leave empty for local-only mode.
# Verified-free providers today: groq, openrouter (:free models), gemini.
KAYLA_ROUTES=groq:qwen/qwen3.8-27b|openrouter:openrouter/free

# Per-provider API keys, resolved by route provider name. In production these
# are Worker secrets; locally they live in worker/.dev.vars (gitignored).
# NEVER commit real keys.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Legacy single-provider deployment (used when KAYLA_ROUTES is empty).
# 'mock' (for testing), 'openrouter', 'groq', 'gemini', or empty for local-only.
KAYLA_PROVIDER=
KAYLA_MODEL=openrouter/free
KAYLA_API_KEY=
KAYLA_ENDPOINT=

# Operator token: gates the detailed fields of /api/kayla/health
# (budget counters, route list). Unset = health returns liveness only.
KAYLA_OPS_TOKEN=

# ============================================
# Serverless Deployment Configuration
# ============================================

# Public API URL for deployed Kayla backend (set in GitHub Actions or hosting platform)
PUBLIC_KAYLA_API_URL=

# Allowed CORS origins (comma-separated, empty means same-origin or allow all)
KAYLA_ALLOWED_ORIGINS=https://forger-digital-solutions.github.io

# ============================================
# Request Limits
# ============================================

# Maximum message length in characters
KAYLA_MAX_MESSAGE_LENGTH=2000

# Maximum conversation history messages to include
KAYLA_MAX_HISTORY_MESSAGES=10

# Rate limit: requests per minute per IP
KAYLA_RATE_LIMIT_PER_MINUTE=5
KAYLA_RATE_LIMIT_PER_HOUR=60

# Globally coordinated OpenRouter request allowance (local answers do not consume it)
KAYLA_AI_DAILY_REQUEST_LIMIT=40

# Server secret used only to hash limiter identities (minimum 16 random characters)
KAYLA_RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Application-level request body limit
KAYLA_MAX_PAYLOAD_BYTES=16384

# Request timeout in milliseconds
KAYLA_PROVIDER_TIMEOUT_MS=9000

# Maximum retries for transient failures
KAYLA_MAX_RETRIES=0
