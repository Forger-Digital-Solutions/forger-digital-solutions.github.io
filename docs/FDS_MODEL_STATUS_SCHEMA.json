{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgerdigitalsolutions.com/schemas/fds-model-status.schema.json",
  "title": "FDS Public Content & Model Status Registry Schema",
  "description": "Strict public-safe schema validating all FDS models, applications, research infrastructure, and original productions published on forgerdigitalsolutions.com.",
  "type": "object",
  "required": ["schema_version", "last_updated", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "division",
          "version",
          "development_status",
          "availability",
          "verified_capabilities",
          "known_limitations",
          "non_claims",
          "public_summary",
          "public_evidence",
          "route",
          "accent",
          "last_verified",
          "approved_for_publication"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": { "type": "string", "minLength": 2 },
          "category": {
            "type": "string",
            "enum": [
              "ai-model-family",
              "ai-model",
              "application",
              "research-infrastructure",
              "original-production",
              "legacy-product"
            ]
          },
          "division": {
            "type": "string",
            "enum": [
              "FDS Intelligence",
              "FDS Applications",
              "FDS Research",
              "FDS Original Productions",
              "Extended Portfolio"
            ]
          },
          "flagship": { "type": "boolean" },
          "version": { "type": "string", "minLength": 1 },
          "development_status": {
            "type": "string",
            "enum": [
              "research-vision",
              "foundation-available",
              "training-planned",
              "training-in-progress",
              "fine-tuning-completed",
              "experimental",
              "evaluated",
              "capability-certified",
              "active-development",
              "private-development",
              "public-preview",
              "public-release",
              "deprecated"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "not-publicly-available",
              "research-only",
              "downloads-paused",
              "public-preview",
              "public-release",
              "private-development"
            ]
          },
          "base_architecture": { "type": ["string", "null"] },
          "parameter_count": { "type": ["string", "null"] },
          "modalities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "license_info": { "type": ["string", "null"] },
          "verified_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "planned_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "known_limitations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "non_claims": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "public_summary": { "type": "string", "minLength": 20 },
          "public_evidence": { "type": "string", "minLength": 10 },
          "route": {
            "type": "string",
            "pattern": "^/[a-z0-9/-]*$"
          },
          "accent": {
            "type": "string",
            "enum": [
              "alexandrite",
              "hackmanite",
              "cinnabar",
              "jaspilite",
              "battleverse",
              "project-forge",
              "state-lines",
              "fds-cobalt",
              "neutral"
            ]
          },
          "last_verified": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "approved_for_publication": { "type": "boolean" }
        }
      }
    }
  }
}
