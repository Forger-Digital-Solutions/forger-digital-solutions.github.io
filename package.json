{
  "name": "forger-digital-solutions",
  "version": "1.0.0",
  "description": "Official public website for Forger Digital Solutions",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:knowledge": "node scripts/kayla-knowledge.mjs && node scripts/kayla-golden-check.mjs",
    "validate:links": "node scripts/check-internal-links.mjs",
    "validate": "node scripts/validate-content.mjs && node scripts/kayla-knowledge.mjs && node scripts/kayla-golden-check.mjs && astro check && astro build && node scripts/check-internal-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "kayla:knowledge": "node scripts/kayla-knowledge.mjs",
    "kayla:deploy:check": "node scripts/kayla-deploy-check.mjs",
    "kayla:deploy": "npm run kayla:deploy:check && npm --prefix worker run deploy",
    "kayla:verify:live": "node scripts/kayla-live-verify.mjs",
    "kayla:secret-scan": "node scripts/kayla-secret-scan.mjs",
    "worker:build": "npm --prefix worker run build",
    "astro": "astro",
    "worker:dev": "cd worker && npm run dev",
    "worker:deploy": "cd worker && npm run deploy",
    "kayla:golden": "node scripts/kayla-golden-check.mjs",
    "kayla:routing-eval": "node scripts/kayla-routing-eval.mjs",
    "kayla:retrieval-eval": "node scripts/kayla-retrieval-eval.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^11.1.4",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
