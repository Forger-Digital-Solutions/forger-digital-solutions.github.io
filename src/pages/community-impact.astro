---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../config/site';

const { communityFundingActive } = siteConfig;

// One status framework for the whole page: CONCEPT // EXPLORING for ideas,
// INITIATIVE // IN DEVELOPMENT for active work, INFRASTRUCTURE // NOT ACTIVE
// for the fund. Wording is deliberately unglamorous so exploratory concepts
// never read like running programs.
const initiatives = [
  {
    name: 'Affordable Communities',
    status: 'Concept // Exploring',
    kind: 'exploring' as const,
    description:
      'Exploring ways technology and transparent systems could support more affordable, sustainable communities — from shared-resource planning to open tools that help people understand and manage shared infrastructure.'
  },
  {
    name: 'Community Gardens',
    status: 'Concept // Exploring',
    kind: 'exploring' as const,
    description:
      'Community growing spaces, local food access, and shared infrastructure are on the long-term concept list. Ideas like sensor-driven growing data and open planning tools may connect FDS work with local food resilience.'
  },
  {
    name: 'Technology Reuse & Access',
    status: 'Initiative // In Development',
    kind: 'development' as const,
    description:
      'Capable equipment deserves a second life instead of a landfill. Donated hardware can support development, learning, families, and future community programs. Hardware intake is open today through the hardware donations page.'
  }
];

const fundingMechanisms = [
  'A dedicated financial account kept separate from ordinary FDS funds',
  'Fiscal sponsorship where appropriate',
  'A transparent contribution ledger published for the community',
  'Published project budgets before fundraising begins',
  'Published expenditures, receipts, and milestones',
  'Regular community reporting',
  'A multisignature wallet where appropriate'
];
---
<BaseLayout
  title="Community Impact"
  description="Future Forger Digital Solutions public-benefit concepts: affordable communities, community gardens, technology reuse and access — explored openly, funded separately."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Community Impact</span>
  </nav>

  <header class="ci-hero">
    <p class="ci-hero__eyebrow">Community Impact</p>
    <h1>Technology that gives back</h1>
    <p class="ci-hero__lead">
      Alongside its independent research and development work, FDS is exploring
      future public-benefit concepts. These are honest explorations — not
      active programs. Where an idea matures, it will be described here with
      real status and real structure.
    </p>
  </header>

  <section class="ci-section" aria-labelledby="initiatives-title">
    <SectionHeader eyebrow="Concept Areas" title="What FDS is exploring" />
    <div class="ci-grid">
      {initiatives.map((item) => (
        <article class="ci-card">
          <div class="ci-card__head"><h3>{item.name}</h3><span class:list={['ci-status', `ci-status--${item.kind}`]}>{item.status}</span></div>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ci-section" aria-labelledby="fund-title">
    <SectionHeader eyebrow="Separate by Design" title="Community Projects Fund" description="Infrastructure // Not active — the structure below is a plan, not an operating fund." />
    <div class="ci-fund">
      <p class="ci-fund__banner" role="note"><strong>Infrastructure // Not active.</strong> FDS is not accepting community-project contributions yet, and no community-project money is collected anywhere on this site.</p>
      <p>
        Community-project funding is deliberately separated from ordinary FDS
        development and hardware support. Supporting GEMS hardware does not
        fund a garden, and supporting a future community project must never be
        mistaken for buying a GPU. When the structure below is real, this page
        will say exactly what changed.
      </p>
      <ul role="list">
        {fundingMechanisms.map((m) => <li>{m}</li>)}
      </ul>
      <p class="ci-fund__note">
        No particular mechanism above is finalized. No wallet, ledger, or
        contribution channel exists yet{communityFundingActive ? '' : ', and collection remains disabled'}.
      </p>
    </div>
  </section>

  <section class="ci-section ci-section--last" aria-labelledby="devsupport-title">
    <SectionHeader eyebrow="Different Bucket" title="Want to support FDS itself?" description="Development and hardware support — Cash App, Ko-fi, and donated equipment — lives on the Support page. It advances FDS software, research, and operations directly." />
    <a href="/support" class="btn btn-outline">Support FDS Development</a>
  </section>
</BaseLayout>
<style>
  .ci-hero { max-width: 52rem; padding: clamp(2.5rem, 6vw, 4rem) 0 var(--space-5); }.ci-hero__eyebrow { margin-bottom: .65rem; color: var(--color-accent); font: 700 .72rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.ci-hero h1 { margin: 0; font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -.04em; }.ci-hero__lead { margin-top: 1.1rem; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.75; }

  .ci-section { padding-bottom: var(--space-6); }.ci-section--last { padding-bottom: var(--space-7); }

  .ci-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .ci-card { padding: 1.5rem; border: 1px solid var(--color-border); border-top: 3px solid var(--color-silver); border-radius: var(--radius-md); background: var(--color-surface); }.ci-card__head { display: flex; flex-wrap: wrap; gap: .6rem .8rem; align-items: center; justify-content: space-between; }.ci-card h3 { margin: 0; font-size: 1.06rem; letter-spacing: -.02em; }.ci-card p { margin: .8rem 0 0; color: var(--color-text-muted); font-size: .93rem; line-height: 1.65; }

  .ci-status { padding: .35rem .55rem; border-radius: 999px; font: 700 .68rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }.ci-status--exploring { border: 1px solid color-mix(in srgb, var(--color-status-experimental) 55%, transparent); color: var(--color-status-experimental); background: color-mix(in srgb, var(--color-status-experimental) 9%, transparent); }.ci-status--development { border: 1px solid color-mix(in srgb, var(--color-status-active) 55%, transparent); color: var(--color-status-active); background: color-mix(in srgb, var(--color-status-active) 9%, transparent); }

  .ci-fund { max-width: 52rem; padding: 1.6rem 1.7rem; border: 1px solid var(--color-border); border-left: 3px solid var(--color-silver); border-radius: var(--radius-md); background: var(--color-bg-secondary); }.ci-fund__banner { margin: 0 0 1rem; padding: .8rem 1rem; border: 1px solid color-mix(in srgb, var(--color-status-experimental) 40%, transparent); border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-status-experimental) 7%, transparent); color: var(--color-text); font-size: .94rem; line-height: 1.6; }.ci-fund p:not(.ci-fund__banner):not(.ci-fund__note) { margin: 0 0 1rem; color: var(--color-text-muted); line-height: 1.75; }.ci-fund ul { margin: 0 0 1rem; padding-left: 1.2rem; color: var(--color-text-muted); line-height: 1.85; }.ci-fund__note { margin: 0; color: var(--color-text-subtle); font-size: .88rem; }

  @media (max-width: 860px) { .ci-grid { grid-template-columns: 1fr; } }
</style>
