---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, exploreNextBySlug } from '../../data/projects';
import ProjectStatus from '../../components/ProjectStatus.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import NoteCard from '../../components/NoteCard.astro';
import GemsDeep from '../../components/GemsDeep.astro';
import ExploreNext from '../../components/ExploreNext.astro';
import { statusMeta } from '../../data/status';
import { getPublishedNotes } from '../../lib/notes';
import VisualEvidence from '../../components/VisualEvidence.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
// End-of-page links are contextual per project (see exploreNextBySlug in the
// project data); the sortOrder fallback only covers projects without a mapping.
const exploreLinks = exploreNextBySlug[project.slug] ?? [
  ...projects.filter((item) => item.slug !== project.slug).sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99)).slice(0, 2)
    .map((item) => ({ label: item.shortName || item.name, href: `/projects/${item.slug}`, note: item.category })),
  { label: 'All Projects', href: '/projects', note: 'Full directory' }
];
const isGems = project.slug === 'gems-training-grounds';
const heroEvidenceState = project.slug === 'codeforge'
  ? 'release'
  : project.heroImage?.src.endsWith('.svg')
    ? 'research'
    : 'development';
const status = statusMeta[project.status];
// Released products get a canonical release strip (version, platform, download)
// straight from the product record — the page must lead with "you can get this".
const releaseProduct = products.find((p) => p.projectSlug === project.slug && p.downloadUrl);
const projectNotes = (await getPublishedNotes())
  .filter((note) => note.data.projectSlug === project.slug)
  .slice(0, 3);
const ogImage = project.ogImage ?? project.heroImage?.src;

// Map ecosystem to styles
const ecosystemStyles: Record<string, { color: string; bg: string }> = {
  'Engineering': { color: '#5a82e8', bg: 'rgba(90,130,232,.12)' },
  'Intelligence': { color: '#4f8fff', bg: 'rgba(79,143,255,.12)' },
  'Gaming': { color: '#b487ff', bg: 'rgba(180,135,255,.12)' },
  'Publishing': { color: '#d9813f', bg: 'rgba(217,129,63,.12)' },
  'Civic': { color: '#8792a8', bg: 'rgba(135,146,168,.12)' },
  'Foraging': { color: '#76b77d', bg: 'rgba(118,183,125,.12)' }
};
const ecosystemStyle = project.ecosystem ? ecosystemStyles[project.ecosystem] : null;
const ecoColor = ecosystemStyle?.color || project.accentColor;
---

<BaseLayout title={project.name} description={project.summary} ogImage={ogImage}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/projects">Projects</a><span aria-hidden="true">/</span>
    <span aria-current="page">{project.shortName || project.name}</span>
  </nav>
  
  <article class="project-page" style={`--project-accent: ${project.accentColor || 'var(--color-accent)'};--eco-color: ${ecoColor}`}>
    <!-- Hero Section -->
    <header class="project-hero" class:list={[isGems ? 'project-hero--flagship' : '']}>
      <div class="project-hero__badge-row">
        {project.ecosystem && ecosystemStyle && (
          <a href="/projects" class="project-hero__ecosystem">
            <span class="eco-dot"></span>
            {project.ecosystem.toUpperCase()}
          </a>
        )}
        <ProjectStatus status={project.status} />
        {project.secondaryStatus && (
          <span class="project-hero__maint">{statusMeta[project.secondaryStatus].short}</span>
        )}
      </div>
      
      <h1 class="project-hero__title">{project.name}</h1>
      
      {project.stageLabel && !project.flagship && (
        <p class="project-hero__stage">{project.stageLabel}</p>
      )}
      
      <p class="project-hero__summary">{project.summary}</p>
      
      <div class="project-hero__tags">
        {project.tags.slice(0, 5).map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    {releaseProduct && (
      <section class="release-strip" aria-label={`Get ${releaseProduct.name}`}>
        <p class="release-strip__meta">
          <span class="release-strip__state">{releaseProduct.status === 'released' ? 'RELEASED' : releaseProduct.status === 'public-beta' ? 'PUBLIC PREVIEW' : 'AVAILABLE'}</span>
          {releaseProduct.version && <span class="release-strip__version">{releaseProduct.version}</span>}
          <span class="release-strip__platform">{releaseProduct.platform.join(' · ')}</span>
        </p>
        <div class="release-strip__ctas">
          <a href={releaseProduct.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Get {releaseProduct.name}<span aria-hidden="true">→</span>
          </a>
          {releaseProduct.docsUrl && (
            <a href={releaseProduct.docsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Documentation</a>
          )}
          {releaseProduct.releaseNotesUrl && (
            <a href={releaseProduct.releaseNotesUrl} target="_blank" rel="noopener noreferrer" class="release-strip__notes">Release notes</a>
          )}
        </div>
      </section>
    )}

    <!-- Visual -->
    {project.heroImage ? (
      <VisualEvidence
        src={project.heroImage.src}
        alt={project.heroImage.alt}
        caption={project.heroImage.caption ?? ''}
        state={heroEvidenceState}
        eager
      />
    ) : (
      <figure class="project-visual">
        <ProjectVisual project={project} variant="hero" />
      </figure>
    )}

    <!-- Main Content -->
    <div class="project-layout">
      <div class="project-content">
        {project.sections && project.sections.map((section, index) => (
          <section class="project-section" aria-labelledby={`project-section-${index}`}>
            <h2 id={`project-section-${index}`} class="section-title">{section.title}</h2>
            {section.body && <p class="section-text">{section.body}</p>}
            {section.items && section.items.length > 0 && (
              <ul class="building-grid section-items">
                {section.items.map((item) => (
                  <li class="building-item"><span class="building-icon" aria-hidden="true">+</span><span>{item}</span></li>
                ))}
              </ul>
            )}
            {section.note && <p class="section-note"><strong>Status note:</strong> {section.note}</p>}
          </section>
        ))}

        {!project.sections && (
          <>
        <!-- Overview -->
        <section class="project-section" aria-labelledby="overview">
          <h2 id="overview" class="section-title">Overview</h2>
          <p class="section-text">{project.description}</p>
        </section>

        <!-- Problem -->
        {project.problem && (
          <section class="project-section" aria-labelledby="problem">
            <h2 id="problem" class="section-title">The Problem</h2>
            <p class="section-text">{project.problem}</p>
          </section>
        )}

        <!-- Differentiation -->
        {project.differentiation && (
          <section class="project-section" aria-labelledby="differentiation">
            <h2 id="differentiation" class="section-title">What Makes It Different</h2>
            <p class="section-text">{project.differentiation}</p>
          </section>
        )}

        <!-- What We're Building -->
        {project.building && project.building.length > 0 && (
          <section class="project-section" aria-labelledby="building">
            <h2 id="building" class="section-title">What We're Building</h2>
            <ul class="building-grid">
              {project.building.map((item) => (
                <li class="building-item">
                  <span class="building-icon" aria-hidden="true">+</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Focus Areas / Capabilities -->
        <section class="project-section" aria-labelledby="focus">
          <h2 id="focus" class="section-title">Core Capabilities</h2>
          <ul class="capabilities-grid">
            {(project.focusAreas || project.tags).slice(0, 6).map((area, index) => (
              <li class="capability-item">
                <span class="capability-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="capability-label">{area}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- R&D Notes -->
        {project.highlights && project.highlights.length > 0 && (
          <section class="project-section" aria-labelledby="highlights">
            <h2 id="highlights" class="section-title">Development Notes</h2>
            <ul class="notes-list">
              {project.highlights.map((item) => (
                <li class="notes-item">
                  <span class="notes-marker" aria-hidden="true">→</span>
                  {item}
                </li>
              ))}
            </ul>
          </section>
        )}
          </>
        )}

        <!-- Privacy Notice -->
        {project.privacyNotice && (
          <aside class="privacy-block">
            <span class="privacy-icon" aria-hidden="true">◇</span>
            <p class="privacy-text">{project.privacyNotice}</p>
          </aside>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="project-sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">Public Status</h3>
          <ProjectStatus status={project.status} />
          {project.secondaryStatus && <div class="sidebar-secondary"><ProjectStatus status={project.secondaryStatus} /></div>}
          <p class="sidebar-desc">{status.description}</p>
        </div>

        {project.audience && (
          <div class="sidebar-card">
            <h3 class="sidebar-title">Built For</h3>
            <p class="sidebar-desc sidebar-desc--audience">{project.audience}</p>
          </div>
        )}

        {(project.githubUrl || project.websiteUrl || project.documentationUrl) && (
          <div class="sidebar-card sidebar-links">
            <h3 class="sidebar-title">Links</h3>
            <div class="sidebar-buttons">
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  Repository
                </a>
              )}
              {project.websiteUrl && !releaseProduct && (
                <a href={project.websiteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  Live Project
                </a>
              )}
              {project.documentationUrl && (
                <a href={project.documentationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  Documentation
                </a>
              )}
            </div>
          </div>
        )}
      </aside>
    </div>

     <!-- GEMS Special Section -->
    {isGems && (
      <section class="gems-section" aria-labelledby="gems-systems">
        <p class="gems-kicker">The Model Family</p>
        <h2 id="gems-systems" class="gems-title">Meet the GEMS and Training Grounds</h2>
        <GemsDeep />
      </section>
    )}

    <!-- Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <section class="project-gallery" aria-labelledby="gallery">
        <h2 id="gallery" class="section-title">Project Media</h2>
        <div class="gallery-grid">
          {project.gallery.map((item) => (
            <VisualEvidence
              src={item.src}
              alt={item.alt}
              caption={item.caption ?? ''}
              state={item.src.endsWith('.svg') ? 'conceptual' : 'development'}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Project Updates -->
    {projectNotes.length > 0 && (
      <section class="project-updates" aria-labelledby="updates">
        <div class="updates-header">
          <h2 id="updates" class="section-title">Latest Updates</h2>
          <a class="updates-link" href="/notes">All notes →</a>
        </div>
        <div class="updates-grid">
          {projectNotes.map((note) => <NoteCard note={note} showProject={false} />)}
        </div>
      </section>
    )}
  </article>

  <ExploreNext links={exploreLinks} />
</BaseLayout>

<style>
  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    padding: 1.5rem 0 0;
    color: var(--color-text-subtle);
    font: .72rem/1.3 var(--font-mono);
  }
  .breadcrumbs a { color: var(--color-text-muted); }

  /* Hero */
  .project-hero {
    position: relative;
    padding: clamp(2.5rem, 6vw, 4rem) 0 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  .project-hero__badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    align-items: center;
    margin-bottom: .8rem;
  }
  
  .project-hero__ecosystem {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--eco-color) 12%, transparent);
    color: var(--eco-color);
    font: 700 .65rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity .2s ease;
  }
  
  .project-hero__ecosystem:hover {
    opacity: .85;
  }
  
  .eco-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 4px currentColor;
  }
  
  .project-hero__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -.04em;
    color: var(--color-text);
  }
  
  .project-hero__stage {
    margin: .6rem 0 0;
    color: var(--eco-color);
    font: 700 .72rem/1.3 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  
  .project-hero__summary {
    max-width: 48rem;
    margin: .9rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* A released project is still developed; say it as a note, not a second
     lifecycle pill competing with the primary status. */
  .project-hero__maint {
    color: var(--color-text-subtle);
    font: 650 .72rem/1 var(--font-mono);
    letter-spacing: .04em;
  }
  
  .project-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: 1.25rem;
  }

  /* Release strip: canonical download row for projects with a released product. */
  .release-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding: .9rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--project-accent) 34%, var(--color-border));
    border-left: 3px solid var(--project-accent);
    border-radius: var(--radius-md);
    background: rgba(8,14,25,.7);
  }
  .release-strip__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4rem 1rem;
    margin: 0;
  }
  .release-strip__state {
    color: var(--project-accent);
    font: 800 .72rem/1 var(--font-mono);
    letter-spacing: .14em;
  }
  .release-strip__version {
    color: var(--color-text);
    font: 700 .78rem/1 var(--font-mono);
  }
  .release-strip__platform {
    color: var(--color-text-subtle);
    font: 650 .68rem/1 var(--font-mono);
    letter-spacing: .05em;
  }
  .release-strip__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    align-items: center;
  }
  .release-strip__ctas .btn {
    min-height: 2.6rem;
    padding: .6rem .95rem;
  }
  .release-strip__notes {
    color: var(--color-text-muted);
    font-size: .85rem;
    font-weight: 600;
  }
  .release-strip__notes:hover {
    color: var(--color-text);
  }
  .release-strip__notes:focus-visible {
    outline: 2px solid var(--project-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .release-strip {
      align-items: stretch;
      flex-direction: column;
    }
    .release-strip__ctas .btn {
      flex: 1;
    }
  }

  /* Visual */
  .project-visual {
    margin: 2rem 0 0;
  }
  
  .project-visual__img {
    display: block;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  
  .project-visual__caption {
    margin: .5rem 0 0;
    color: var(--color-text-subtle);
    font: .75rem/1.4 var(--font-mono);
  }

  /* Layout */
  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 4rem;
    padding: 3rem 0;
  }

  /* Sections */
  .project-section + .project-section {
    margin-top: 2.5rem;
  }
  
  .section-title {
    margin: 0 0 .8rem;
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
    font-weight: 750;
    letter-spacing: -.025em;
    color: var(--color-text);
  }
  
  .section-text {
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }
  .section-items { margin-top: 1rem; }
  .section-note { max-width: 44rem; margin: .85rem 0 0; padding: .75rem .9rem; border-left: 3px solid var(--eco-color); background: color-mix(in srgb, var(--eco-color) 7%, transparent); color: var(--color-text-muted); font-size: .86rem; line-height: 1.6; }
  .sidebar-secondary { margin-top: .5rem; }

  /* Building Grid */
  .building-grid {
    display: grid;
    gap: .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  
  .building-item {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
    padding: .75rem .9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: .9rem;
    line-height: 1.5;
  }
  
  .building-icon {
    color: var(--eco-color);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Capabilities Grid */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  
  .capability-item {
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .65rem .75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: .82rem;
  }
  
  .capability-num {
    color: var(--eco-color);
    font: 700 .65rem/1 var(--font-mono);
  }

  /* Notes List */
  .notes-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  
  .notes-item {
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    padding: .6rem 0;
    color: var(--color-text-muted);
    font-size: .9rem;
    line-height: 1.6;
  }
  
  .notes-marker {
    flex-shrink: 0;
    color: var(--eco-color);
    font-size: .85rem;
  }

  /* Privacy Block */
  .privacy-block {
    display: flex;
    gap: .7rem;
    align-items: flex-start;
    margin-top: 2rem;
    padding: .9rem 1rem;
    border-left: 3px solid var(--eco-color);
    background: color-mix(in srgb, var(--eco-color) 8%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  
  .privacy-icon {
    color: var(--eco-color);
    font-size: 1rem;
  }
  
  .privacy-text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .88rem;
    line-height: 1.6;
  }

  /* Sidebar */
  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .sidebar-card {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--eco-color);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  
  .sidebar-title {
    margin: 0 0 .6rem;
    color: var(--color-text-subtle);
    font: 700 .65rem/1 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  
  .sidebar-desc {
    margin: .6rem 0 0;
    color: var(--color-text-muted);
    font-size: .85rem;
    line-height: 1.55;
  }
  
  .sidebar-desc--audience {
    font-size: .82rem;
    line-height: 1.5;
  }
  
  .sidebar-buttons {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    margin-top: .6rem;
  }
  
  .sidebar-buttons .btn {
    justify-content: flex-start;
    font-size: .78rem;
    padding: .65rem .85rem;
  }

  /* GEMS Section */
  .gems-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: var(--space-6) max(1.25rem, calc((100vw - var(--content-width)) / 2));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(110deg, color-mix(in srgb, var(--eco-color, #4f8fff) 10%, var(--color-bg-secondary)), var(--color-bg-secondary));
  }
  
  .gems-kicker {
    margin: 0 0 .3rem;
    color: var(--color-text-subtle);
    font: 700 .7rem/1.3 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  
  .gems-title {
    margin: 0 0 1.5rem;
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    font-weight: 750;
    letter-spacing: -.025em;
  }
  
  .gems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  
  .gems-flow {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--eco-color, #4f8fff) 35%, var(--color-border));
    border-radius: var(--radius-md);
    background: rgba(0,0,0,.12);
  }
  
  .gems-step {
    padding: .45rem .6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font: 700 .7rem/1 var(--font-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  
  .gems-arrow {
    color: var(--eco-color, #4f8fff);
    font-size: .8rem;
    text-align: center;
  }
  
  .gems-note {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: .8rem;
    font-style: italic;
  }

  /* Gallery */
  .project-gallery {
    padding: var(--space-5) 0;
  }
  
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  
  .gallery-item img {
    display: block;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
