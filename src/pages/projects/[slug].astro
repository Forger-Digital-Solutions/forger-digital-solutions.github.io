---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import NoteCard from '../../components/NoteCard.astro';
import { statusMeta } from '../../data/status';
import { getPublishedNotes } from '../../lib/notes';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const relatedProjects = projects.filter((item) => item.slug !== project.slug).sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99)).slice(0, 3);
const isGems = project.slug === 'gems-training-grounds';
const status = statusMeta[project.status];
const projectNotes = (await getPublishedNotes())
  .filter((note) => note.data.projectSlug === project.slug)
  .slice(0, 3);
const ogImage = project.ogImage ?? project.heroImage?.src;
---
<BaseLayout title={project.name} description={project.summary} ogImage={ogImage}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span></nav>
  <article class="project-page" style={`--project-accent: ${project.accentColor || 'var(--color-accent)'}`}>
    <header class:list={['project-hero', { 'project-hero--flagship': isGems }]}><p class="project-hero__category">{project.category}</p><div class="project-hero__title-row"><h1>{project.name}</h1><ProjectStatus status={project.status} /></div>{project.stageLabel && <p class="project-hero__stage">{project.stageLabel}</p>}<p class="project-hero__summary">{project.summary}</p><div class="project-hero__tags" aria-label={`${project.name} focus tags`}>{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></header>
    <figure class="project-visual-wrap">
      {project.heroImage
        ? <img class="project-visual-img" src={project.heroImage.src} alt={project.heroImage.alt} loading="lazy" decoding="async" />
        : <ProjectVisual project={project} variant="hero" />}
      {project.heroImage?.caption && <figcaption>{project.heroImage.caption}</figcaption>}
    </figure>
    <div class="project-layout"><div class="project-content"><section aria-labelledby="overview"><h2 id="overview">Overview</h2><p>{project.description}</p></section>{project.building && <section aria-labelledby="building"><h2 id="building">What We're Building</h2><ul class="building-list">{project.building.map((item) => <li>{item}</li>)}</ul></section>}<section aria-labelledby="focus"><h2 id="focus">Focus Areas</h2><ul class="focus-grid">{(project.focusAreas || project.tags).map((area, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{area}</li>)}</ul></section>{project.highlights && <section aria-labelledby="highlights"><h2 id="highlights">Research &amp; Development Notes</h2><ul class="highlights">{project.highlights.map((item) => <li>{item}</li>)}</ul></section>}{project.privacyNotice && <aside class="privacy-note"><span aria-hidden="true">◇</span><p>{project.privacyNotice}</p></aside>}</div><aside class="project-fact"><p>Development Status</p><ProjectStatus status={project.status} /><p class="project-fact__copy">{status.description}</p>{(project.githubUrl || project.websiteUrl || project.documentationUrl) && <div class="project-links"><p>Relevant Links</p>{project.githubUrl && <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Repository</a>}{project.websiteUrl && <a href={project.websiteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Open Project</a>}{project.documentationUrl && <a href={project.documentationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Documentation</a>}</div>}</aside></div>
    {isGems && <section class="gems-systems" aria-labelledby="gems-systems"><p class="project-hero__category">Conceptual Research Flow</p><h2 id="gems-systems">A system designed to learn from evidence</h2><div class="concept-grid"><div class="concept-flow" aria-label="Curriculum, training, evaluation, evidence, certification"><span>Curriculum</span><i>↓</i><span>Training</span><i>↓</i><span>Evaluation</span><i>↓</i><span>Evidence</span><i>↓</i><span>Certification</span></div><div class="concept-flow" aria-label="Available compute, hardware awareness, execution planning, training and evaluation"><span>Available Compute</span><i>↓</i><span>Hardware Awareness</span><i>↓</i><span>Execution Planning</span><i>↓</i><span>Training / Evaluation</span></div></div><p class="concept-note">These diagrams describe FDS research concepts, not an exposed product architecture or performance claim.</p></section>}
    {project.gallery && project.gallery.length > 0 && (
      <section class="project-gallery" aria-labelledby="gallery"><h2 id="gallery">Project Media</h2><div class="gallery-grid">{project.gallery.map((item) => (<figure><img src={item.src} alt={item.alt} loading="lazy" decoding="async" />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>))}</div></section>
    )}
    {projectNotes.length > 0 && (
      <section class="project-updates" aria-labelledby="updates"><div class="project-updates__head"><h2 id="updates">Latest Project Updates</h2><a class="text-link" href="/notes">All notes <span aria-hidden="true">→</span></a></div><div class="updates-grid">{projectNotes.map((note) => <NoteCard note={note} showProject={false} />)}</div></section>
    )}
  </article>
  <section class="related" aria-labelledby="related"><h2 id="related">Explore More FDS Projects</h2><div class="related-grid">{relatedProjects.map((item) => <ProjectCard project={item} />)}</div></section>
</BaseLayout>
<style>
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .5rem; padding: 1.6rem 0 0; color: var(--color-text-subtle); font: .72rem/1.3 var(--font-mono); }.breadcrumbs a { color: var(--color-text-muted); }.project-page { --project-accent: var(--color-accent); }.project-hero { position: relative; padding: clamp(3rem, 8vw, 6rem) 0 3rem; border-bottom: 1px solid var(--color-border); }.project-hero--flagship { padding-right: min(14vw, 10rem); }.project-hero--flagship::after { position: absolute; top: 2rem; right: 0; width: min(16vw, 9rem); aspect-ratio: 1; border: 1px solid var(--project-accent); border-radius: 50%; box-shadow: 0 0 0 1.6rem color-mix(in srgb, var(--project-accent) 8%, transparent), 0 0 0 4rem color-mix(in srgb, var(--project-accent) 3%, transparent); content: ''; }.project-hero__category, .project-hero__stage { color: var(--project-accent); font: 700 .72rem/1.3 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.project-hero__title-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; margin-top: 1rem; }.project-hero h1 { max-width: 50rem; font-size: clamp(2.45rem, 6vw, 5rem); line-height: .98; letter-spacing: -.055em; }.project-hero__stage { margin-top: 1rem; }.project-hero__summary { max-width: 50rem; margin-top: 1.2rem; color: var(--color-text-muted); font-size: 1.12rem; line-height: 1.7; }.project-hero__tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }.project-layout { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 5rem; padding: 4rem 0; }.project-content section + section { margin-top: 3rem; }.project-content h2, .gems-systems h2, .related h2 { font-size: clamp(1.55rem, 3vw, 2.25rem); letter-spacing: -.035em; }.project-content p { max-width: 46rem; margin-top: 1rem; color: var(--color-text-muted); font-size: 1.04rem; }.focus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }.focus-grid li { display: flex; gap: .65rem; align-items: center; padding: .75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-text-muted); }.focus-grid span { color: var(--project-accent); font: 700 .68rem/1 var(--font-mono); }.highlights { display: grid; gap: .65rem; margin: 1rem 0 0; padding: 0; list-style: none; }.highlights li { padding-left: 1.2rem; color: var(--color-text-muted); }.highlights li::before { position: absolute; margin-left: -1.2rem; color: var(--project-accent); content: '→'; }.project-fact { height: fit-content; padding: 1.2rem; border: 1px solid var(--color-border); border-top: 3px solid var(--project-accent); border-radius: var(--radius-md); background: var(--color-surface); }.project-fact > p:first-child, .project-links > p { margin-bottom: .75rem; color: var(--color-text-subtle); font: 700 .68rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }.project-fact__copy { margin-top: 1rem; color: var(--color-text-muted); font-size: .88rem; }.project-links { display: grid; gap: .6rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }.project-links .btn { justify-content: flex-start; font-size: .8rem; }.privacy-note { display: flex; gap: .8rem; align-items: flex-start; margin-top: 2.5rem; padding: 1rem; border-left: 3px solid var(--project-accent); background: color-mix(in srgb, var(--project-accent) 7%, transparent); }.privacy-note span { color: var(--project-accent); }.privacy-note p { margin: 0; }.gems-systems { width: 100vw; margin-left: calc(50% - 50vw); padding: var(--space-7) max(1.25rem, calc((100vw - var(--content-width)) / 2)); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: linear-gradient(110deg, color-mix(in srgb, var(--project-accent) 11%, var(--color-bg-secondary)), var(--color-bg-secondary)); }.gems-systems h2 { margin: .8rem 0 2rem; }.concept-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }.concept-flow { display: grid; gap: .45rem; padding: 1.4rem; border: 1px solid color-mix(in srgb, var(--project-accent) 40%, var(--color-border)); border-radius: var(--radius-md); background: rgba(0,0,0,.13); }.concept-flow span { padding: .5rem .7rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-text); font: 700 .73rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }.concept-flow i { color: var(--project-accent); font-style: normal; text-align: center; }.concept-note { max-width: 48rem; margin-top: 1.3rem; color: var(--color-text-muted); font-size: .82rem; }.related { padding: var(--space-7) 0; }.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .project-visual-wrap { margin: 2.5rem 0 0; }.project-visual-wrap figcaption { margin-top: .6rem; color: var(--color-text-subtle); font: .78rem/1.4 var(--font-mono); }.project-visual-img { display: block; width: 100%; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .building-list { display: grid; gap: .6rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }.building-list li { position: relative; padding: .85rem 1rem .85rem 2.2rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text-muted); }.building-list li::before { position: absolute; left: 1rem; color: var(--project-accent); font-weight: 700; content: '+'; }
  .project-updates, .project-gallery { padding: var(--space-6) 0 0; }.project-updates__head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between; }.project-updates .text-link, .gems-systems + * .text-link { font: 700 .74rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }.updates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; margin-top: 1.5rem; }.gallery-grid img { display: block; width: 100%; border: 1px solid var(--color-border); border-radius: var(--radius-md); }.gallery-grid figcaption { margin-top: .5rem; color: var(--color-text-subtle); font: .78rem/1.4 var(--font-mono); }
  @media (max-width: 850px) { .project-layout { grid-template-columns: 1fr; gap: 2rem; }.project-fact { max-width: 38rem; }.related-grid { grid-template-columns: 1fr 1fr; }.project-hero--flagship { padding-right: 0; }.project-hero--flagship::after { opacity: .45; } }@media (max-width: 600px) { .concept-grid, .focus-grid, .related-grid { grid-template-columns: 1fr; }.project-hero__title-row { align-items: flex-start; }.gems-systems { padding-top: var(--space-6); padding-bottom: var(--space-6); } }
</style>
