---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found">
  <div class="notfound-page">
    <p class="notfound-code">SYSTEM PATH NOT FOUND</p>
    <h1 class="notfound-title">404</h1>
    <p class="notfound-description">
      The requested page could not be found.
    </p>
    <div class="notfound-actions">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="/projects" class="btn btn-outline">Explore Projects</a>
    </div>
    <p class="notfound-alt">
      Looking for released software? <a href="/forged">Forged</a> ·
      Engineering journal: <a href="/notes">Notes</a>
    </p>
  </div>
</BaseLayout>

<style>
  .notfound-page {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
    padding: 6rem var(--space-3) 8rem;
    min-height: 60vh;
  }

  .notfound-code {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 1rem;
    line-height: 1;
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .notfound-title {
    font-size: 6rem;
    font-weight: 200;
    line-height: 1;
    margin-bottom: 1rem;
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .notfound-description {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .notfound-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .notfound-alt {
    margin: 2.25rem 0 0;
    color: var(--color-text-subtle);
    font-size: .88rem;
  }

  .notfound-alt a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .notfound-alt a:hover,
  .notfound-alt a:focus-visible {
    color: var(--color-text);
  }

  @media (max-width: 767px) {
    .notfound-title {
      font-size: 4rem;
    }
  }
</style>
