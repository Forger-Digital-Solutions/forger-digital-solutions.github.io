---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const faqs = [
  {
    q: 'What is Forger Digital Solutions?',
    a: `FDS is an independent AI and software company. It builds AI systems, developer tools,
        software products, technical utilities, and specialized research systems — real products
        where they are ready, transparent research where they are not.`
  },
  {
    q: 'What does FDS build?',
    a: `Work spans CodeForge (autonomous software engineering), ForgerEMS (Windows technician
        workbench), GEMS and Training Grounds (AI research), KyraBlox (game development),
        Kayla AI Publisher (creative/publishing software), We The People Library (offline
        knowledge), and FarmStand Finder (local discovery). The current line-up, grouped by
        availability, is on the Products page.`
  },
  {
    q: 'What can I use right now?',
    a: `The Releases page (Forged) lists public software. CodeForge has a released Windows installer
        and portable build; ForgerEMS has public-preview packages; a CodeForge source archive is
        published as a ZIP with a verified SHA-256 checksum. Other projects have status labels that
        separate research, private development, prerelease software, and public releases.`
  },
  {
    q: 'What are ForgeAuto, 8-Bit, and ForgeZero?',
    a: `They are CodeForge model-control systems. ForgeZero is the fail-closed zero-cost boundary:
        it refuses paid inference, local models, and unverified providers rather than falling back
        silently. ForgeAuto is the automatic selection mode that routes free-experience work across
        verified zero-cost models. 8-Bit is the dynamic model-routing and failover core that keeps
        sessions working as free-model availability, quotas, and health change — routing authority
        only, with no path into permissions, approvals, or verification. These systems are part of
        active development; specifics are not backported onto the released v0.2.0 binary.`
  },
  {
    q: 'Are paid CodeForge plans available?',
    a: `No. CodeForge Free is available now. Expanded commercial plans are in development — final
        tier names, prices, limits, and billing terms have not been published, and no checkout is
        active anywhere on this site.`
  },
  {
    q: 'Is GEMS trained from scratch?',
    a: `Not as a blanket claim. Current GEMS strategy builds on strong open or pretrained foundations
        where a role benefits from them, while fully from-scratch FDS-developed model development
        remains longer-term research. Training Grounds — curriculum, evaluation, diagnosis, and
        advancement — governs every lineage either way.`
  },
  {
    q: 'What is Sapphire? Has it been trained?',
    a: `Sapphire is the GEMS lineage for software engineering and coding. It has produced
        experimental research checkpoints evaluated through Training Grounds. No Sapphire model is
        presented as a public production model, and no Sapphire capability is claimed inside
        CodeForge.`
  },
  {
    q: 'How do I download and verify project archives?',
    a: `Project archives are published on the Releases page as .zip files only. Each archive card
        shows the file name, size, source commit, and the full Archive SHA-256, with a copy button.
        After downloading, run certutil -hashfile FILE SHA256 (Windows) or shasum -a 256 FILE
        (macOS/Linux) and compare the value before trusting the archive.`
  },
  {
    q: 'What is We The People?',
    a: `We The People Library is an offline-first knowledge platform in private development:
        practical reference material — civics, public information, science, engineering, trades,
        agriculture, mathematics, and general reference — designed to stay available offline,
        stored locally with source provenance.`
  },
  {
    q: 'Are you Kayla Publisher?',
    a: `No. The website assistant is Kayla — the FDS Guide, a separate helper for questions about
        FDS. Kayla Publisher is a different FDS product: creative and publishing software for
        long-form work.`
  },
  {
    q: 'How can I support FDS?',
    a: `FDS is independently developed. The Support page covers development and
        hardware support — Cash App ($ForgerDigital) and Ko-fi — plus hardware
        donations and future community-impact initiatives, each kept clearly
        separate. Following along on YouTube and Discord helps too.`
  },
  {
    q: 'How do I get in touch?',
    a: `Email is the best way to reach us. You can also join the community on Discord for more
        casual conversation.`
  },
  {
    q: 'Do you collect my data when I visit?',
    a: `The site uses no cookies and no advertising. It loads no analytics or profiling trackers;
        the only third-party call on the homepage is a privacy-preserving visit counter that records
        an anonymous hit count and nothing about you. See the Privacy Policy for the full details
        on what is and isn't collected.`
  },
  {
    q: 'Where can I follow updates?',
    a: `Check the Engineering Log for build logs and research write-ups, and subscribe on YouTube or
        join Discord for ongoing updates.`
  }
];
---
<BaseLayout
  title="FAQ"
  description="Answers to common questions about Forger Digital Solutions."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">FAQ</span>
  </nav>
  <article class="doc">
    <p class="doc__updated">Frequently Asked Questions</p>
    <h1>FAQ</h1>
    <p class="doc__lead">
      Answers to the questions we hear most. Can't find yours? Email
      {' '}<a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.
    </p>

    <div class="faq-list">
      {faqs.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{item.q}</summary>
          <div class="faq-item__answer">
            <p>{item.a}</p>
            {item.q === 'How can I support FDS?' && (
              <p>
                <a href="/support">Visit the Support page &rarr;</a>
                {' · '}
                {siteConfig.kofiUrl && <a href={siteConfig.kofiUrl} target="_blank" rel="noopener noreferrer">Support on Ko-fi</a>}
              </p>
            )}
            {item.q === 'How do I get in touch?' && (
              <p>
                <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
                {' · '}
                <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Join our Discord</a>
              </p>
            )}
            {item.q === 'Do you collect my data when I visit?' && (
              <p><a href="/privacy">Read the Privacy Policy &rarr;</a></p>
            )}
            {item.q === 'Where can I follow updates?' && (
              <p>
                <a href="/notes">Notes</a>
                {' · '}
                <a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a>
                {' · '}
                <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>

    <a class="doc__back" href="/">&larr; Back home</a>
  </article>
</BaseLayout>

<style>
  .doc__back { display: inline-block; margin-top: 3rem; font: 700 .76rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
</style>
