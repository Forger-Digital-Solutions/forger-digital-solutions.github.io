---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusPill from '../components/StatusPill.astro';
import HubArchitectureFlow from '../components/HubArchitectureFlow.astro';
import HubInvestigationPreview from '../components/HubInvestigationPreview.astro';
import PilotBookingActions from '../components/PilotBookingActions.astro';
import SupportDialog from '../components/SupportDialog.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import { siteConfig } from '../config/site';
import {
  companyProfile,
  getRegistryEntry,
  studioIntelligenceHubData,
} from '../data/registry';

const hub = studioIntelligenceHubData;
const hubRegistry = getRegistryEntry('studio-intelligence-hub');

const alsoFromFds = [
  {
    idx: '01',
    name: 'Models',
    detail: 'Hackmanite, Cinnabar & Alexandrite model families and model cards.',
    href: '/models/',
    cta: 'Explore Models',
  },
  {
    idx: '02',
    name: 'Products & Releases',
    detail: 'Jaspilite, Forge BattleVerse, ForgerEMS preview & verified downloads.',
    href: '/products/',
    cta: 'Explore Products',
  },
  {
    idx: '03',
    name: 'Research',
    detail: 'Project Forge foundation, evaluation standards & FDS Trust Center.',
    href: '/research/',
    cta: 'Explore Research',
  },
  {
    idx: '04',
    name: 'Newsroom',
    detail: 'Dated studio updates, release dispatches & engineering field notes.',
    href: '/news/',
    cta: 'Open Newsroom',
  },
];

const homepageServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: hub.name,
  serviceType: 'Managed Engineering Intelligence Pilot for Game Studios',
  provider: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
  },
  url: new URL(hub.route, siteConfig.siteUrl).href,
  description:
    'Managed four-week engineering intelligence pilot (in testing on FDS’s own Roblox and Unreal projects) connecting Roblox Studio (Luau) and Unreal Engine (C++) source code with studio technical and design documentation; scoped engine references are in development.',
};
---

<BaseLayout
  title="FDS Studio Intelligence Hub & Game Engineering AI"
  description="FDS Studio Intelligence Hub connects Roblox Studio and Unreal Engine code with studio docs in a managed four-week engineering intelligence pilot."
  ogImage="/images/og/studio-intelligence-hub.jpg"
  ogImageWebp={hub.hero.image}
  accent="fds-cobalt"
  jsonLd={homepageServiceSchema}
>
  <!-- Compact Factual Announcement Strip -->
  <div class="announce-strip" role="region" aria-label="Studio Intelligence Hub pilot availability">
    <span class="announce-strip__tag">Pilot Open</span>
    <p class="announce-strip__text">
      Four-week managed pilots open for Roblox Studio &amp; Unreal Engine teams · First five Founding Studios receive 50% off the applicable pilot fee.
    </p>
    <a class="announce-strip__link" href="/solutions/studio-intelligence-hub/">Explore the Hub <span aria-hidden="true">→</span></a>
  </div>

  <!-- SECTION A: HERO — STUDIO INTELLIGENCE HUB FIRST -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__backdrop" aria-hidden="true">
      <picture>
        <source media="(max-width: 760px)" srcset={hub.hero.imageSm} type="image/webp" />
        <img
          src={hub.hero.image}
          alt=""
          width="1600"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__inner">
      <div class="hero__eyebrow-row">
        <p class="fds-eyebrow">
          <span class="fds-eyebrow__rule"></span>
          FDS Studio Intelligence Hub · Managed Engineering Intelligence Pilot
        </p>
        <StatusPill status={hubRegistry.development_status} label="Pilot Scope · In Testing" />
      </div>
      <h1 id="hero-heading" class="hero__title">
        Your Game Studio's Knowledge.<br />Connected.
      </h1>
      <p class="hero__lead">
        {hub.hero.supportingCopy}
      </p>

      <div class="hero__actions">
        <PilotBookingActions
          variant="pilot"
          primaryLabel={hub.hero.primaryCta}
          secondaryLabel={hub.hero.secondaryCta}
          secondaryHref="/solutions/studio-intelligence-hub/"
          showEmailFallback
        />
      </div>

      <p class="hero__scope-note">
        Managed four-week pilot (in testing on FDS's own <strong>Roblox Studio</strong> and <strong>Unreal Engine</strong> projects) · Cannot modify your repository — read-only by design · Customer-owned API keys · Scoped engine references in development · Pricing discussed during pilot assessment.
      </p>

      <p class="hero__heritage">
        <span>Forger Digital Solutions</span>
        <strong>{companyProfile.heritageSlogan}</strong>
      </p>
    </div>
  </section>

  <!-- SECTION B: THE PROBLEM -->
  <section class="page-section page-section--surface" aria-labelledby="problem-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>{hub.problem.eyebrow}</p>
        <h2 id="problem-heading">{hub.problem.headline}</h2>
        <p>{hub.problem.lead}</p>
      </div>
      <a href="/solutions/studio-intelligence-hub/" class="text-link">Full Studio Intelligence Hub overview <span aria-hidden="true">→</span></a>
    </div>

    <ol class="problem-ledger">
      {hub.problem.painPoints.map((pt) => (
        <li class="problem-ledger__row">
          <span class="problem-ledger__idx">{pt.code}</span>
          <h3 class="problem-ledger__title">{pt.title}</h3>
          <p class="problem-ledger__detail">{pt.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- SECTION C: THE SOLUTION (PROJECT FORGE ARCHITECTURE) -->
  <section class="page-section" aria-labelledby="solution-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>{hub.architecture.eyebrow}</p>
        <h2 id="solution-heading">{hub.architecture.headline}</h2>
        <p>{hub.architecture.lead}</p>
      </div>
      <a href="/solutions/studio-intelligence-hub/#architecture" class="text-link">Full scope &amp; architecture <span aria-hidden="true">→</span></a>
    </div>

    <HubArchitectureFlow showBoundaries={false} />
  </section>

  <!-- SECTION D: WHAT DEVELOPERS CAN ASK -->
  <section class="page-section page-section--surface" aria-labelledby="questions-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>What Developers Can Ask</p>
        <h2 id="questions-heading">Answers backed by your files and documentation.</h2>
        <p>
          Unlike generic coding assistants that guess from isolated snippets, the Studio Intelligence Hub connects gameplay scripts and technical specifications (with scoped engine reference packs in development) so developers can trace real evidence in seconds.
        </p>
      </div>
    </div>

    <HubInvestigationPreview idPrefix="home-hub-q" />
  </section>

  <!-- SECTION E: SUPPORTED ENGINES -->
  <section class="page-section" aria-labelledby="engines-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Supported Engines</p>
        <h2 id="engines-heading">Scoped for Roblox Studio and Unreal Engine codebases.</h2>
        <p>
          Every pilot focuses on text-source and documentation workflows currently in testing on FDS's own Roblox and Unreal projects—with upfront honesty about what is in scope and what remains in development.
        </p>
      </div>
      <a href="/solutions/studio-intelligence-hub/#supported-engines" class="text-link">View engine scope details <span aria-hidden="true">→</span></a>
    </div>

    <div class="engines-grid">
      {hub.supportedEngines.map((eng) => (
        <article class="fds-panel engine-card" data-accent={eng.accent}>
          <div class="engine-card__top">
            <span class="engine-card__badge">{eng.badge}</span>
            <StatusPill status="commercial-direction" label="Pilot Scope · In Testing" />
          </div>
          <h3>{eng.name}</h3>
          <p class="engine-card__summary">{eng.summary}</p>
          <ul class="engine-card__list">
            {eng.covered.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="flagship-boundary">
            <strong>Scope Boundary:</strong> {eng.honestyBoundary}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION F: HOW THE PILOT WORKS -->
  <section class="page-section page-section--surface" aria-labelledby="pilot-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>How the Pilot Works</p>
        <h2 id="pilot-heading">Four weeks from scoping to studio review and handoff.</h2>
        <p>
          We run the Studio Intelligence Hub as a hands-on managed engagement. Exact project scope, access rules, and deliverables are agreed before Week 1 begins.
        </p>
      </div>
    </div>

    <ol class="timeline-grid">
      {hub.pilotWeeks.map((step) => (
        <li class="timeline-cell">
          <span class="timeline-cell__week">{step.week}</span>
          <h3>{step.title}</h3>
          <p>{step.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- SECTION G: SECURITY AND CONTROL -->
  <section class="page-section" aria-labelledby="security-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Security &amp; Control</p>
        <h2 id="security-heading">Read-only by design. Isolated data. Customer-owned credentials.</h2>
        <p>
          Your studio keeps control of its repositories, deployment environment, and AI provider credentials throughout the pilot.
        </p>
      </div>
      <a href="/trust/" class="text-link">FDS Trust Center <span aria-hidden="true">→</span></a>
    </div>

    <div class="security-grid">
      {hub.securityControls.map((ctrl) => (
        <article class="security-cell">
          <span class="security-cell__code">{ctrl.code}</span>
          <h3>{ctrl.title}</h3>
          <p>{ctrl.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION H: FOUNDING STUDIO PROGRAM -->
  <section class="page-section page-section--surface" aria-labelledby="founding-heading">
    <div class="founding-banner">
      <div class="founding-banner__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>{hub.foundingProgram.eyebrow}</p>
        <h2 id="founding-heading">{hub.foundingProgram.headline}</h2>
        <p class="founding-banner__lead">{hub.foundingProgram.summary}</p>
        <p class="founding-banner__benefit">
          <strong>Founding Partner Offer:</strong> {hub.foundingProgram.benefit}
        </p>
        <p class="founding-banner__pricing">{hub.foundingProgram.pricingNote}</p>
      </div>
      <div class="founding-banner__cta">
        <PilotBookingActions
          variant="founding"
          primaryLabel={hub.foundingProgram.ctaLabel}
          secondaryLabel="Explore Pilot Details"
          secondaryHref="/solutions/studio-intelligence-hub/"
          showEmailFallback
        />
      </div>
    </div>
  </section>

  <!-- SECTION I: FINAL HUB CTA -->
  <section class="page-section" aria-labelledby="final-hub-cta-heading">
    <div class="fds-panel hub-final-cta">
      <div class="hub-final-cta__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Book Your Technical Assessment</p>
        <h2 id="final-hub-cta-heading">Let's Make Your Studio's Engineering Knowledge Work Harder.</h2>
        <p>
          Talk directly with FDS engineering about your Roblox Studio or Unreal Engine project, review what qualifies for a four-week pilot, and discuss pilot pricing and Founding Studio spots.
        </p>
      </div>
      <div class="hub-final-cta__actions">
        <PilotBookingActions
          variant="pilot"
          primaryLabel="Book a Pilot Call"
          secondaryLabel="Read Pilot FAQ"
          secondaryHref="/solutions/studio-intelligence-hub/#faq"
          showEmailFallback
        />
      </div>
    </div>
  </section>

  <!-- SECTION J: ALSO FROM FDS (CONCISE ECOSYSTEM STRIP) -->
  <section class="page-section page-section--tight page-section--surface" id="also-from-fds" aria-labelledby="also-fds-heading">
    <div class="also-strip__head">
      <div>
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Also from FDS</p>
        <h2 id="also-fds-heading" class="also-strip__title">Broader research, models, software &amp; studio updates.</h2>
      </div>
      <div class="also-strip__quick">
        <a href="/company/" class="text-link">Ecosystem map <span aria-hidden="true">→</span></a>
        <a href="/forged" class="text-link">Releases (Forged) <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="also-grid">
      {alsoFromFds.map((item) => (
        <a href={item.href} class="also-card">
          <span class="also-card__idx">{item.idx}</span>
          <h3 class="also-card__name">{item.name}</h3>
          <p class="also-card__detail">{item.detail}</p>
          <span class="also-card__cta">{item.cta} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Quiet Independent Support Notice -->
  <section class="page-section page-section--tight support-close" aria-label="Independent support notice">
    <div class="support-close__row">
      <p class="support-close__body">
        Forger Digital Solutions is an independent New Jersey studio. <a href="/support">Development support</a>,
        <a href="/support/hardware">hardware donations</a>, and <a href="/community-impact">community impact</a> routes remain strictly separated from commercial services and software releases. Contributions should not be assumed to be tax-deductible charitable donations.
      </p>
      <div class="support-close__counter">
        <VisitorCounter />
      </div>
    </div>
  </section>

  <SupportDialog />
</BaseLayout>

<style>
  /* Announcement Strip */
  .announce-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.9rem;
    margin-top: 1rem;
    padding: 0.58rem 0.9rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    font-size: 0.82rem;
  }

  .announce-strip__tag {
    padding: 0.14rem 0.46rem;
    border: 1px solid rgba(111, 160, 255, 0.45);
    border-radius: 3px;
    background: rgba(59, 123, 248, 0.12);
    color: #dbeafe;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .announce-strip__text {
    margin: 0;
    color: var(--color-text-muted);
    flex: 1 1 20rem;
  }

  .announce-strip__link {
    color: var(--color-text);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Hero */
  .hero {
    position: relative;
    margin-top: 1rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-lg);
    background: var(--color-recessed);
    overflow: hidden;
    box-shadow: var(--shadow-panel), var(--surface-highlight);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    opacity: 0.9;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      95deg,
      rgba(8, 9, 12, 0.97) 0%,
      rgba(8, 9, 12, 0.9) 48%,
      rgba(8, 9, 12, 0.35) 78%,
      rgba(8, 9, 12, 0.14) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: 52rem;
    padding: clamp(2rem, 4.8vw, 3.85rem) clamp(1.25rem, 4vw, 3.25rem) clamp(1.65rem, 3.6vw, 2.75rem);
  }

  .hero__eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-bottom: 0.85rem;
  }

  .hero__eyebrow-row .fds-eyebrow {
    margin: 0;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.15rem, 4.4vw, 4.05rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--color-text);
  }

  .hero__lead {
    max-width: 40rem;
    margin: 1.15rem 0 0;
    color: var(--color-text-muted);
    font-size: clamp(0.96rem, 1.45vw, 1.12rem);
    line-height: 1.64;
  }

  .hero__actions {
    margin-top: 1.6rem;
  }

  .hero__scope-note {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--color-text-subtle);
    font-size: 0.82rem;
    line-height: 1.54;
  }

  .hero__scope-note strong {
    color: var(--color-text-muted);
  }

  .hero__heritage {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.85rem;
    margin: 1.5rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero__heritage span {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__heritage strong {
    color: var(--color-brand-silver);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
  }

  /* Problem Ledger */
  .problem-ledger {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-structural);
    list-style: none;
  }

  .problem-ledger__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 18rem) minmax(0, 1fr);
    gap: 0.6rem 1.75rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .problem-ledger__idx {
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .problem-ledger__title {
    margin: 0;
    font-size: 1.04rem;
    line-height: 1.35;
  }

  .problem-ledger__detail {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Engines */
  .engines-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .engine-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-top: 2px solid var(--page-accent);
  }

  .engine-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .engine-card__badge {
    color: var(--page-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .engine-card h3 {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: -0.025em;
  }

  .engine-card__summary {
    margin: 0.6rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .engine-card__list {
    display: grid;
    gap: 0.4rem;
    margin: 0.9rem 0 auto;
    padding-left: 1.15rem;
    color: var(--color-text);
    font-size: 0.86rem;
    line-height: 1.52;
  }

  .flagship-boundary {
    margin: 0.95rem 0 0;
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-text-subtle);
    font-size: 0.83rem;
    line-height: 1.52;
  }

  .flagship-boundary strong {
    color: var(--color-text-muted);
  }

  /* 4-Week Pilot Timeline */
  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-border);
    list-style: none;
    overflow: hidden;
  }

  .timeline-cell {
    padding: 1.35rem 1.25rem;
    background: var(--color-bg);
  }

  .timeline-cell__week {
    display: inline-block;
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline-cell h3 {
    margin: 0.45rem 0 0.45rem;
    font-size: 1rem;
    line-height: 1.32;
  }

  .timeline-cell p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.56;
  }

  /* Security Grid */
  .security-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-border);
    overflow: hidden;
  }

  .security-cell {
    padding: 1.25rem 1.35rem;
    background: var(--color-bg-secondary);
  }

  .security-cell:last-child {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(0, 16rem) minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    align-items: baseline;
  }

  .security-cell:last-child h3 {
    margin: 0;
  }

  .security-cell__code {
    display: inline-block;
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .security-cell h3 {
    margin: 0.35rem 0 0.35rem;
    font-size: 1rem;
  }

  .security-cell p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.56;
  }

  /* Founding Studio Banner */
  .founding-banner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: 1.5rem 2.25rem;
    align-items: center;
    padding: clamp(1.35rem, 3.2vw, 2.35rem);
    border: 1px solid var(--color-border-structural);
    border-top: 2px solid var(--accent-project-forge);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: var(--surface-highlight);
  }

  .founding-banner h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .founding-banner__lead {
