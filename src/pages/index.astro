---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusPill from '../components/StatusPill.astro';
import SpecimenMedia from '../components/SpecimenMedia.astro';
import EcosystemGraph from '../components/EcosystemGraph.astro';
import JaspiliteWorkbench from '../components/JaspiliteWorkbench.astro';
import ProjectForgeGraph from '../components/ProjectForgeGraph.astro';
import SupportDialog from '../components/SupportDialog.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import {
  companyProfile,
  getRegistryEntry,
  modelFamiliesData,
  projectForgeData,
  newsUpdatesData,
  solutionsData,
} from '../data/registry';

const alexandrite = getRegistryEntry('alexandrite');
const hackmanite = getRegistryEntry('hackmanite');
const cinnabar = getRegistryEntry('cinnabar');
const jaspilite = getRegistryEntry('jaspilite');
const battleverse = getRegistryEntry('battleverse');
const stateLines = getRegistryEntry('state-lines');

const alexModel = modelFamiliesData.find((f) => f.id === 'alexandrite')!;
const hackModel = modelFamiliesData.find((f) => f.id === 'hackmanite')!;
const cinModel = modelFamiliesData.find((f) => f.id === 'cinnabar')!;
---

<BaseLayout
  description="Forger Digital Solutions is an independent AI research laboratory, commercial AI technology provider, autonomous software engineering company, and original entertainment studio building Alexandrite, Hackmanite, Cinnabar, Jaspilite, Forge BattleVerse, Project Forge, and State Lines."
>
  <!-- Section A: Compact factual announcement strip -->
  <div class="announce-strip" role="region" aria-label="Latest update">
    <span class="announce-strip__tag">Update</span>
    <p class="announce-strip__text">
      FDS Commercial AI &amp; Studio Solutions pathways open for early scoping · ForgerEMS v1.2.4-preview.1 remains publicly available for Windows.
    </p>
    <a class="announce-strip__link" href="/solutions/">Explore Solutions <span aria-hidden="true">→</span></a>
  </div>

  <!-- Section B: Editorial Hero with Bespoke Computational Convergence Visual -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__backdrop" aria-hidden="true">
      <picture>
        <source media="(max-width: 760px)" srcset="/images/forge/hero-manifold-sm.webp" type="image/webp" />
        <img
          src="/images/forge/hero-manifold.webp"
          alt=""
          width="1600"
          height="893"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__inner">
      <p class="fds-eyebrow">
        <span class="fds-eyebrow__rule"></span>
        Forger Digital Solutions · Commercial AI, Research &amp; Original Studio
      </p>
      <h1 id="hero-heading" class="hero__title">
        Specialized intelligence.<br />Extraordinary worlds.
      </h1>
      <p class="hero__lead">
        {companyProfile.supportingCopy}
      </p>
      <div class="hero__actions">
        <a href="/models/" class="btn btn-primary">Explore Our Models <span aria-hidden="true">→</span></a>
        <a href="/solutions/" class="btn btn-outline">Studio &amp; Enterprise Solutions</a>
        <a href="/research/" class="btn btn-ghost">Discover Our Research</a>
      </div>
      <p class="hero__heritage">
        <span>Studio Creed</span>
        <strong>{companyProfile.heritageSlogan}</strong>
      </p>
    </div>

    <!-- Clean 4-pillar institutional division rail -->
    <div class="division-rail" aria-label="Forger Digital Solutions four core pillars">
      {companyProfile.divisions.map((div, i) => (
        <a href={div.route} class="division-rail__item">
          <span class="division-rail__idx">0{i + 1}</span>
          <span class="division-rail__name">{div.name}</span>
          <span class="division-rail__flagships">{div.flagships.join(' · ')}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Section C: Flagship AI Model Families -->
  <section class="page-section" aria-labelledby="models-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>FDS Intelligence · Commercial &amp; Research Model Families</p>
        <h2 id="models-heading">Focused intelligence, built for the worlds we create.</h2>
        <p>
          Rather than chasing generic all-purpose claims, FDS develops specialized AI model families for game engineering, anime and animation production, and long-term collective convergence—backed by verified Apache-2.0 open-weight foundations and Project Forge research.
        </p>
      </div>
      <div class="head-links">
        <a href="/models/" class="text-link">Model catalog <span aria-hidden="true">→</span></a>
        <a href="/model-cards/" class="text-link">Model cards <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <!-- Flagship Spotlight: Alexandrite (Horizontal Split — not a generic card) -->
    <article class="alex-spotlight" data-accent="alexandrite">
      <div class="alex-spotlight__copy">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">Flagship Research Vision · Collective Intelligence</span>
          <StatusPill status={alexandrite.development_status} />
        </div>
        <h3><a href="/models/alexandrite/">Alexandrite</a></h3>
        <p class="flagship-tagline">Intelligence, converged.</p>
        <p class="flagship-body">{alexModel.summary}</p>
        <p class="flagship-boundary">
          <strong>Verification status:</strong> Long-term convergence architecture. No collective training run has completed and no public model endpoint is advertised.
        </p>
        <div class="flagship-actions">
          <a href="/models/alexandrite/" class="btn btn-outline">Explore Alexandrite <span aria-hidden="true">→</span></a>
          <a href="/evaluations/" class="text-link">Evaluation standards</a>
        </div>
      </div>
      <div class="alex-spotlight__visual">
        <SpecimenMedia
          src={alexModel.image}
          mobileSrc={alexModel.imageSm}
          alt={alexModel.imageAlt}
          label={alexModel.imageLabel}
        />
      </div>
    </article>

    <!-- Specialist Model Pair: Hackmanite & Cinnabar -->
    <div class="specialist-grid">
      <article class="specialist-panel" data-accent="hackmanite">
        <SpecimenMedia
          src={hackModel.image}
          mobileSrc={hackModel.imageSm}
          alt={hackModel.imageAlt}
          label={hackModel.imageLabel}
        />
        <div class="specialist-panel__body">
          <div class="flagship-meta-row">
            <span class="flagship-kicker">Universal Gaming AI</span>
            <StatusPill status={hackmanite.development_status} />
          </div>
          <h3><a href="/models/hackmanite/">Hackmanite</a></h3>
          <p class="flagship-tagline">Intelligence built for games.</p>
          <p class="flagship-body">{hackModel.summary}</p>
          <ul class="model-line-list">
            <li>
              <a href="/models/hackmanite/prime/"><strong>Hackmanite Prime</strong></a>
              <span>Planned base: <code>Qwen/Qwen3.8-27B</code> · coding &amp; implementation</span>
            </li>
            <li>
              <a href="/models/hackmanite/reasoning/"><strong>Hackmanite Reasoning</strong></a>
              <span>Planned base: <code>openai/gpt-oss-120b</code> · architecture &amp; debugging</span>
            </li>
          </ul>
          <a href="/models/hackmanite/" class="text-link">Inspect Hackmanite family <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="specialist-panel" data-accent="cinnabar">
        <SpecimenMedia
          src={cinModel.image}
          mobileSrc={cinModel.imageSm}
          alt={cinModel.imageAlt}
          label={cinModel.imageLabel}
        />
        <div class="specialist-panel__body">
          <div class="flagship-meta-row">
            <span class="flagship-kicker">Anime · Manga · Animation AI</span>
            <StatusPill status={cinnabar.development_status} />
          </div>
          <h3><a href="/models/cinnabar/">Cinnabar</a></h3>
          <p class="flagship-tagline">Intelligence for the art of storytelling.</p>
          <p class="flagship-body">{cinModel.summary}</p>
          <ul class="model-line-list">
            <li>
              <a href="/models/cinnabar/oracle/"><strong>Cinnabar Oracle (v1–v4.1)</strong></a>
              <span>Documented text lineages for canonical intelligence &amp; combat analysis</span>
            </li>
            <li>
              <strong>Strict Modality Boundary</strong>
              <span>Text Oracle models are not native video generators; animation workflows use external tools</span>
            </li>
          </ul>
          <a href="/models/cinnabar/" class="text-link">Inspect Cinnabar family <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

  <!-- Section D: Interactive Ecosystem Architecture Visualization -->
  <section class="page-section page-section--surface" aria-label="Interactive FDS ecosystem architecture">
    <EcosystemGraph />
  </section>

  <!-- Section E: Independent Applications (Jaspilite & Forge BattleVerse) -->
  <section class="page-section" aria-labelledby="apps-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>FDS Applications · Standalone Platforms</p>
        <h2 id="apps-heading">Software built to orchestrate intelligence and audit evidence.</h2>
        <p>
          FDS applications stand independently from our model research — engineered for autonomous software development, reproducible fictional physics analysis, and real Windows utility workflows.
        </p>
      </div>
      <a href="/products/" class="text-link">All products &amp; portfolio <span aria-hidden="true">→</span></a>
    </div>

    <!-- Jaspilite Asymmetric Showcase -->
    <article class="app-feature" data-accent="jaspilite">
      <div class="app-feature__copy">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">Autonomous Development Platform</span>
          <StatusPill status={jaspilite.development_status} />
        </div>
        <h3><a href="/products/jaspilite/">Jaspilite</a></h3>
        <p class="flagship-tagline">Your intelligence. One development workspace.</p>
        <p class="flagship-body">
          A project-aware autonomous development and multi-agent orchestration workspace operating across three explicit governance modes — <strong>Auto</strong>, <strong>Meld</strong>, and <strong>Solo</strong> — built to work with local models, customer-provided API keys, and supported provider integrations where verified. Customers use their own AI provider credentials; FDS does not route consumer subscriptions or bundle AI inference.
        </p>
        <p class="flagship-boundary">
          Supersedes legacy Forge Control branding. Private builds remain unpublished until installer verification completes.
        </p>
        <div class="flagship-actions">
          <a href="/products/jaspilite/" class="btn btn-outline">Explore Jaspilite <span aria-hidden="true">→</span></a>
          <a href="/projects/codeforge" class="text-link">See CodeForge v0.2.0</a>
        </div>
      </div>
      <div class="app-feature__visual">
        <JaspiliteWorkbench />
      </div>
    </article>

    <!-- Forge BattleVerse Reversed Asymmetric Showcase -->
    <article class="app-feature app-feature--reverse" data-accent="battleverse">
      <div class="app-feature__visual">
        <SpecimenMedia
          src="/images/forge/battleverse-combat-sim.webp"
          mobileSrc="/images/forge/battleverse-combat-sim-sm.webp"
          alt="Two original armored silhouettes mid-clash in an abstract spatial physics arena overlaid with cobalt ballistic vectors and Gaussian probability envelopes."
          label="Illustrative Simulation Concept — Original Silhouettes"
        />
      </div>
      <div class="app-feature__copy">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">Fictional Intelligence &amp; Simulation</span>
          <StatusPill status={battleverse.development_status} />
        </div>
        <h3><a href="/products/battleverse/">Forge BattleVerse</a></h3>
        <p class="flagship-tagline">Beyond opinion. Built on evidence.</p>
        <p class="flagship-body">
          An independent fictional intelligence, canonical version-tracking, and combat-simulation platform combining mathematical physics bounds, independent claim auditing, and explicit statistical uncertainty. Designed to integrate with Cinnabar Oracle while remaining a separate standalone application.
        </p>
        <p class="flagship-boundary">
          Simulation outputs model explicit assumptions and uncertainty bounds — never marketed as objective canonical facts.
        </p>
        <div class="flagship-actions">
          <a href="/products/battleverse/" class="btn btn-outline">Explore BattleVerse <span aria-hidden="true">→</span></a>
          <a href="/products/battleverse/arena/" class="text-link">Arena</a>
          <a href="/products/battleverse/creator-studio/" class="text-link">Creator Studio</a>
        </div>
      </div>
    </article>
  </section>

  <!-- Section E2: Studio & Enterprise Commercial Solutions -->
  <section class="page-section page-section--surface" aria-labelledby="solutions-home-heading">
    <div class="solutions-feature">
      <div class="solutions-feature__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Commercial Solutions · Studio &amp; Enterprise AI</p>
        <h2 id="solutions-home-heading">Personalized AI workforces built for your codebase, engine, and creative pipeline.</h2>
        <p class="flagship-body">
          Whether you are an independent game developer, an animation studio protecting original IP, or an enterprise engineering organization seeking customer-segregated AI, FDS architects specialized retrieval, multi-agent roles, and private deployment pathways tailored to real production workflows.
        </p>
        <div class="solutions-pill-links" aria-label="Commercial solution pathways">
          {solutionsData.audienceSolutions.map((sol) => (
            <a href={`/solutions/${sol.slug}/`} class="sol-chip">{sol.name} →</a>
          ))}
        </div>
        <div class="flagship-actions">
          <a href="/solutions/" class="btn btn-primary">Explore Studio &amp; Enterprise Solutions <span aria-hidden="true">→</span></a>
          <a href="/contact/?track=enterprise" class="btn btn-outline">Discuss Enterprise Solutions</a>
        </div>
        <p class="flagship-boundary">
          Private deployments and commercial model licensing are active commercial directions with strict customer data segregation — no unverified turnkey SLA or SOC 2/ISO badge is claimed today.
        </p>
      </div>
      <div class="solutions-feature__visual">
        <SpecimenMedia
          src={solutionsData.heroVisual.src}
          mobileSrc={solutionsData.heroVisual.mobileSrc}
          alt={solutionsData.heroVisual.alt}
          label={solutionsData.heroVisual.label}
        />
      </div>
    </div>
  </section>

  <!-- Section F: Project Forge Research Foundation -->
  <section class="page-section" data-accent="project-forge" aria-labelledby="forge-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>FDS Research · Project Forge</p>
        <h2 id="forge-heading">Research that becomes capability.</h2>
        <p>
          Project Forge is the permanent 15-division research and engineering intelligence foundation behind every FDS specialist model — enforcing strict provenance clearance, executable experiments, retrieval grounding, and independent holdout evaluation.
        </p>
      </div>
      <div class="head-links">
        <a href="/research/project-forge/" class="text-link">Explore Project Forge <span aria-hidden="true">→</span></a>
        <a href="/research/training/" class="text-link">Training methodology <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ProjectForgeGraph compact />
  </section>

  <!-- Section G: State Lines Cinematic Original Entertainment Showcase -->
  <section class="page-section page-section--surface" data-accent="state-lines" aria-labelledby="statelines-heading">
    <div class="statelines-banner">
      <div class="statelines-banner__media">
        <picture>
          <source media="(max-width: 760px)" srcset="/images/forge/state-lines-concept-sm.webp" type="image/webp" />
          <img
            src="/images/forge/state-lines-concept.webp"
            alt="Atmospheric concept illustration at dusk overlooking a steel cantilever river bridge, weathered brick industrial skyline, misty freight yard, and rain-slicked highway inspired by the NY/NJ/PA corridor."
            width="1600"
            height="893"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="statelines-banner__scrim"></div>
      </div>

      <div class="statelines-banner__content">
        <div class="flagship-meta-row">
          <span class="statelines-kicker">FDS Original Productions · Open-World Narrative</span>
          <StatusPill status={stateLines.development_status} label="Preproduction · Private" tone="private" />
        </div>
        <h2 id="statelines-heading" class="statelines-title">State Lines</h2>
        <p class="statelines-copy">
          An original AAA-ambition open-world organized-crime narrative rooted in the industrial corridors, bridges, and border towns of New York, New Jersey, and Pennsylvania. Grounded characters, regional authenticity, and long-form cinematic storytelling.
        </p>
        <div class="flagship-actions">
          <a href="/studio/state-lines/" class="btn btn-primary">Enter State Lines <span aria-hidden="true">→</span></a>
          <a href="/studio/productions/" class="btn btn-outline">All Original Productions</a>
        </div>
        <p class="statelines-label">
          <strong>Asset Notice:</strong> Concept Art — Work in Progress (Not Gameplay or In-Engine Capture). No release date, platform, or pricing announced.
        </p>
      </div>
    </div>
  </section>

  <!-- Section H: Newsroom & Research Updates Ledger -->
  <section class="page-section" aria-labelledby="updates-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Newsroom &amp; Engineering Journal</p>
        <h2 id="updates-heading">Verified updates and field notes.</h2>
        <p>Dated releases, methodology notes, and studio milestones grounded in real repository evidence.</p>
      </div>
      <div class="head-links">
        <a href="/news/" class="text-link">All newsroom updates <span aria-hidden="true">→</span></a>
        <a href="/notes" class="text-link">Engineering log <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ul class="fds-ledger">
      {newsUpdatesData.map((item) => (
        <li class="fds-ledger__row">
          <time class="ledger-date" datetime={item.date}>{item.date}</time>
          <div class="ledger-title-wrap">
            <span class="ledger-cat">{item.category}</span>
            <h3 class="ledger-title"><a href={item.href}>{item.title}</a></h3>
          </div>
          <p class="ledger-summary">{item.summary}</p>
          <a href={item.href} class="text-link ledger-link">Read <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Section I: Responsible Development & Non-Conflation Transparency -->
  <section class="page-section page-section--surface" aria-labelledby="transparency-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Responsible Development &amp; Trust</p>
        <h2 id="transparency-heading">Four lines we never cross.</h2>
        <p>
          Credibility comes from refusing to blur research activity into product availability. Every model card, benchmark, and product page across FDS enforces four strict boundaries.
        </p>
      </div>
      <a href="/trust/" class="text-link">Open Trust Center <span aria-hidden="true">→</span></a>
    </div>

    <div class="axiom-grid">
      {projectForgeData.axioms.map((axiom, idx) => (
        <article class="axiom-cell">
          <span class="axiom-cell__idx">0{idx + 1}</span>
          <h3>{axiom.left} <span class="axiom-neq" aria-label="does not equal">≠</span> {axiom.right}</h3>
          <p>{axiom.explanation}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Section J: Commercial Engagement & Partnership Pathways -->
  <section class="page-section" aria-labelledby="commercial-cta-heading">
    <div class="commercial-band">
      <div class="commercial-band__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Work With Forger Digital Solutions</p>
        <h2 id="commercial-cta-heading">Build with specialized intelligence — on evidence, not hype.</h2>
        <p>
          Register interest for upcoming developer previews, scope personalized gaming or animation studio AI workforces, discuss future model licensing, or connect with Project Forge research.
        </p>
      </div>
      <div class="commercial-band__actions">
        <a href="/contact/?track=developer-preview" class="btn btn-primary">Express Interest in Developer Preview <span aria-hidden="true">→</span></a>
        <a href="/contact/?track=studio-workforce" class="btn btn-outline">Register Studio Interest</a>
        <a href="/contact/?track=enterprise" class="btn btn-outline">Discuss Enterprise Solutions</a>
        <a href="/contact/?track=research-partnership" class="btn btn-ghost">Explore Research Partnerships</a>
      </div>
    </div>
  </section>

  <!-- Verified Software Distribution Portal (Preserved release contract) -->
  <section class="page-section page-section--tight" aria-labelledby="distribution-title">
    <div class="distribution-portal">
      <div class="distribution-portal__content">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Releases // Distribution</p>
        <h2 id="distribution-title" class="distribution-portal__title">Looking for ready-to-run software?</h2>
        <p class="distribution-portal__desc">
          Public builds such as <strong>ForgerEMS v1.2.4-preview.1</strong> and SHA-256-verified project source archives live in our Downloads &amp; Releases center (and legacy <strong>Forged</strong> shelf). Private development models and unreleased installers are never offered as fake downloads.
        </p>
      </div>
      <div class="distribution-portal__actions">
        <a href="/downloads/" class="btn btn-primary">Downloads &amp; Releases <span aria-hidden="true">→</span></a>
        <a href="/forged" class="btn btn-outline">Open Releases</a>
      </div>
    </div>
  </section>

  <!-- Quiet Independent Support Notice -->
  <section class="page-section page-section--tight support-close" aria-label="Independent support notice">
    <div class="support-close__row">
      <p class="support-close__body">
        Forger Digital Solutions is an independent New Jersey studio. <a class="text-link" href="/support">Development support</a>,
        <a class="text-link" href="/support/hardware">hardware donations</a>, and <a class="text-link" href="/community-impact">community impact</a> routes remain strictly separated from software products and research releases. Contributions should not be assumed to be tax-deductible charitable donations.
      </p>
      <div class="support-close__counter">
        <VisitorCounter />
      </div>
    </div>
  </section>

  <SupportDialog />
</BaseLayout>

<style>
  /* Announcement Strip */
  .announce-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1rem;
    margin-top: 1.15rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    font-size: 0.82rem;
  }

  .announce-strip__tag {
    padding: 0.16rem 0.48rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 3px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .announce-strip__text {
    margin: 0;
    color: var(--color-text-muted);
    flex: 1 1 20rem;
  }

  .announce-strip__link {
    color: var(--color-text);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Hero */
  .hero {
    position: relative;
    margin-top: 1.15rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-lg);
    background: var(--color-recessed);
    overflow: hidden;
    box-shadow: var(--shadow-panel), var(--surface-highlight);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    opacity: 0.88;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      95deg,
      rgba(8, 9, 12, 0.96) 0%,
      rgba(8, 9, 12, 0.88) 46%,
      rgba(8, 9, 12, 0.32) 76%,
      rgba(8, 9, 12, 0.14) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: 52rem;
    padding: clamp(2.4rem, 5vw, 4.1rem) clamp(1.5rem, 4vw, 3.25rem) clamp(1.9rem, 4vw, 3rem);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.35rem, 4.4vw, 4.05rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--color-text);
  }

  .support-close__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
