---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { statusMeta } from '../data/status';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import ProjectStatus from '../components/ProjectStatus.astro';
import ProcessVisualization from '../components/ProcessVisualization.astro';
import SectionHeader from '../components/SectionHeader.astro';
import NoteCard from '../components/NoteCard.astro';
import { getPublishedNotes } from '../lib/notes';

const sortedProjects = [...projects].sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99));
const flagship = projects.find((p) => p.flagship) ?? sortedProjects[0];
const latestNotes = (await getPublishedNotes()).slice(0, 3);
const roadmap = sortedProjects.filter((p) => p.roadmap);
---
<BaseLayout>
  <section class="hero">
    <div class="hero__identity" aria-hidden="true"><img src="/images/brand/fds-logo.png" alt="" /></div>
    <p class="hero__status">FDS // Research &amp; Development // Active</p>
    <h1><span>FORGER</span> <span><span class="silver">DIGITAL</span> <span class="accent">SOLUTIONS</span></span></h1>
    <p class="hero__line">Building software that learns, adapts, and creates.</p>
    <p class="hero__description">{siteConfig.description}</p>
    <div class="hero__actions"><a href="/projects" class="btn btn-primary">Explore Projects</a>{siteConfig.githubUrl && <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">View on GitHub</a>}<a href="/support" class="hero__support">Support FDS <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="page-section" aria-labelledby="flagship-title">
    <SectionHeader eyebrow="Flagship Research" title="GEMS / Training Grounds" />
    <div class="flagship" style={`--project-accent: ${flagship.accentColor || 'var(--color-accent)'}`}>
      <div class="flagship__body">
        <ProjectStatus status={flagship.status} />
        <p class="flagship__lead">Experimental intelligence engineering for training, evaluation, governed experimentation, and adaptable compute.</p>
        <p class="flagship__desc">{flagship.summary}</p>
        <a href={`/projects/${flagship.slug}`} class="btn btn-primary">Explore GEMS</a>
      </div>
      <figure class="flagship__visual">
        {flagship.heroImage
          ? <img class="flagship__img" src={flagship.heroImage.src} alt={flagship.heroImage.alt} width="1536" height="1024" loading="lazy" decoding="async" />
          : <ProjectVisual project={flagship} variant="hero" />}
        {flagship.heroImage?.caption && <figcaption>{flagship.heroImage.caption}</figcaption>}
      </figure>
    </div>
  </section>

  <section class="page-section page-section--surface" aria-labelledby="forge-title">
    <SectionHeader eyebrow="Active Work" title="Currently in the Forge" description={`${sortedProjects.length} initiatives spanning intelligent systems, creative tooling, and useful community software.`} />
    <ul class="forge-list">
      {sortedProjects.map((project) => (
        <li class="forge-item" style={`--project-accent: ${project.accentColor || 'var(--color-accent)'}`}>
          <a href={`/projects/${project.slug}`} class="forge-item__link">
            <span class="forge-item__name">{project.name}</span>
            <ProjectStatus status={project.status} />
          </a>
          <p class="forge-item__note">{statusMeta[project.status].short} {project.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="page-section" aria-labelledby="projects-title"><SectionHeader eyebrow="Project Showcase" title="What FDS is building" description="Five public initiatives. Each follows the same loop: build, test, measure, learn, evolve." /><div class="projects-grid">{sortedProjects.map((project) => <ProjectCard project={project} featured={project.flagship} />)}</div></section>

  {latestNotes.length > 0 && (
    <section class="page-section page-section--surface" aria-labelledby="notes-title">
      <div class="notes-head"><SectionHeader eyebrow="Engineering Log" title="Latest from FDS" description="Build logs and research notes from the workshop." /><a class="text-link" href="/notes">All notes <span aria-hidden="true">→</span></a></div>
      <div class="notes-grid">{latestNotes.map((note) => <NoteCard note={note} />)}</div>
    </section>
  )}

  <section class="page-section" aria-labelledby="process-title"><SectionHeader eyebrow="How FDS Builds" title="Build with evidence" description="Ideas become reusable architecture through disciplined iteration." align="center" /><ProcessVisualization /></section>

  {roadmap.length > 0 && (
    <section class="page-section page-section--surface" aria-labelledby="roadmap-title">
      <SectionHeader eyebrow="What's Ahead" title="Where the work is heading" description="Deliberately high-level. No deadlines, no promises — just direction." />
      <ul class="roadmap-list">
        {roadmap.map((project) => (
          <li class="roadmap-item" style={`--project-accent: ${project.accentColor || 'var(--color-accent)'}`}>
            <a href={`/projects/${project.slug}`}>{project.name}</a>
            <p>{project.roadmap}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="page-section" aria-labelledby="build-title"><SectionHeader eyebrow="Capability" title="What we build" /><div class="capability-grid"><article><span>01</span><h3>Intelligent Systems</h3><p>Custom AI research, model experimentation, evaluation systems, and intelligent software.</p></article><article><span>02</span><h3>Developer Infrastructure</h3><p>Tools and systems that improve software development, experimentation, and execution.</p></article><article><span>03</span><h3>Creative Technology</h3><p>AI-assisted publishing, game-development tooling, and interactive software.</p></article><article><span>04</span><h3>Community Software</h3><p>Applications that connect people with useful local information and resources.</p></article></div></section>

  <section class="page-section page-section--surface lab-section" aria-labelledby="lab-title"><SectionHeader eyebrow="FDS Lab" title="Experiment. Measure. Evolve." description="Systems are built, tested, measured, challenged, and refined before ideas become reusable architecture." /><a class="btn btn-outline" href="/lab">Explore the Lab</a></section>

  <section class="page-section" aria-labelledby="technology-title"><SectionHeader eyebrow="Tools &amp; Environments" title="Technology snapshot" description="A practical technology landscape for research, experiments, and software systems." /><div class="technology-strip"><span>Python</span><span>.NET</span><span>TypeScript</span><span>Model Training</span><span>Evaluation Systems</span><span>CUDA</span><span>Local GPU</span></div><a href="/technology" class="text-link">Explore technology <span aria-hidden="true">→</span></a></section>

  <section class="page-section support-section" aria-labelledby="support-title">
    <SectionHeader eyebrow="Support FDS" title="Help forge what's next" description="FDS is built independently. Development hardware, retired technology, and future community projects each have their own path." />
    <div class="support-grid">
      <a class="support-card" href="/support">
        <span>Development &amp; Hardware</span>
        <h3>Support Development</h3>
        <p>Cash App and Ko-fi contributions go toward workstations, GPUs, storage, testing equipment, and development infrastructure.</p>
        <em>Visit Support <span aria-hidden="true">→</span></em>
      </a>
      <a class="support-card" href="/support/hardware">
        <span>Second Life Tech</span>
        <h3>Donate Technology</h3>
        <p>Laptops, workstations, GPUs, servers, and storage that would otherwise sit unused can help development, testing, and future community initiatives.</p>
        <em>Hardware donations <span aria-hidden="true">→</span></em>
      </a>
      <a class="support-card" href="/community-impact">
        <span>Public Benefit</span>
        <h3>Community Impact</h3>
        <p>Affordable-community concepts, gardens, and technology reuse — future ideas explored openly, and always funded separately from FDS development.</p>
        <em>Learn about community impact <span aria-hidden="true">→</span></em>
      </a>
    </div>
    <p class="support-disclosure">Support provided directly to Forger Digital Solutions is used to help advance its development and operations. Contributions should not be assumed to be tax-deductible charitable donations.</p>
  </section>
</BaseLayout>
<style>
  .hero { position: relative; overflow: hidden; min-height: 38rem; padding: clamp(5rem, 12vw, 9rem) 0 var(--space-7); }.hero::after { position: absolute; top: 1rem; right: -3rem; width: min(45vw, 35rem); height: min(45vw, 35rem); border: 1px solid rgba(95,168,255,.18); border-radius: 50%; box-shadow: 0 0 0 3rem rgba(95,168,255,.03), 0 0 0 7rem rgba(203,210,220,.02); content: ''; }.hero__identity { position: absolute; z-index: -1; top: 2rem; right: 3vw; width: min(40vw, 30rem); opacity: .15; filter: grayscale(1) contrast(1.3); }.hero__status { margin-bottom: 1.25rem; color: var(--color-accent-secondary); font: 700 .73rem/1.4 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }.hero h1 { max-width: 55rem; font-size: clamp(2.8rem, 8vw, 6.7rem); line-height: .92; letter-spacing: -.06em; }.hero h1 span { display: block; }.hero h1 > span:last-child { font-weight: 500; }.hero h1 span span { display: inline; }.hero h1 .accent { color: var(--color-accent); }.hero h1 .silver { color: var(--color-silver); }.hero__line { margin-top: 1.6rem; color: var(--color-accent); font-size: clamp(1.15rem, 2.4vw, 1.45rem); font-weight: 700; }.hero__description { max-width: 43rem; margin-top: 1rem; color: var(--color-text-muted); font-size: 1.08rem; }.hero__actions { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; margin-top: 2.2rem; }.hero__support { padding: .7rem; font: 700 .73rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }.hero__support span { color: var(--color-accent); }

  .flagship { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; align-items: center; padding: 1.8rem; border: 1px solid color-mix(in srgb, var(--project-accent) 30%, var(--color-border)); border-left: 3px solid var(--project-accent); border-radius: var(--radius-lg); background: linear-gradient(120deg, color-mix(in srgb, var(--project-accent) 9%, var(--color-surface)), var(--color-surface) 60%); }.flagship__lead { margin: 1rem 0 .8rem; color: var(--color-text); font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 700; line-height: 1.3; letter-spacing: -.02em; }.flagship__desc { margin-bottom: 1.6rem; color: var(--color-text-muted); }.flagship__visual { margin: 0; }.flagship__img { display: block; width: 100%; height: auto; border: 1px solid color-mix(in srgb, var(--project-accent) 30%, var(--color-border)); border-radius: var(--radius-md); }.flagship__visual figcaption { margin-top: .6rem; color: var(--color-text-subtle); font: .78rem/1.4 var(--font-mono); }

  .forge-list { display: grid; gap: 1px; margin: 0; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-border); list-style: none; overflow: hidden; }.forge-item { padding: 1.15rem 1.3rem; background: var(--color-bg); border-left: 3px solid var(--project-accent); }.forge-item__link { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: center; }.forge-item__name { color: var(--color-text); font-size: 1.12rem; font-weight: 700; letter-spacing: -.02em; }.forge-item__link:hover .forge-item__name { color: var(--project-accent); }.forge-item__note { margin: .45rem 0 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.6; }

  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
  .notes-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between; }.notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1rem; }
  .roadmap-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }.roadmap-item { padding: 1.1rem 1.2rem; border: 1px solid var(--color-border); border-top: 3px solid var(--project-accent); border-radius: var(--radius-md); background: var(--color-surface); }.roadmap-item a { color: var(--color-text); font-weight: 700; letter-spacing: -.02em; }.roadmap-item a:hover { color: var(--project-accent); opacity: 1; }.roadmap-item p { margin: .5rem 0 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.55; }

  .capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border: 1px solid var(--color-border); background: var(--color-border); }.capability-grid article { min-height: 14rem; padding: 1.4rem; background: var(--color-bg); }.capability-grid span { color: var(--color-accent); font: 700 .72rem/1 var(--font-mono); }.capability-grid h3 { margin: 2rem 0 .7rem; font-size: 1.1rem; }.capability-grid p { color: var(--color-text-muted); font-size: .92rem; }.lab-section { text-align: center; }.lab-section :global(.section-header) { margin-right: auto; margin-left: auto; }.technology-strip { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.2rem; }.technology-strip span { padding: .5rem .7rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text-muted); font: 700 .72rem/1 var(--font-mono); }.text-link { font: 700 .78rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }.support-section { padding-bottom: 7rem; }.support-section :global(.section-header) { margin-bottom: 1.5rem; }.support-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }.support-card { display: flex; flex-direction: column; gap: .55rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); transition: border-color .2s ease, transform .2s ease; }.support-card:hover { border-color: var(--color-accent-secondary); transform: translateY(-2px); }.support-card > span { color: var(--color-accent); font: 700 .7rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.support-card h3 { margin: 0; color: var(--color-text); font-size: 1.15rem; letter-spacing: -.02em; }.support-card p { margin: 0; flex: 1; color: var(--color-text-muted); font-size: .92rem; line-height: 1.62; }.support-card em { color: var(--color-accent-secondary); font: 700 .74rem/1 var(--font-mono); font-style: normal; letter-spacing: .06em; text-transform: uppercase; }.support-disclosure { max-width: 46rem; margin: 1.4rem 0 0; color: var(--color-text-subtle); font-size: .82rem; line-height: 1.65; }
  @media (max-width: 860px) { .flagship { grid-template-columns: 1fr; gap: 1.5rem; }.support-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .hero { min-height: 32rem; }.hero__identity { top: 4rem; right: -3rem; width: 18rem; }.projects-grid { grid-template-columns: 1fr; }.capability-grid { grid-template-columns: 1fr 1fr; }.hero__actions { align-items: stretch; }.hero__actions .btn { flex: 1 1 10rem; } }
  @media (max-width: 430px) { .capability-grid { grid-template-columns: 1fr; }.hero h1 { font-size: 2.65rem; }.hero__actions .btn { flex-basis: 100%; } }
</style>
