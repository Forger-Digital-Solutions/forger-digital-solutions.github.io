---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusPill from '../components/StatusPill.astro';
import SpecimenMedia from '../components/SpecimenMedia.astro';
import HubArchitectureFlow from '../components/HubArchitectureFlow.astro';
import HubInvestigationPreview from '../components/HubInvestigationPreview.astro';
import PilotBookingActions from '../components/PilotBookingActions.astro';
import EcosystemGraph from '../components/EcosystemGraph.astro';
import JaspiliteWorkbench from '../components/JaspiliteWorkbench.astro';
import ProjectForgeGraph from '../components/ProjectForgeGraph.astro';
import SupportDialog from '../components/SupportDialog.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import { siteConfig } from '../config/site';
import {
  companyProfile,
  getRegistryEntry,
  modelFamiliesData,
  newsUpdatesData,
  studioIntelligenceHubData,
} from '../data/registry';

const hub = studioIntelligenceHubData;
const hackmanite = getRegistryEntry('hackmanite');
const battleverse = getRegistryEntry('battleverse');
const jaspilite = getRegistryEntry('jaspilite');
const alexandrite = getRegistryEntry('alexandrite');
const cinnabar = getRegistryEntry('cinnabar');
const stateLines = getRegistryEntry('state-lines');

const hackModel = modelFamiliesData.find((f) => f.id === 'hackmanite')!;
const cinModel = modelFamiliesData.find((f) => f.id === 'cinnabar')!;
const alexModel = modelFamiliesData.find((f) => f.id === 'alexandrite')!;

const hierarchyRail = [
  {
    idx: '01',
    name: 'Studio Intelligence Hub',
    detail: 'Lead Commercial Pilot · Roblox & Unreal',
    href: '/solutions/studio-intelligence-hub/',
  },
  {
    idx: '02',
    name: 'Project Forge & AI Research',
    detail: 'Engineering Context · Alexandrite · Cinnabar',
    href: '/research/project-forge/',
  },
  {
    idx: '03',
    name: 'Hackmanite & BattleVerse',
    detail: 'Game Dev AI · Fictional Intelligence',
    href: '/models/hackmanite/',
  },
  {
    idx: '04',
    name: 'Jaspilite & FDS Releases',
    detail: 'Coding Agent · State Lines · ForgerEMS',
    href: '/products/jaspilite/',
  },
];

const homepageServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: hub.name,
  serviceType: 'Managed Engineering Intelligence Pilot for Game Studios',
  provider: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
  },
  url: new URL(hub.route, siteConfig.siteUrl).href,
  description:
    'Managed four-week engineering intelligence pilot (in testing on FDS’s own Roblox and Unreal projects) connecting Roblox Studio (Luau) and Unreal Engine (C++) source code with studio technical and design documentation; scoped engine references are in development.',
};
---

<BaseLayout
  title="FDS Studio Intelligence Hub & Game Engineering AI"
  description="Connect your game studio's source code, technical documentation, and design knowledge (with scoped engine references in development). FDS Studio Intelligence Hub offers managed four-week engineering intelligence pilots for Roblox Studio and Unreal Engine teams."
  ogImage={hub.hero.image}
  accent="fds-cobalt"
  jsonLd={homepageServiceSchema}
>
  <!-- Compact Factual Announcement Strip -->
  <div class="announce-strip" role="region" aria-label="Studio Intelligence Hub pilot availability">
    <span class="announce-strip__tag">Pilot Open</span>
    <p class="announce-strip__text">
      FDS Studio Intelligence Hub four-week managed pilots open for Roblox Studio &amp; Unreal Engine teams · First five Founding Studios receive 50% off the applicable pilot fee.
    </p>
    <a class="announce-strip__link" href="/solutions/studio-intelligence-hub/">Explore the Hub <span aria-hidden="true">→</span></a>
  </div>

  <!-- SECTION A: HERO — STUDIO INTELLIGENCE HUB FIRST -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__backdrop" aria-hidden="true">
      <picture>
        <source media="(max-width: 760px)" srcset={hub.hero.imageSm} type="image/webp" />
        <img
          src={hub.hero.image}
          alt=""
          width="1600"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__inner">
      <p class="fds-eyebrow">
        <span class="fds-eyebrow__rule"></span>
        FDS Studio Intelligence Hub · Managed Engineering Intelligence Pilot
      </p>
      <h1 id="hero-heading" class="hero__title">
        Your Game Studio's Knowledge.<br />Connected.
      </h1>
      <p class="hero__lead">
        {hub.hero.supportingCopy}
      </p>

      <div class="hero__actions">
        <PilotBookingActions
          variant="pilot"
          primaryLabel={hub.hero.primaryCta}
          secondaryLabel={hub.hero.secondaryCta}
          secondaryHref="/solutions/studio-intelligence-hub/"
          showEmailFallback
        />
      </div>

      <p class="hero__scope-note">
        Managed four-week pilot (in testing on FDS's own <strong>Roblox Studio</strong> and <strong>Unreal Engine</strong> projects) · Cannot modify your repository — read-only by design · Customer-owned API keys · Scoped engine references in development · Pricing discussed during pilot assessment.
      </p>

      <p class="hero__heritage">
        <span>Forger Digital Solutions</span>
        <strong>{companyProfile.heritageSlogan}</strong>
      </p>
    </div>

    <!-- Product Hierarchy Rail -->
    <div class="division-rail" aria-label="Forger Digital Solutions product hierarchy">
      {hierarchyRail.map((item) => (
        <a href={item.href} class="division-rail__item">
          <span class="division-rail__idx">{item.idx}</span>
          <span class="division-rail__name">{item.name}</span>
          <span class="division-rail__flagships">{item.detail}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- SECTION B: THE PROBLEM -->
  <section class="page-section page-section--surface" aria-labelledby="problem-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>{hub.problem.eyebrow}</p>
        <h2 id="problem-heading">{hub.problem.headline}</h2>
        <p>{hub.problem.lead}</p>
      </div>
      <a href="/solutions/studio-intelligence-hub/" class="text-link">Full Studio Intelligence Hub overview <span aria-hidden="true">→</span></a>
    </div>

    <ol class="problem-ledger">
      {hub.problem.painPoints.map((pt) => (
        <li class="problem-ledger__row">
          <span class="problem-ledger__idx">{pt.code}</span>
          <h3 class="problem-ledger__title">{pt.title}</h3>
          <p class="problem-ledger__detail">{pt.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- SECTION C: THE SOLUTION (PROJECT FORGE ARCHITECTURE) -->
  <section class="page-section" aria-labelledby="solution-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>{hub.architecture.eyebrow}</p>
        <h2 id="solution-heading">{hub.architecture.headline}</h2>
        <p>{hub.architecture.lead}</p>
      </div>
      <a href="/solutions/studio-intelligence-hub/#architecture" class="text-link">Inspect technical architecture <span aria-hidden="true">→</span></a>
    </div>

    <HubArchitectureFlow showBoundaries />
  </section>

  <!-- SECTION D: WHAT DEVELOPERS CAN ASK -->
  <section class="page-section page-section--surface" aria-labelledby="questions-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>What Developers Can Ask</p>
        <h2 id="questions-heading">Answers backed by your files and documentation.</h2>
        <p>
          Unlike generic coding assistants that guess from isolated snippets, the Studio Intelligence Hub connects gameplay scripts and technical specifications (with scoped engine reference packs in development) so developers can trace real evidence in seconds.
        </p>
      </div>
    </div>

    <HubInvestigationPreview idPrefix="home-hub-q" />
  </section>

  <!-- SECTION E: SUPPORTED ENGINES -->
  <section class="page-section" aria-labelledby="engines-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Supported Engines</p>
        <h2 id="engines-heading">Scoped for Roblox Studio and Unreal Engine codebases.</h2>
        <p>
          Every pilot focuses on text-source and documentation workflows currently in testing on FDS's own Roblox and Unreal projects—with upfront honesty about what is in scope and what remains in development.
        </p>
      </div>
      <a href="/solutions/studio-intelligence-hub/#supported-engines" class="text-link">View engine scope details <span aria-hidden="true">→</span></a>
    </div>

    <div class="engines-grid">
      {hub.supportedEngines.map((eng) => (
        <article class="fds-panel engine-card" data-accent={eng.accent}>
          <div class="engine-card__top">
            <span class="engine-card__badge">{eng.badge}</span>
            <StatusPill status="commercial-direction" label="Pilot Scope · In Testing" />
          </div>
          <h3>{eng.name}</h3>
          <p class="engine-card__summary">{eng.summary}</p>
          <ul class="engine-card__list">
            {eng.covered.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="flagship-boundary">
            <strong>Scope Boundary:</strong> {eng.honestyBoundary}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION F: HOW THE PILOT WORKS -->
  <section class="page-section page-section--surface" aria-labelledby="pilot-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>How the Pilot Works</p>
        <h2 id="pilot-heading">Four weeks from scoping to studio review and handoff.</h2>
        <p>
          We run the Studio Intelligence Hub as a hands-on managed engagement. Exact project scope, access rules, and deliverables are agreed before Week 1 begins.
        </p>
      </div>
    </div>

    <ol class="timeline-grid">
      {hub.pilotWeeks.map((step) => (
        <li class="timeline-cell">
          <span class="timeline-cell__week">{step.week}</span>
          <h3>{step.title}</h3>
          <p>{step.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- SECTION G: SECURITY AND CONTROL -->
  <section class="page-section" aria-labelledby="security-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Security &amp; Control</p>
        <h2 id="security-heading">Read-only by design. Isolated data. Customer-owned credentials.</h2>
        <p>
          Your studio keeps control of its repositories, deployment environment, and AI provider credentials throughout the pilot.
        </p>
      </div>
      <a href="/trust/" class="text-link">FDS Trust Center <span aria-hidden="true">→</span></a>
    </div>

    <div class="security-grid">
      {hub.securityControls.map((ctrl) => (
        <article class="security-cell">
          <span class="security-cell__code">{ctrl.code}</span>
          <h3>{ctrl.title}</h3>
          <p>{ctrl.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION H: FOUNDING STUDIO PROGRAM -->
  <section class="page-section page-section--surface" aria-labelledby="founding-heading">
    <div class="founding-banner">
      <div class="founding-banner__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>{hub.foundingProgram.eyebrow}</p>
        <h2 id="founding-heading">{hub.foundingProgram.headline}</h2>
        <p class="founding-banner__lead">{hub.foundingProgram.summary}</p>
        <p class="founding-banner__benefit">
          <strong>Founding Partner Offer:</strong> {hub.foundingProgram.benefit}
        </p>
        <p class="founding-banner__pricing">{hub.foundingProgram.pricingNote}</p>
      </div>
      <div class="founding-banner__cta">
        <PilotBookingActions
          variant="founding"
          primaryLabel={hub.foundingProgram.ctaLabel}
          secondaryLabel="Explore Pilot Details"
          secondaryHref="/solutions/studio-intelligence-hub/"
          showEmailFallback
        />
      </div>
    </div>
  </section>

  <!-- SECTION I: FINAL HUB CTA -->
  <section class="page-section" aria-labelledby="final-hub-cta-heading">
    <div class="fds-panel hub-final-cta">
      <div class="hub-final-cta__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Book Your Technical Assessment</p>
        <h2 id="final-hub-cta-heading">Let's Make Your Studio's Engineering Knowledge Work Harder.</h2>
        <p>
          Talk directly with FDS engineering about your Roblox Studio or Unreal Engine project, review what qualifies for a four-week pilot, and discuss pilot pricing and Founding Studio spots.
        </p>
      </div>
      <div class="hub-final-cta__actions">
        <PilotBookingActions
          variant="pilot"
          primaryLabel="Book a Pilot Call"
          secondaryLabel="Read Pilot FAQ"
          secondaryHref="/solutions/studio-intelligence-hub/#faq"
          showEmailFallback
        />
      </div>
    </div>
  </section>

  <!-- ======================================================================
       SUBORDINATE FDS PRODUCT & RESEARCH ECOSYSTEM (Hierarchy #2 through #6)
       ====================================================================== -->

  <!-- #2: FDS AI & Engineering Capabilities (Project Forge, Ecosystem Map, Research) -->
  <section class="page-section page-section--surface" id="fds-capabilities" data-accent="project-forge" aria-labelledby="capabilities-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>FDS AI &amp; Engineering Capabilities</p>
        <h2 id="capabilities-heading">Built on Project Forge research and strict engineering discipline.</h2>
        <p>
          Beyond our Studio Intelligence Hub pilot service, Forger Digital Solutions maintains a long-term engineering research foundation (<a href="/research/project-forge/">Project Forge</a>) and specialized AI initiatives—keeping scoped managed pilots cleanly separated from active software development and long-term research.
        </p>
      </div>
      <div class="head-links">
        <a href="/research/project-forge/" class="text-link">Project Forge <span aria-hidden="true">→</span></a>
        <a href="/models/" class="text-link">Model catalog <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ProjectForgeGraph compact />

    <div class="eco-embed-wrap">
      <EcosystemGraph />
    </div>
  </section>

  <!-- #3 & #4: Hackmanite & Forge BattleVerse -->
  <section class="page-section" id="fds-ecosystem-products" aria-labelledby="ecosystem-products-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Broader FDS Product Ecosystem</p>
        <h2 id="ecosystem-products-heading">Specialized game-dev AI, fictional intelligence, and coding tools.</h2>
        <p>
          Our broader product families remain active parts of the Forger Digital Solutions ecosystem, each with transparent development status and clear boundaries.
        </p>
      </div>
      <a href="/products/" class="text-link">All products &amp; portfolio <span aria-hidden="true">→</span></a>
    </div>

    <div class="specialist-grid">
      <!-- #3: Hackmanite -->
      <article class="specialist-panel" data-accent="hackmanite">
        <SpecimenMedia
          src={hackModel.image}
          mobileSrc={hackModel.imageSm}
          alt={hackModel.imageAlt}
          label={hackModel.imageLabel}
        />
        <div class="specialist-panel__body">
          <div class="flagship-meta-row">
            <span class="flagship-kicker">03 · Universal Gaming AI Specialization</span>
            <StatusPill status={hackmanite.development_status} />
          </div>
          <h3><a href="/models/hackmanite/">Hackmanite</a></h3>
          <p class="flagship-tagline">Intelligence built for games.</p>
          <p class="flagship-body">{hackModel.summary}</p>
          <ul class="model-line-list">
            <li>
              <a href="/models/hackmanite/prime/"><strong>Hackmanite Prime</strong></a>
              <span>Planned Apache-2.0 base: <code>Qwen/Qwen3.8-27B</code> · coding &amp; implementation</span>
            </li>
            <li>
              <a href="/models/hackmanite/reasoning/"><strong>Hackmanite Reasoning</strong></a>
              <span>Planned Apache-2.0 base: <code>openai/gpt-oss-120b</code> · architecture &amp; debugging</span>
            </li>
          </ul>
          <p class="flagship-boundary">
            <strong>Status honesty:</strong> Commercial specialist model training is planned and has not completed. No public model endpoint is offered today.
          </p>
          <div class="flagship-actions">
            <a href="/models/hackmanite/" class="text-link">Inspect Hackmanite family <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>

      <!-- #4: Forge BattleVerse (and Cinnabar) -->
      <article class="specialist-panel" data-accent="battleverse">
        <SpecimenMedia
          src="/images/forge/battleverse-combat-sim.webp"
          mobileSrc="/images/forge/battleverse-combat-sim-sm.webp"
          alt="Two original armored silhouettes mid-clash in an abstract spatial physics arena overlaid with cobalt ballistic vectors and Gaussian probability envelopes."
          label="Illustrative Simulation Concept — Original Silhouettes"
        />
        <div class="specialist-panel__body">
          <div class="flagship-meta-row">
            <span class="flagship-kicker">04 · Anime, Manga &amp; Fictional Intelligence</span>
            <StatusPill status={battleverse.development_status} />
          </div>
          <h3><a href="/products/battleverse/">Forge BattleVerse</a></h3>
          <p class="flagship-tagline">Beyond opinion. Built on evidence.</p>
          <p class="flagship-body">
            A standalone fictional-universe intelligence, canonical version-tracking, and creative-production platform spanning <strong>BattleVerse Arena</strong> and <strong>BattleVerse Creator Studio</strong>—architected to pair with FDS's <a href="/models/cinnabar/">Cinnabar</a> narrative text models while maintaining its own distinct product identity.
          </p>
          <p class="flagship-boundary">
            <strong>Status honesty:</strong> Active development with no public download or live web simulator. Simulation outputs model stated assumptions and uncertainty—never objective canonical fact.
          </p>
          <div class="flagship-actions">
            <a href="/products/battleverse/" class="text-link">Explore BattleVerse <span aria-hidden="true">→</span></a>
            <a href="/products/battleverse/arena/" class="text-link">Arena</a>
            <a href="/products/battleverse/creator-studio/" class="text-link">Creator Studio</a>
          </div>
        </div>
      </article>
    </div>

    <!-- #5: Jaspilite -->
    <article class="app-feature" data-accent="jaspilite">
      <div class="app-feature__copy">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">05 · AI Coding-Agent Environment</span>
          <StatusPill status={jaspilite.development_status} />
        </div>
        <h3><a href="/products/jaspilite/">Jaspilite</a></h3>
        <p class="flagship-tagline">Your intelligence. One development workspace.</p>
        <p class="flagship-body">
          FDS's autonomous software engineering and multi-agent coding environment operating across <strong>Auto</strong>, <strong>Meld</strong>, and <strong>Solo</strong> modes using local models, customer-owned API keys, and supported provider integrations where verified. FDS does not route consumer subscriptions or bundle AI inference.
        </p>
        <p class="flagship-boundary">
          <strong>Independent from the Hub:</strong> Jaspilite is <em>not</em> a prerequisite for the Studio Intelligence Hub—Project Forge operates through your studio's existing external MCP-compatible development tools. Private Jaspilite builds remain unpublished until certified.
        </p>
        <div class="flagship-actions">
          <a href="/products/jaspilite/" class="btn btn-outline">Explore Jaspilite <span aria-hidden="true">→</span></a>
          <a href="/projects/codeforge" class="text-link">See CodeForge v0.2.0</a>
        </div>
      </div>
      <div class="app-feature__visual">
        <JaspiliteWorkbench />
      </div>
    </article>

    <!-- #6: Other FDS Research & Entertainment Initiatives -->
    <div class="initiatives-strip" aria-label="Additional FDS research and entertainment initiatives">
      <article class="initiative-item" data-accent="alexandrite">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">Long-Term Research Vision</span>
          <StatusPill status={alexandrite.development_status} />
        </div>
        <h3><a href="/models/alexandrite/">Alexandrite</a></h3>
        <p>{alexModel.summary}</p>
        <a href="/models/alexandrite/" class="text-link">Research architecture <span aria-hidden="true">→</span></a>
      </article>

      <article class="initiative-item" data-accent="cinnabar">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">Storytelling Text Lineages</span>
          <StatusPill status={cinnabar.development_status} />
        </div>
        <h3><a href="/models/cinnabar/">Cinnabar</a></h3>
        <p>{cinModel.summary} Text Oracle lineages (v1–v4.1)—not native video generators.</p>
        <a href="/models/cinnabar/" class="text-link">Inspect Cinnabar <span aria-hidden="true">→</span></a>
      </article>

      <article class="initiative-item" data-accent="state-lines">
        <div class="flagship-meta-row">
          <span class="flagship-kicker">Original Game · Preproduction</span>
          <StatusPill status={stateLines.development_status} label="Preproduction · Private" tone="private" />
        </div>
        <h3><a href="/studio/state-lines/">State Lines</a></h3>
        <p>
          Original AAA-ambition open-world narrative set in the NY/NJ/PA corridor. Concept Art — Work in Progress (Not Gameplay or In-Engine Capture). No release date announced.
        </p>
        <a href="/studio/state-lines/" class="text-link">Explore State Lines <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <!-- Newsroom & Engineering Journal Ledger -->
  <section class="page-section page-section--surface" aria-labelledby="updates-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Newsroom &amp; Engineering Journal</p>
        <h2 id="updates-heading">Verified updates and field notes.</h2>
        <p>Dated releases, methodology notes, and studio milestones grounded in real repository evidence.</p>
      </div>
      <div class="head-links">
        <a href="/news/" class="text-link">All newsroom updates <span aria-hidden="true">→</span></a>
        <a href="/notes" class="text-link">Engineering log <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ul class="fds-ledger">
      {newsUpdatesData.map((item) => (
        <li class="fds-ledger__row">
          <time class="ledger-date" datetime={item.date}>{item.date}</time>
          <div class="ledger-title-wrap">
            <span class="ledger-cat">{item.category}</span>
            <h3 class="ledger-title"><a href={item.href}>{item.title}</a></h3>
          </div>
          <p class="ledger-summary">{item.summary}</p>
          <a href={item.href} class="text-link ledger-link">Read <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Verified Software Distribution Portal (Preserved release contract) -->
  <section class="page-section page-section--tight" aria-labelledby="distribution-title">
    <div class="distribution-portal">
      <div class="distribution-portal__content">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Releases // Distribution</p>
        <h2 id="distribution-title" class="distribution-portal__title">Looking for ready-to-run software?</h2>
        <p class="distribution-portal__desc">
          Public builds such as <strong>ForgerEMS v1.2.4-preview.1</strong> and SHA-256-verified project source archives live in our Downloads &amp; Releases center (and legacy <strong>Forged</strong> shelf). Private development models and unreleased installers are never offered as fake downloads.
        </p>
      </div>
      <div class="distribution-portal__actions">
        <a href="/downloads/" class="btn btn-primary">Downloads &amp; Releases <span aria-hidden="true">→</span></a>
        <a href="/forged" class="btn btn-outline">Open Releases</a>
      </div>
    </div>
  </section>

  <!-- Quiet Independent Support Notice -->
  <section class="page-section page-section--tight support-close" aria-label="Independent support notice">
    <div class="support-close__row">
      <p class="support-close__body">
        Forger Digital Solutions is an independent New Jersey studio. <a class="text-link" href="/support">Development support</a>,
