---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { statusMeta } from '../data/status';
import { statusStripEntries, canonicalStatusLabels } from '../data/manifest';
import ProjectStatus from '../components/ProjectStatus.astro';
import SectionHeader from '../components/SectionHeader.astro';
import NoteCard from '../components/NoteCard.astro';
import SupportDialog from '../components/SupportDialog.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import PortfolioArchitecture from '../components/PortfolioArchitecture.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import { getPublishedNotes } from '../lib/notes';

const sortedProjects = [...projects].sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99));
const activeProjects = sortedProjects.filter((p) => !['codeforge', 'forgerems', 'forge-control', 'dead-trails-west'].includes(p.slug));
const latestNotes = (await getPublishedNotes()).slice(0, 3);
---
<BaseLayout
  description="Forger Digital Solutions is an independent New Jersey software and interactive media studio. Explore released developer tools, technician software, and original games in development."
>
  <VisitorCounter />
  <section class="hero">
    <div class="hero__copy">
      <p class="hero__status"><span></span> FDS // INDEPENDENT STUDIO</p>
      <p class="hero__eyebrow"><span class="accent">FORGER</span> <span><span class="silver">DIGITAL</span> <span class="accent">SOLUTIONS</span></span></p>
      <h1>Build the tools.<br />Build the worlds.</h1>
      <p class="hero__line">Independent software engineering, AI development tools, and original interactive experiences.</p>
      <p class="hero__description">Forger Digital Solutions is an independent New Jersey studio. We build focused products, publish them when they are ready, and show the difference between released software and work still in development.</p>
      <div class="hero__actions"><a href="/projects" class="btn btn-primary">Explore Products <span aria-hidden="true">→</span></a><a href="/forged" class="btn btn-outline">Get CodeForge</a>{siteConfig.githubUrl && <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="hero__github">GitHub <span aria-hidden="true">↗</span></a>}</div>
    </div>
    <PortfolioArchitecture />
    <div class="hero__rail" aria-label="FDS focus areas"><span>SOFTWARE ENGINEERING</span><span>DEVELOPER TOOLS</span><span>TECHNICIAN SOFTWARE</span><span>GAME WORLDS</span></div>
  </section>

  <section class="status-strip page-section--tight" aria-label="Current FDS product status">
    <ul class="status-strip__list" role="list">
      {statusStripEntries.map((entry) => (
        <li class="status-strip__item" data-status={entry.canonicalStatus}>
          <a href={entry.projectUrl ?? '#'} class="status-strip__link">
            <span class="status-strip__name">{entry.name}</span>
            <span class="status-strip__state">{canonicalStatusLabels[entry.canonicalStatus]}</span>
          </a>
        </li>
      ))}
      <li class="status-strip__item"><a href="/forged" class="status-strip__link"><span class="status-strip__name">Releases</span><span class="status-strip__state">Downloads & Archives</span></a></li>
    </ul>
  </section>

  <section class="page-section portfolio-showcases" aria-label="Featured Forger Digital Solutions products">
    <ProductShowcase
      id="codeforge-showcase"
      eyebrow="Flagship software · Windows · CLI · VS Code"
      title="CodeForge puts engineering work in motion."
      summary="A released, free-first autonomous software-engineering platform that can inspect a repository, plan bounded work, edit through controlled tools, run checks, and review the result."
      status="Released · v0.2.0"
      statusTone="released"
      href="/forged"
      cta="Get CodeForge"
      visual="codeforge"
      points={['Windows 10/11 x64 installer and portable builds', 'ForgeZero rejects paid, local, unknown-cost, and unverified model routes', 'Provider capacity can be limited; unlimited availability is not promised']}
    />
    <ProductShowcase
      id="forge-control-showcase"
      eyebrow="Separate FDS product · orchestration"
      title="Forge Control is being built to coordinate coding agents."
      summary="The intended workflow discovers eligible connected agents, breaks substantial work into safe independent tasks, coordinates execution, and keeps progress and verification visible. It is not a chatbot or a replacement agent."
      status="Active development · no public release"
      statusTone="development"
      href="/projects/forge-control"
      cta="Explore the product direction"
      visual="control"
      reverse
      points={['Automatic task distribution and concurrent independent work are product goals', 'Quota-aware pause, rebalance, and resume behavior is intended architecture', 'Codex, Claude Code, GitHub Copilot, and Antigravity are potential integrations; working support is unverified']}
    />
    <ProductShowcase
      id="forge-aaa-showcase"
      eyebrow="CodeForge architecture · game-development direction"
      title="Forge AAA brings game workflows into CodeForge’s engineering direction."
      summary="A planned development area within CodeForge—not a separate application. The direction is to help coordinate software, asset, animation, and validation work across game-development tools while keeping the developer in control."
      status="Planned development direction · not a shipped feature set"
      statusTone="planned"
      href="/projects/codeforge#forge-aaa"
      cta="See the Forge AAA architecture"
      visual="forge-aaa"
      points={['Intended to span Unreal Engine and Blender workflows', 'Potential areas include 3D assets, character work, animation, and game systems', 'No claim that Forge AAA produces complete AAA games or ships these integrations today']}
    />
    <ProductShowcase
      id="dead-trails-showcase"
      eyebrow="Original game · Sundance, New Jersey"
      title="Dead Trails West is a world built to change with its people."
      summary="An original historical game in private development, set in 1882 and centered on George and Edward Bauer. The design reaches beyond gunfights to settlement life, exploration, survival, wildlife, work, and consequence."
      status="Private development · no public playable build"
      statusTone="private"
      href="/projects/dead-trails-west"
      cta="Explore the game and its development"
      visual="dead-trails-west"
      reverse
      points={['Unreal Engine 4.27 and Blender development pipeline', 'Seasonal world, farming, ranching, hunting, fishing, construction, and law are design goals—not blanket claims of completion', 'Illustration is an original CSS setting study, not gameplay evidence']}
    />
    <ProductShowcase
      id="forgerems-showcase"
      eyebrow="Technician workbench · Windows"
      title="ForgerEMS brings practical repair tools together."
      summary="A local-first workbench for USB toolkit creation, drive validation, system information, USB and port intelligence, driver guidance, and diagnostics."
      status="Public preview · v1.2.4-preview.1"
      statusTone="preview"
      href="/projects/forgerems"
      cta="Explore ForgerEMS and its preview"
      visual="forgerems"
      points={['Portable ZIP and installer preview artifacts are available through the existing release page', 'Preview binaries are unsigned; verify published SHA-256 checksums before running', 'The release remains a preview, not a production-certified or Microsoft Verified application']}
    />
  </section>

  <section class="page-section page-section--surface engineering-credibility" aria-labelledby="engineering-title">
    <SectionHeader eyebrow="Engineering practice" title="A product page should tell you what the build can do." description="FDS separates shipped behavior from active development and future direction. The boundary matters as much as the feature list." headingLevel="h2" />
    <div class="engineering-credibility__grid">
      <article><span>01 / RELEASED</span><h3>Real release paths</h3><p>CodeForge downloads, version, platform support, and checksum information come from the existing release records.</p></article>
      <article><span>02 / GUARDED</span><h3>Cost and execution boundaries</h3><p>CodeForge documents its free-first routing limits, command approvals, and fail-closed behavior rather than promising unlimited inference.</p></article>
      <article><span>03 / LABELED</span><h3>Development is not availability</h3><p>Active projects are described with their status and limitations. No unreleased product is offered as a download.</p></article>
    </div>
  </section>

  <section class="page-section development-ledger" aria-labelledby="development-ledger-title">
    <SectionHeader eyebrow="Development ledger" title="Progress, with its evidence boundary attached." description="A release proves a release. A focused acceptance test proves that scenario—not an entire product or game." headingLevel="h2" />
    <ol class="development-ledger__list">
      <li><span class="development-ledger__state development-ledger__state--released">Released</span><div><h3>CodeForge v0.2.0</h3><p>Windows 10/11 x64 installer and portable builds are listed on Forged with published checksums.</p></div><a href="/forged">Release details <span aria-hidden="true">→</span></a></li>
      <li><span class="development-ledger__state development-ledger__state--preview">Public preview</span><div><h3>ForgerEMS v1.2.4-preview.1</h3><p>Preview distribution is available; packaging and capability boundaries remain part of its preview status.</p></div><a href="/projects/forgerems">Preview details <span aria-hidden="true">→</span></a></li>
      <li><span class="development-ledger__state development-ledger__state--reported">Owner-reported tests</span><div><h3>Dead Trails West integration work</h3><p>Owner-reported checks cover navigation between locations, a general-store interaction, rejection of a purchase with an empty wallet, and the return route. These scenarios do not certify the full game or establish a public build.</p></div><a href="/projects/dead-trails-west">Game status <span aria-hidden="true">→</span></a></li>
      <li><span class="development-ledger__state development-ledger__state--unverified">Unverified</span><div><h3>Forge Control installer and integrations</h3><p>A development installer and acceptance testing were reported by the owner. V23 certification, working provider integrations, and public availability have not been independently verified.</p></div><a href="/projects/forge-control">Current status <span aria-hidden="true">→</span></a></li>
    </ol>
  </section>

  <section class="page-section page-section--surface" aria-labelledby="additional-work-title">
    <SectionHeader eyebrow="Additional development" title="More useful problems to solve." description="Other FDS projects remain part of the portfolio, each with its own scope, status, and development path." headingLevel="h2" id="additional-work-title" />
    <ul class="forge-list">
      {activeProjects.map((project) => (
        <li class="forge-item" style={`--project-accent: ${project.accentColor || 'var(--color-accent)'}`}>
          <a href={`/projects/${project.slug}`} class="forge-item__link">
            <span class="forge-item__name">{project.name}</span>
            <ProjectStatus status={project.status} />
          </a>
          <p class="forge-item__note">{statusMeta[project.status].short} {project.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="page-section page-section--tight" aria-labelledby="distribution-title">
    <div class="distribution-portal">
      <div class="distribution-portal__content">
        <p class="distribution-portal__eyebrow">Releases // Distribution</p>
        <h2 id="distribution-title" class="distribution-portal__title">Looking for ready-to-run software?</h2>
        <p class="distribution-portal__desc">
          Public FDS software, verified release artifacts, and project source archives live on <strong>Releases</strong> (Forged), with SHA-256 checksums shown for every archive. Project pages detail technical architecture, roadmaps, and research notes.
        </p>
      </div>
      <div class="distribution-portal__actions">
        <a href="/forged" class="btn btn-primary">Open Releases <span aria-hidden="true">→</span></a>
        <a href="/projects" class="btn btn-outline">Explore Products</a>
      </div>
    </div>
  </section>

  {latestNotes.length > 0 && (
    <section class="page-section page-section--surface" aria-labelledby="notes-title">
      <div class="notes-head"><SectionHeader eyebrow="Engineering Log" title="Recent changes and findings" description="Public field notes from active engineering, product work, and model research." /><a class="text-link" href="/notes">All notes <span aria-hidden="true">→</span></a></div>
      <div class="notes-grid">{latestNotes.map((note) => <NoteCard note={note} />)}</div>
    </section>
  )}

  <section class="page-section page-section--tight support-section" aria-labelledby="support-title">
    <div class="support-close">
      <p class="support-close__body" id="support-title">
        FDS is independent. If you want to help the work continue, <a class="text-link" href="/support">development support</a>,
        <a class="text-link" href="/support/hardware">hardware donations</a>, and <a class="text-link" href="/community-impact">community impact</a> routes are kept separate from products and releases.
      </p>
    </div>
    <p class="support-disclosure">Contributions should not be assumed to be tax-deductible charitable donations.</p>
  </section>
  <SupportDialog />
  </BaseLayout>
<script is:inline>
  (() => {
    // Hero status pulse: suspend once the hero has scrolled away so the far-offscreen
    // opacity animation cannot fall back to per-frame main-thread ticking.
    const el = document.querySelector('.hero__status');
    if (!el || !('IntersectionObserver' in window)) return;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => el.toggleAttribute('data-hero-status-paused', !e.isIntersecting));
    }, { rootMargin: '100px 0px 100px 0px', threshold: 0 });
    obs.observe(el);
  })();
</script>
<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(24rem, .88fr); gap: 2rem; align-items: center; min-height: min(49rem, calc(100svh - 4rem)); padding: clamp(4rem, 9vw, 7rem) 0 5rem; }.hero::before { position: absolute; z-index: -1; top: 8%; right: -18%; width: 62%; aspect-ratio: 1; border: 1px solid rgba(78,122,222,.1); border-radius: 50%; box-shadow: 0 0 0 5rem rgba(38,78,174,.018), 0 0 0 11rem rgba(134,158,202,.012); content: ''; }.hero__copy { position: relative; z-index: 4; }.hero__status { display: flex; align-items: center; gap: .55rem; margin: 0 0 1.2rem; color: var(--color-accent-bright); font: 700 .69rem/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }  .hero__status span { width: .45rem; height: .45rem; border: 1px solid #7597e5; border-radius: 50%; background: #315fca; box-shadow: 0 0 8px rgba(49,95,202,.7); animation: system-pulse 3s ease-in-out infinite; }.hero__eyebrow { margin: 0 0 .9rem; font: 700 .78rem/1.5 var(--font-mono); letter-spacing: .2em; text-transform: uppercase; }.hero__eyebrow .accent { color: #5a82e8; }.hero__eyebrow .silver { color: var(--color-silver); }.hero h1 { max-width: 44rem; margin: 0; font-size: clamp(2.35rem, 4.6vw, 3.9rem); line-height: 1.02; letter-spacing: -.045em; text-wrap: balance; }.hero__line { margin: 1.4rem 0 0; color: var(--color-text); font-size: clamp(1.08rem, 2vw, 1.3rem); font-weight: 700; letter-spacing: -.02em; }.hero__description { max-width: 42rem; margin: .9rem 0 0; color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.75; }.hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; margin-top: 2.15rem; }.hero__actions .btn-primary span { margin-left: .45rem; transition: transform .2s ease; }.hero__actions .btn-primary:hover span { transform: translateX(.2rem); }.hero__github { padding: .7rem; color: var(--color-text-muted); font: 700 .7rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }.hero__github span { color: var(--color-accent-bright); transition: transform .2s ease; }.hero__github:hover { color: var(--color-text); }.hero__github:hover span { display: inline-block; transform: translate(.15rem, -.15rem); }.hero__rail { position: absolute; right: 0; bottom: 1.25rem; left: 0; display: flex; flex-wrap: wrap; gap: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); color: var(--color-text-subtle); font: 650 .58rem/1 var(--font-mono); letter-spacing: .13em; }.hero__rail span::before { margin-right: .45rem; color: var(--color-accent-bright); content: '//'; }
  @keyframes system-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
  :global([data-bg-paused]) .hero__status span, .hero__status[data-hero-status-paused] span { animation-play-state: paused; }

  /* Canonical status strip: product states driven by the product manifest. */
  .status-strip { padding: 0 0 1rem; }
  .status-strip__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1px; margin: 0 auto; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-border); box-shadow: var(--shadow-sm); list-style: none; overflow: hidden; max-width: 72rem; }
  .status-strip__item { background: rgba(6,11,19,.94); }
  .status-strip__link { display: grid; gap: .3rem; padding: .95rem 1.1rem; transition: background .2s ease; }
  .status-strip__link:hover, .status-strip__link:focus-visible { background: rgba(31,54,102,.35); }
  .status-strip__name { color: var(--color-text); font-weight: 700; font-size: .98rem; letter-spacing: -.01em; }
  .status-strip__state { display: inline-flex; align-items: center; gap: .45rem; color: var(--color-text-muted); font: 700 .62rem/1.4 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .status-strip__state::before { width: .4rem; height: .4rem; border-radius: 50%; background: var(--color-text-subtle); content: ''; }
  .status-strip__item[data-status='public-release'] .status-strip__state::before { background: #61d7a1; box-shadow: 0 0 8px rgba(97,215,161,.7); }
  .status-strip__item[data-status='public-preview'] .status-strip__state::before { background: #5a9df0; box-shadow: 0 0 8px rgba(90,157,240,.7); }
  .status-strip__item[data-status='active-ai-research'] .status-strip__state::before { background: #b487ff; box-shadow: 0 0 8px rgba(180,135,255,.7); }
  .status-strip__item[data-status='active-development'] .status-strip__state::before { background: #e0a63c; box-shadow: 0 0 8px rgba(224,166,60,.7); }

  .flagship { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; align-items: center; overflow: hidden; padding: 1.8rem; border: 1px solid color-mix(in srgb, var(--project-accent) 35%, var(--color-border)); border-left: 3px solid var(--project-accent); border-radius: var(--radius-xl); background: linear-gradient(120deg, color-mix(in srgb, var(--project-accent) 9%, rgba(13,20,32,.96)), rgba(7,12,20,.95) 60%); box-shadow: var(--shadow-panel), inset 0 1px rgba(255,255,255,.04); }.flagship::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(85,138,231,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(85,138,231,.04) 1px, transparent 1px); background-size: 32px 32px; content: ''; pointer-events: none; }.flagship__body, .flagship__visual { position: relative; }.flagship__lead { margin: 1rem 0 .8rem; color: var(--color-text); font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 700; line-height: 1.3; letter-spacing: -.02em; }.flagship__desc { margin-bottom: 1.6rem; color: var(--color-text-muted); }.flagship__visual { margin: 0; }.flagship__img { display: block; width: 100%; height: auto; border: 1px solid color-mix(in srgb, var(--project-accent) 34%, var(--color-border)); border-radius: var(--radius-md); box-shadow: 0 18px 45px rgba(0,0,0,.32); }.flagship__visual figcaption { margin-top: .6rem; color: var(--color-text-subtle); font: .78rem/1.4 var(--font-mono); }

  .forge-list { display: grid; gap: 1px; margin: 0; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-border); box-shadow: var(--shadow-sm); list-style: none; overflow: hidden; }.forge-item { position: relative; padding: 1.2rem 1.35rem; border-left: 3px solid var(--project-accent); background: rgba(6,11,19,.93); transition: background .2s ease; }.forge-item:hover { background: color-mix(in srgb, var(--project-accent) 6%, rgba(9,15,25,.96)); }.forge-item__link { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: center; }.forge-item__name { color: var(--color-text); font-size: 1.12rem; font-weight: 700; letter-spacing: -.02em; }.forge-item__link:hover .forge-item__name { color: var(--project-accent); }.forge-item__note { margin: .45rem 0 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.6; }
  .priority-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .priority-card { display: flex; flex-direction: column; min-height: 16rem; padding: 1.35rem; border: 1px solid var(--color-border); border-top: 2px solid var(--priority-color); border-radius: var(--radius-lg); background: linear-gradient(155deg, color-mix(in srgb, var(--priority-color) 9%, rgba(12,19,31,.96)), rgba(6,10,17,.96) 65%); box-shadow: var(--shadow-sm); transition: transform .2s ease, border-color .2s ease; }
  .priority-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--priority-color) 48%, var(--color-border)); }
  .priority-card--codeforge { --priority-color: #6f9aff; }.priority-card--control { --priority-color: #36b8ba; }.priority-card--west { --priority-color: #c47c4f; }
  .priority-card__index { color: var(--priority-color); font: 700 .62rem/1.4 var(--font-mono); letter-spacing: .12em; }
  .priority-card h3 { margin: 1.5rem 0 .6rem; color: var(--color-text); font-size: 1.25rem; letter-spacing: -.025em; }
  .priority-card h3 span { color: var(--priority-color); font-size: .78rem; }
  .priority-card p { margin: 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.65; }
  .priority-card__link { display: inline-flex; gap: .45rem; align-items: center; margin-top: auto; padding-top: 1.2rem; color: var(--priority-color); font-size: .82rem; font-weight: 750; }

  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
  .notes-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between; }.notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1rem; }
  .roadmap-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }.roadmap-item { padding: 1.1rem 1.2rem; border: 1px solid var(--color-border); border-top: 3px solid var(--project-accent); border-radius: var(--radius-md); background: var(--color-surface); }.roadmap-item a { color: var(--color-text); font-weight: 700; letter-spacing: -.02em; }.roadmap-item a:hover { color: var(--project-accent); opacity: 1; }.roadmap-item p { margin: .5rem 0 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.55; }

  /* Distribution portal strip: routes downloads exclusively to /forged */
  .distribution-portal {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, .6fr);
    gap: 1.5rem 2rem;
    align-items: center;
    padding: 1.8rem 2rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(13,20,32,.95), rgba(7,12,20,.95));
    box-shadow: var(--shadow-sm);
  }
  .distribution-portal__eyebrow {
    margin: 0 0 .5rem;
    color: var(--color-accent-bright);
    font: 700 .68rem/1 var(--font-mono);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .distribution-portal__title {
    margin: 0;
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    line-height: 1.2;
    letter-spacing: -.025em;
    color: var(--color-text);
  }
  .distribution-portal__desc {
    margin: .6rem 0 0;
    color: var(--color-text-muted);
    font-size: .95rem;
    line-height: 1.65;
  }
  .distribution-portal__actions {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    align-items: flex-start;
  }

  /* Closing support note: deliberately quiet — support lives in the footer, About, and /support. */
  .support-close { display: grid; }
  .support-close__body { max-width: 52rem; margin: 0; color: var(--color-text-muted); line-height: 1.7; }
  .support-disclosure { max-width: 46rem; margin: 1.8rem 0 0; color: var(--color-text-subtle); font-size: .82rem; line-height: 1.65; }
