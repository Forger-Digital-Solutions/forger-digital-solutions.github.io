---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { statusMeta } from '../data/status';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectStatus from '../components/ProjectStatus.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GemsStory from '../components/GemsStory.astro';
import NoteCard from '../components/NoteCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import SupportDialog from '../components/SupportDialog.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import OneFDSEcosystem from '../components/OneFDSEcosystem.astro';
import FDSEcosystem from '../components/FDSEcosystem.astro';
import { getPublishedNotes } from '../lib/notes';

const sortedProjects = [...projects].sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99));
const codeForge = projects.find((p) => p.slug === 'codeforge');
const activeProjects = sortedProjects.filter((p) => !['codeforge', 'gems-training-grounds'].includes(p.slug));
const latestNotes = (await getPublishedNotes()).slice(0, 3);
---
<BaseLayout>
  <VisitorCounter />
  <section class="hero">
    <div class="hero__copy">
      <p class="hero__status"><span></span> FDS SYSTEMS // ONLINE</p>
      <h1><span class="accent">FORGER</span> <span><span class="silver">DIGITAL</span> <span class="accent">SOLUTIONS</span></span></h1>
      <p class="hero__line">Independent software and AI engineering.</p>
      <p class="hero__description">{siteConfig.description}</p>
      <div class="hero__actions"><a href="/projects" class="btn btn-primary">Explore Projects <span aria-hidden="true">→</span></a>{siteConfig.githubUrl && <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">View on GitHub</a>}<a href="/support" class="hero__support">Support FDS <span aria-hidden="true">→</span></a></div>
    </div>
    <FDSEcosystem />
    <div class="hero__rail" aria-label="FDS focus areas"><span>SOFTWARE ENGINEERING</span><span>AI RESEARCH</span><span>PRACTICAL APPLICATIONS</span></div>
  </section>

  <section class="page-section page-section--surface ecosystem-section">
    <OneFDSEcosystem />
  </section>

  <section class="page-section" aria-labelledby="codeforge-title">
    <SectionHeader eyebrow="Featured System" title="CodeForge engineers software" description="A released free-first autonomous engineering platform—and an important part of how FDS develops increasingly complex products." />
    {codeForge && <ProjectCard project={codeForge} featured={true} />}
  </section>

  <GemsStory />

  <section class="page-section page-section--surface" aria-labelledby="forge-title">
    <SectionHeader eyebrow="Current Work" title="Specialized products in development" description="Each project has a concrete job; status labels separate research, private work, prerelease software, and released products." />
    <ul class="forge-list">
      {activeProjects.map((project) => (
        <li class="forge-item" style={`--project-accent: ${project.accentColor || 'var(--color-accent)'}`}>
          <a href={`/projects/${project.slug}`} class="forge-item__link">
            <span class="forge-item__name">{project.name}</span>
            <ProjectStatus status={project.status} />
          </a>
          <p class="forge-item__note">{statusMeta[project.status].short} {project.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="page-section" aria-labelledby="forged-title">
    <SectionHeader eyebrow="Forged" title="Software you can use now" description="Released and public-preview applications with canonical download paths." />
    <div class="projects-grid">{products.map((product) => <ProductCard product={product} />)}</div>
    <p><a class="text-link" href="/forged">Explore Forged <span aria-hidden="true">→</span></a></p>
  </section>

  {latestNotes.length > 0 && (
    <section class="page-section page-section--surface" aria-labelledby="notes-title">
      <div class="notes-head"><SectionHeader eyebrow="Notes" title="Recent changes and findings" description="Public field notes from active engineering, product work, and model research." /><a class="text-link" href="/notes">All notes <span aria-hidden="true">→</span></a></div>
      <div class="notes-grid">{latestNotes.map((note) => <NoteCard note={note} />)}</div>
    </section>
  )}

  <section class="page-section support-section" aria-labelledby="support-title">
    <SectionHeader eyebrow="Support FDS" title="Help independent work continue" description="Contributions can support compute, development hardware, testing devices, hosting, and software work. Community initiatives remain a separate track." />
    <div class="support-grid">
      <a class="support-card" href="/support">
        <span>Development &amp; Hardware</span>
        <h3>Support Development</h3>
        <p>Cash App and Ko-fi contributions go toward workstations, GPUs, storage, testing equipment, and development services.</p>
        <em>Visit Support <span aria-hidden="true">→</span></em>
      </a>
      <a class="support-card" href="/support/hardware">
        <span>Second Life Tech</span>
        <h3>Donate Technology</h3>
        <p>Laptops, workstations, GPUs, servers, and storage that would otherwise sit unused can help development, testing, and future community initiatives.</p>
        <em>Hardware donations <span aria-hidden="true">→</span></em>
      </a>
      <a class="support-card" href="/community-impact">
        <span>Public Benefit</span>
        <h3>Community Impact</h3>
        <p>Affordable-community concepts, gardens, and technology reuse — future ideas explored openly, and always funded separately from FDS development.</p>
        <em>Learn about community impact <span aria-hidden="true">→</span></em>
      </a>
    </div>
    <p class="support-disclosure">Support provided directly to Forger Digital Solutions is used to help advance its development and operations. Contributions should not be assumed to be tax-deductible charitable donations.</p>
    </section>
    <SupportDialog />
  </BaseLayout>
<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(24rem, .88fr); gap: 2rem; align-items: center; min-height: min(49rem, calc(100svh - 4rem)); padding: clamp(4rem, 9vw, 7rem) 0 5rem; }.hero::before { position: absolute; z-index: -1; top: 8%; right: -18%; width: 62%; aspect-ratio: 1; border: 1px solid rgba(78,122,222,.1); border-radius: 50%; box-shadow: 0 0 0 5rem rgba(38,78,174,.018), 0 0 0 11rem rgba(134,158,202,.012); content: ''; }.hero__copy { position: relative; z-index: 4; }.hero__status { display: flex; align-items: center; gap: .55rem; margin: 0 0 1.2rem; color: var(--color-accent-bright); font: 700 .69rem/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.hero__status span { width: .45rem; height: .45rem; border: 1px solid #7597e5; border-radius: 50%; background: #315fca; box-shadow: 0 0 13px rgba(49,95,202,.8); animation: system-pulse 3s ease-in-out infinite; }.hero h1 { max-width: 57rem; margin: 0; font-size: clamp(3rem, 7.4vw, 6.65rem); line-height: .88; letter-spacing: -.068em; text-wrap: balance; }.hero h1 > span { display: block; }.hero h1 > span:last-child { font-weight: 520; }.hero h1 span span { display: inline; }.hero h1 .accent { color: #315fd2; background: linear-gradient(180deg, #5a82e8 0%, #1945b7 78%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }.hero h1 .silver { color: var(--color-silver); background: linear-gradient(180deg, #f2f5f9, #909cab); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }.hero__line { margin: 1.7rem 0 0; color: var(--color-text); font-size: clamp(1.1rem, 2.1vw, 1.38rem); font-weight: 700; letter-spacing: -.02em; }.hero__description { max-width: 42rem; margin: .9rem 0 0; color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.75; }.hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; margin-top: 2.15rem; }.hero__actions .btn-primary span { margin-left: .45rem; transition: transform .2s ease; }.hero__actions .btn-primary:hover span { transform: translateX(.2rem); }.hero__support { padding: .7rem; font: 700 .7rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }.hero__support span { color: var(--color-accent-bright); transition: transform .2s ease; }.hero__support:hover span { display: inline-block; transform: translateX(.2rem); }.hero__rail { position: absolute; right: 0; bottom: 1.25rem; left: 0; display: flex; gap: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); color: var(--color-text-subtle); font: 650 .58rem/1 var(--font-mono); letter-spacing: .13em; }.hero__rail span::before { margin-right: .45rem; color: var(--color-accent-bright); content: '//'; }
  @keyframes system-pulse { 50% { opacity: .5; box-shadow: 0 0 4px rgba(49,95,202,.45); } }

  .flagship { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; align-items: center; overflow: hidden; padding: 1.8rem; border: 1px solid color-mix(in srgb, var(--project-accent) 35%, var(--color-border)); border-left: 3px solid var(--project-accent); border-radius: var(--radius-xl); background: linear-gradient(120deg, color-mix(in srgb, var(--project-accent) 9%, rgba(13,20,32,.96)), rgba(7,12,20,.95) 60%); box-shadow: var(--shadow-panel), inset 0 1px rgba(255,255,255,.04); }.flagship::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(85,138,231,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(85,138,231,.04) 1px, transparent 1px); background-size: 32px 32px; content: ''; pointer-events: none; }.flagship__body, .flagship__visual { position: relative; }.flagship__lead { margin: 1rem 0 .8rem; color: var(--color-text); font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 700; line-height: 1.3; letter-spacing: -.02em; }.flagship__desc { margin-bottom: 1.6rem; color: var(--color-text-muted); }.flagship__visual { margin: 0; }.flagship__img { display: block; width: 100%; height: auto; border: 1px solid color-mix(in srgb, var(--project-accent) 34%, var(--color-border)); border-radius: var(--radius-md); box-shadow: 0 18px 45px rgba(0,0,0,.32); }.flagship__visual figcaption { margin-top: .6rem; color: var(--color-text-subtle); font: .78rem/1.4 var(--font-mono); }

  .forge-list { display: grid; gap: 1px; margin: 0; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-border); box-shadow: var(--shadow-sm); list-style: none; overflow: hidden; }.forge-item { position: relative; padding: 1.2rem 1.35rem; border-left: 3px solid var(--project-accent); background: rgba(6,11,19,.93); transition: background .2s ease; }.forge-item:hover { background: color-mix(in srgb, var(--project-accent) 6%, rgba(9,15,25,.96)); }.forge-item__link { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: center; }.forge-item__name { color: var(--color-text); font-size: 1.12rem; font-weight: 700; letter-spacing: -.02em; }.forge-item__link:hover .forge-item__name { color: var(--project-accent); }.forge-item__note { margin: .45rem 0 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.6; }

  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
  .notes-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between; }.notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1rem; }
  .roadmap-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }.roadmap-item { padding: 1.1rem 1.2rem; border: 1px solid var(--color-border); border-top: 3px solid var(--project-accent); border-radius: var(--radius-md); background: var(--color-surface); }.roadmap-item a { color: var(--color-text); font-weight: 700; letter-spacing: -.02em; }.roadmap-item a:hover { color: var(--project-accent); opacity: 1; }.roadmap-item p { margin: .5rem 0 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.55; }

  .capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-border); box-shadow: var(--shadow-sm); }.capability-grid article { position: relative; min-height: 14rem; padding: 1.4rem; background: linear-gradient(150deg, rgba(13,20,32,.96), rgba(6,11,19,.96)); }.capability-grid article::after { position: absolute; right: 1rem; bottom: 1rem; width: 1.2rem; height: 1.2rem; border-right: 1px solid var(--color-border-blue); border-bottom: 1px solid var(--color-border-blue); content: ''; }.capability-grid span { color: var(--color-accent-bright); font: 700 .72rem/1 var(--font-mono); }.capability-grid h3 { margin: 2rem 0 .7rem; font-size: 1.1rem; }.capability-grid p { color: var(--color-text-muted); font-size: .92rem; }.lab-section { text-align: center; }.lab-section :global(.section-header) { margin-right: auto; margin-left: auto; }.technology-strip { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.2rem; }.technology-strip span { padding: .52rem .72rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: rgba(13,20,32,.8); color: var(--color-text-muted); font: 700 .7rem/1 var(--font-mono); box-shadow: inset 0 1px rgba(255,255,255,.025); }.text-link { font: 700 .76rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }.support-section { padding-bottom: 7rem; }.support-section :global(.section-header) { margin-bottom: 1.5rem; }.support-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }.support-card { position: relative; isolation: isolate; display: flex; flex-direction: column; gap: .55rem; overflow: hidden; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: linear-gradient(145deg, rgba(13,20,32,.95), rgba(7,12,20,.95)); box-shadow: var(--shadow-sm), inset 0 1px rgba(255,255,255,.03); transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease; }.support-card::before { position: absolute; z-index: -1; inset: 0; background: radial-gradient(16rem circle at var(--card-x, 80%) var(--card-y, 15%), rgba(45,111,247,.15), transparent 58%); content: ''; opacity: .4; }.support-card:hover { border-color: var(--color-accent-secondary); box-shadow: var(--shadow-md); transform: translateY(-3px); }.support-card > span { color: var(--color-accent-bright); font: 700 .68rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.support-card h3 { margin: 0; color: var(--color-text); font-size: 1.15rem; letter-spacing: -.02em; }.support-card p { margin: 0; flex: 1; color: var(--color-text-muted); font-size: .92rem; line-height: 1.62; }.support-card em { color: var(--color-accent-secondary); font: 700 .72rem/1 var(--font-mono); font-style: normal; letter-spacing: .06em; text-transform: uppercase; }.support-disclosure { max-width: 46rem; margin: 1.4rem 0 0; color: var(--color-text-subtle); font-size: .82rem; line-height: 1.65; }
  @media (max-width: 960px) { .hero { grid-template-columns: 1fr; gap: 1rem; min-height: auto; padding-top: 5rem; }.hero__copy { max-width: 47rem; }.hero :global(.fds-ecosystem) { margin-top: 1rem; }.hero__rail { position: relative; grid-column: 1; margin-top: 2rem; }.flagship { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }.support-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .hero { padding-top: 4rem; }.hero :global(.fds-ecosystem) { margin-top: .5rem; }.hero__rail { flex-wrap: wrap; gap: .8rem 1.2rem; margin-top: 1rem; }.projects-grid { grid-template-columns: 1fr; }.capability-grid { grid-template-columns: 1fr 1fr; }.hero__actions { align-items: stretch; }.hero__actions .btn { flex: 1 1 10rem; } }
  @media (max-width: 430px) { .capability-grid { grid-template-columns: 1fr; }.hero h1 { font-size: 2.65rem; }.hero__actions .btn { flex-basis: 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero__status span { animation: none; } }
</style>
