---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessVisualization from '../components/ProcessVisualization.astro';
import { projects } from '../data/projects';
import { siteConfig } from '../config/site';

const gemsProject = projects.find(p => p.id === 'gems-training-grounds');
const otherProjects = projects.filter(p => p.id !== 'gems-training-grounds');
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="status-pill">
        <span class="pulse-dot"></span>
        <span>{siteConfig.statusText}</span>
      </div>

      <h1 class="hero-title">{siteConfig.name}</h1>
      <p class="hero-headline">{siteConfig.tagline}</p>
      <p class="hero-description">{siteConfig.description}</p>

      <div class="hero-actions">
        <a href="#featured-projects" class="btn btn-primary">Explore Projects</a>
        <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">View on GitHub ↗</a>
        <a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer" class="btn btn-support">Support FDS</a>
      </div>
    </div>
  </section>

  <!-- Process Methodology -->
  <section class="section process-section">
    <div class="container">
      <div class="section-header">
        <span class="mono section-subtitle">// RESEARCH METHODOLOGY</span>
        <h2>Engineering Lifecycle</h2>
      </div>
      <ProcessVisualization />
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section id="featured-projects" class="section">
    <div class="container">
      <div class="section-header">
        <span class="mono section-subtitle">// PORTFOLIO OF RESEARCH & SYSTEMS</span>
        <h2>Featured Projects</h2>
      </div>

      {gemsProject && (
        <div class="flagship-wrapper">
          <ProjectCard project={gemsProject} />
        </div>
      )}

      <div class="projects-grid">
        {otherProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Lab Section Preview -->
  <section class="section lab-preview">
    <div class="container">
      <div class="lab-card">
        <div class="section-header text-center">
          <span class="mono section-subtitle">// FDS LAB</span>
          <h2>We build, break, measure, and rebuild.</h2>
          <p class="lab-intro">
            FDS operates as an independent software research lab committed to evidence-based development, adaptive computing, and governed machine intelligence.
          </p>
        </div>

        <div class="principles-grid">
          <div class="principle-item">
            <div class="principle-num">01</div>
            <h4>Evidence over assumptions</h4>
            <p>Systems are not considered successful simply because they executed. Results should provide evidence that the intended objective was achieved.</p>
          </div>
          <div class="principle-item">
            <div class="principle-num">02</div>
            <h4>Adaptive computation</h4>
            <p>Software should understand and adapt to the hardware and compute environments available to it.</p>
          </div>
          <div class="principle-item">
            <div class="principle-num">03</div>
            <h4>Governed intelligence</h4>
            <p>Training, evaluation, experimentation, and deployment should leave understandable evidence.</p>
          </div>
          <div class="principle-item">
            <div class="principle-num">04</div>
            <h4>Build through experimentation</h4>
            <p>Research findings should become reusable architecture only after surviving meaningful real-world use.</p>
          </div>
        </div>

        <div class="lab-cta">
          <a href="/lab" class="btn btn-secondary">Explore Lab Principles →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    padding: 6rem 0 4rem 0;
    position: relative;
    background: radial-gradient(circle at top center, rgba(249, 115, 22, 0.08) 0%, transparent 70%);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-medium);
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--forge-orange);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--forge-orange);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .hero-headline {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--forge-orange);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 700px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Section Common */
  .section {
    padding: 4rem 0;
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-subtitle {
    font-size: 0.8125rem;
    color: var(--forge-orange);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 700;
  }

  /* Flagship & Projects Grid */
  .flagship-wrapper {
    margin-bottom: 2rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  /* Lab Preview */
  .lab-preview {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lab-card {
    padding: 1rem 0;
  }

  .text-center {
    text-align: center;
  }

  .lab-intro {
    color: var(--text-muted);
    max-width: 650px;
    margin: 1rem auto 0 auto;
    font-size: 1rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }

  .principle-item {
    background: var(--bg-dark);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .principle-num {
    font-family: var(--font-mono);
    color: var(--forge-orange);
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .principle-item h4 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .principle-item p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .lab-cta {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 0 2rem 0;
    }
  }
</style>
