---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { certifications } from '../data/certifications';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessVisualization from '../components/ProcessVisualization.astro';
import CertificationCard from '../components/CertificationCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
const sortedProjects = [...projects].sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99));
const featuredCertifications = certifications.filter((cert) => cert.featured).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="hero__identity" aria-hidden="true"><img src="/images/brand/fds-logo.png" alt="" /></div>
    <p class="hero__status">FDS // Research &amp; Development // Active</p>
    <h1>FORGER <span>DIGITAL SOLUTIONS</span></h1>
    <p class="hero__line">Building software that learns, adapts, and creates.</p>
    <p class="hero__description">{siteConfig.description}</p>
    <div class="hero__actions"><a href="/projects" class="btn btn-primary">Explore Projects</a>{siteConfig.githubUrl && <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">View on GitHub</a>}<a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer" class="hero__support">Support FDS <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="page-section" aria-labelledby="projects-title"><SectionHeader eyebrow="Active Work" title="Projects in the forge" description={`${sortedProjects.length} public initiatives spanning intelligent systems, creative tooling, and useful community software.`} /><div class="projects-grid">{sortedProjects.map((project) => <ProjectCard project={project} featured={project.flagship} />)}</div></section>

  <section class="page-section page-section--surface" aria-labelledby="process-title"><SectionHeader eyebrow="FDS Process" title="Build with evidence" description="Ideas become reusable architecture through disciplined iteration." align="center" /><ProcessVisualization /></section>

  <section class="page-section" aria-labelledby="build-title"><SectionHeader eyebrow="Capability" title="What we build" /><div class="capability-grid"><article><span>01</span><h3>Intelligent Systems</h3><p>Custom AI research, model experimentation, evaluation systems, and intelligent software.</p></article><article><span>02</span><h3>Developer Infrastructure</h3><p>Tools and systems that improve software development, experimentation, and execution.</p></article><article><span>03</span><h3>Creative Technology</h3><p>AI-assisted publishing, game-development tooling, and interactive software.</p></article><article><span>04</span><h3>Community Software</h3><p>Applications that connect people with useful local information and resources.</p></article></div></section>

  <section class="page-section page-section--surface lab-section" aria-labelledby="lab-title"><SectionHeader eyebrow="FDS Lab" title="Experiment. Measure. Evolve." description="Systems are built, tested, measured, challenged, and refined before ideas become reusable architecture." /><a class="btn btn-outline" href="/lab">Explore the Lab</a></section>

  <section class="page-section" aria-labelledby="technology-title"><SectionHeader eyebrow="Tools &amp; Environments" title="Technology snapshot" description="A practical technology landscape for research, experiments, and software systems." /><div class="technology-strip"><span>Python</span><span>.NET</span><span>TypeScript</span><span>Model Training</span><span>Evaluation Systems</span><span>CUDA</span><span>Local GPU</span></div><a href="/technology" class="text-link">Explore technology <span aria-hidden="true">→</span></a></section>

  <section class="page-section page-section--surface" aria-labelledby="certifications-title"><SectionHeader eyebrow="Public Evidence" title="Credentials &amp; Certifications" description="Technical credentials can be published here as public documentation becomes available." />{featuredCertifications.length ? <><div class="certifications-grid">{featuredCertifications.map((cert) => <CertificationCard cert={cert} />)}</div><a href="/certifications" class="btn btn-outline">View All Certifications</a></> : <div class="credentials-empty"><span aria-hidden="true">◇</span><p>No public certificates are currently configured. The credentials archive is ready for curated, reviewed documents.</p><a href="/certifications">Visit the credentials archive</a></div>}</section>

  <section class="page-section support-section" aria-labelledby="support-title"><SectionHeader eyebrow="Independent Work" title="Support independent development" description="FDS is independently developed. Support helps sustain continued research, experimentation, software development, and infrastructure." /><a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Support FDS on Ko-fi</a></section>
</BaseLayout>
<style>
  .hero { position: relative; overflow: hidden; min-height: 38rem; padding: clamp(5rem, 12vw, 9rem) 0 var(--space-7); }.hero::after { position: absolute; top: 1rem; right: -3rem; width: min(45vw, 35rem); height: min(45vw, 35rem); border: 1px solid rgba(95,168,255,.18); border-radius: 50%; box-shadow: 0 0 0 3rem rgba(95,168,255,.025), 0 0 0 7rem rgba(229,154,82,.018); content: ''; }.hero__identity { position: absolute; z-index: -1; top: 2rem; right: 3vw; width: min(40vw, 30rem); opacity: .15; filter: grayscale(1) contrast(1.3); }.hero__status { margin-bottom: 1.25rem; color: var(--color-accent-secondary); font: 700 .73rem/1.4 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }.hero h1 { max-width: 55rem; font-size: clamp(2.8rem, 8vw, 6.7rem); line-height: .92; letter-spacing: -.06em; }.hero h1 span { display: block; color: var(--color-text-muted); font-weight: 500; }.hero__line { margin-top: 1.6rem; color: var(--color-accent); font-size: clamp(1.15rem, 2.4vw, 1.45rem); font-weight: 700; }.hero__description { max-width: 43rem; margin-top: 1rem; color: var(--color-text-muted); font-size: 1.08rem; }.hero__actions { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; margin-top: 2.2rem; }.hero__support { padding: .7rem; font: 700 .73rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }.hero__support span { color: var(--color-accent); }.projects-grid, .certifications-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }.capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border: 1px solid var(--color-border); background: var(--color-border); }.capability-grid article { min-height: 14rem; padding: 1.4rem; background: var(--color-bg); }.capability-grid span { color: var(--color-accent); font: 700 .72rem/1 var(--font-mono); }.capability-grid h3 { margin: 2rem 0 .7rem; font-size: 1.1rem; }.capability-grid p { color: var(--color-text-muted); font-size: .92rem; }.lab-section { text-align: center; }.lab-section :global(.section-header) { margin-right: auto; margin-left: auto; }.technology-strip { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.2rem; }.technology-strip span { padding: .5rem .7rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text-muted); font: 700 .72rem/1 var(--font-mono); }.text-link { font: 700 .78rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }.credentials-empty { max-width: 38rem; padding: 2rem; border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); background: rgba(255,255,255,.015); }.credentials-empty span { color: var(--color-accent); font-size: 1.8rem; }.credentials-empty p { margin: .5rem 0; color: var(--color-text-muted); }.credentials-empty a { font-weight: 700; }.support-section { padding-bottom: 7rem; }.support-section :global(.section-header) { margin-bottom: 1.5rem; }
  @media (max-width: 760px) { .hero { min-height: 32rem; }.hero__identity { top: 4rem; right: -3rem; width: 18rem; }.projects-grid, .certifications-grid { grid-template-columns: 1fr; }.capability-grid { grid-template-columns: 1fr 1fr; }.hero__actions { align-items: stretch; }.hero__actions .btn { flex: 1 1 10rem; } }
  @media (max-width: 430px) { .capability-grid { grid-template-columns: 1fr; }.hero h1 { font-size: 2.65rem; }.hero__actions .btn { flex-basis: 100%; } }
</style>
