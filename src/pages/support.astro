---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../config/site';

const { cashAppHandle, cashAppUrl, kofiUrl } = siteConfig;
---
<BaseLayout
  title="Support FDS"
  description="Support Forger Digital Solutions development and hardware: Cash App $ForgerDigital, Ko-fi, donated technology, and future community initiatives — clearly separated."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Support</span>
  </nav>

  <header class="spage-hero">
    <p class="spage-hero__eyebrow">Support FDS</p>
    <h1>Support Forger Digital Solutions</h1>
    <p class="spage-hero__lead">
      FDS independently develops software, model research, creative tools,
      civic and local-discovery products, and technician applications.
      There are two distinct ways to help — development support and community
      impact — and they are never mixed.
    </p>
  </header>

  <section class="spage-section" aria-labelledby="dev-hw-title">
    <SectionHeader eyebrow="Path 01" title="Development & Hardware Support" description="Direct support keeps FDS independent: it pays for the equipment, compute, and services that current projects run on." />
    <div class="method-grid">
      <article class="method method--primary">
        <p class="method__label">Cash App</p>
        <div class="method__row">
          <code class="method__handle">{cashAppHandle}</code>
          <button type="button" class="copy-handle" data-copy-handle={cashAppHandle} aria-label={`Copy Cash App handle ${cashAppHandle}`}>
            <span class="copy-handle__label" aria-live="polite">Copy</span>
          </button>
        </div>
        <a href={cashAppUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Support FDS on Cash App</a>
      </article>
      {kofiUrl && (
        <article class="method">
          <p class="method__label">Ko-fi</p>
          <p class="method__desc">One-off or recurring Ko-fi support helps keep independent FDS software work, model research, testing, and operations moving.</p>
          <a href={kofiUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Support FDS on Ko-fi</a>
        </article>
      )}
      <a class="method method--link" href="/support/hardware">
        <p class="method__label">Hardware</p>
        <p class="method__desc">Usable equipment — workstations, GPUs, servers, storage — can support development, testing, and research. Donations are coordinated privately, contact first.</p>
        <span class="method__cta">Explore hardware donations <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="spage-section" aria-labelledby="community-title">
    <SectionHeader eyebrow="Path 02" title="Community Impact" description="Future public-benefit concepts — gardens, technology reuse, affordable-community ideas — are exploratory and always kept separate from FDS development support." />
    <a class="community-link" href="/community-impact">
      <span>Learn about community impact</span>
      <span aria-hidden="true">→</span>
    </a>
  </section>

  <aside class="disclosure" aria-label="Support disclosure">
    <h2>Good to know</h2>
    <p>
      Support provided directly to Forger Digital Solutions is used to help
      advance its development and operations. Contributions should not be
      assumed to be tax-deductible charitable donations. Community-project
      funding is not active yet — when it arrives, it will be structured and
      reported separately from FDS development and hardware support.
    </p>
  </aside>
</BaseLayout>
<style>
  .spage-hero { max-width: 52rem; padding: clamp(2.5rem, 6vw, 4rem) 0 var(--space-5); }.spage-hero__eyebrow { margin-bottom: .65rem; color: var(--color-accent); font: 700 .72rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.spage-hero h1 { margin: 0; font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -.04em; }.spage-hero__lead { margin-top: 1.1rem; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.75; }

  .spage-section { padding-bottom: var(--space-6); }.method-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1rem; }.method { display: flex; flex-direction: column; gap: 1.1rem; align-items: flex-start; padding: 1.6rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }.method--primary { border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border)); background: linear-gradient(150deg, color-mix(in srgb, var(--color-accent) 8%, var(--color-bg)), var(--color-bg) 65%); }.method--link { transition: border-color .2s ease, transform .2s ease; }.method--link:hover { border-color: var(--color-accent-secondary); transform: translateY(-2px); }.method__label { margin: 0; color: var(--color-text-subtle); font: 700 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.method__desc { margin: 0; flex: 1; color: var(--color-text-muted); font-size: .95rem; line-height: 1.65; }.method__row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }.method__handle { padding: .55rem .75rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-accent-secondary); font: 800 1.15rem/1 var(--font-mono); letter-spacing: .02em; }.method__cta { color: var(--color-accent-secondary); font: 700 .74rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }.method--link .method__cta { margin-top: auto; }

  .community-link { display: inline-flex; align-items: center; gap: .7rem; padding: 1.1rem 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); color: var(--color-text); font-weight: 650; transition: border-color .2s ease, transform .2s ease; }.community-link:hover { border-color: var(--color-accent-secondary); transform: translateY(-2px); }.community-link:focus-visible { outline: 2px solid var(--color-accent-bright); outline-offset: 3px; }.community-link span[aria-hidden] { color: var(--color-accent-secondary); }

  .copy-handle { padding: .55rem .7rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: transparent; color: var(--color-text-muted); font: 700 .72rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: color .2s ease, border-color .2s ease; }.copy-handle:hover { border-color: var(--color-accent-secondary); color: var(--color-text); }.copy-handle.copied { border-color: var(--color-accent); color: var(--color-accent-secondary); }

  .disclosure { max-width: 46rem; margin-bottom: var(--space-7); padding: 1.3rem 1.5rem; border: 1px solid var(--color-border); border-left: 3px solid var(--color-silver); border-radius: var(--radius-md); background: var(--color-bg-secondary); }.disclosure h2 { margin: 0 0 .5rem; font-size: .98rem; }.disclosure p { margin: 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.7; }
</style>
<script>
  const copyText = async (text: string): Promise<boolean> => {
    if (!navigator.clipboard?.writeText) return false;
    await navigator.clipboard.writeText(text);
    return true;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy-handle]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy-handle') ?? '';
      const label = btn.querySelector<HTMLElement>('.copy-handle__label');
      try {
        const copied = await copyText(text);
        if (!copied) {
          if (label) label.textContent = text;
          return;
        }
        btn.classList.add('copied');
        if (label) label.textContent = 'Copied';
        window.setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = 'Copy';
        }, 1800);
      } catch {
        if (label) label.textContent = text;
      }
    });
  });
</script>
