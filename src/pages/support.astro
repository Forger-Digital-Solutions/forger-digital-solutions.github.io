---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../config/site';

const { cashAppHandle, cashAppUrl, kofiUrl } = siteConfig;

const hardwareMailtoHref =`mailto:${siteConfig.supportEmail}?subject=${encodeURIComponent(siteConfig.hardwareDonationSubject)}&body=${encodeURIComponent(siteConfig.hardwareDonationBody)}`;
---
<BaseLayout
  title="Support FDS"
  description="Support Forger Digital Solutions development and hardware: Cash App $ForgerDigital, Ko-fi, donated technology, and future community initiatives — clearly separated."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Support</span>
  </nav>

  <header class="spage-hero">
    <p class="spage-hero__eyebrow">Support FDS</p>
    <h1>Support Forger Digital Solutions</h1>
    <p class="spage-hero__lead">
      FDS is independently building software, AI research and development,
      accessibility and community technology concepts, and related projects.
      There are two distinct ways to help — development support and community
      impact — and they are never mixed.
    </p>
  </header>

  <div class="bucket-grid">
    <article class="bucket">
      <h2>FDS Development &amp; Hardware Support</h2>
      <p>
        Money or equipment that advances FDS work directly: workstations,
        laptops, GPUs, storage, servers, testing equipment, networking gear,
        hosting, and development infrastructure.
      </p>
    </article>
    <article class="bucket bucket--community">
      <h2>Community Impact Initiatives</h2>
      <p>
        A separate track of future public-benefit concepts — affordable-community
        ideas, community gardens, technology reuse and access. Still in
        exploration; community-project funding is not active.
      </p>
    </article>
  </div>

  <section class="spage-section" aria-labelledby="dev-hw-title">
    <SectionHeader eyebrow="Bucket One" title="Development & Hardware" description="Support here helps FDS obtain and operate things like GPUs, workstations, laptops, SSD/NVMe storage, test hardware, servers, and development infrastructure." />
    <div class="method-grid">
      <article class="method method--primary">
        <p class="method__label">Cash App</p>
        <div class="method__row">
          <code class="method__handle">{cashAppHandle}</code>
          <button type="button" class="copy-handle" data-copy-handle={cashAppHandle} aria-label={`Copy Cash App handle ${cashAppHandle}`}>
            <span class="copy-handle__label" aria-live="polite">Copy</span>
          </button>
        </div>
        <a href={cashAppUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Support FDS on Cash App</a>
      </article>
      {kofiUrl && (
        <article class="method">
          <p class="method__label">Ko-fi</p>
          <p class="method__desc">One-off or recurring Ko-fi support goes to the same place: keeping independent FDS research, experimentation, and infrastructure moving.</p>
          <a href={kofiUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Support FDS on Ko-fi</a>
        </article>
      )}
    </div>
  </section>

  <section class="spage-section" aria-labelledby="other-ways-title">
    <SectionHeader eyebrow="More Paths" title="Other ways to help" />
    <div class="more-grid">
      <a class="more-card" href="/support/hardware">
        <h3>Give Your Old Tech a Second Life</h3>
        <p>Laptops, workstations, GPUs, servers, storage, and other usable equipment can support development, testing, research, education, or future community technology initiatives.</p>
        <span class="more-card__cta">Explore hardware donations <span aria-hidden="true">→</span></span>
      </a>
      <a class="more-card" href={hardwareMailtoHref}>
        <h3>Email About Equipment</h3>
        <p>Already know what you'd like to pass along? Reach FDS directly with the details and we'll take it from there.</p>
        <span class="more-card__cta">Contact FDS <span aria-hidden="true">→</span></span>
      </a>
      <a class="more-card" href="/community-impact">
        <h3>Community Impact</h3>
        <p>Affordable-community concepts, gardens, technology reuse, and related future initiatives — exploratory, and always kept separate from FDS development funding.</p>
        <span class="more-card__cta">Learn about community impact <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <aside class="disclosure" aria-label="Support disclosure">
    <h2>Good to know</h2>
    <p>
      Support provided directly to Forger Digital Solutions is used to help
      advance its development and operations. Contributions should not be
      assumed to be tax-deductible charitable donations. Community-project
      funding is not active yet — when it arrives, it will be structured and
      reported separately from FDS development and hardware support.
    </p>
  </aside>
</BaseLayout>
<style>
  .spage-hero { max-width: 52rem; padding: clamp(2.5rem, 6vw, 4rem) 0 var(--space-5); }.spage-hero__eyebrow { margin-bottom: .65rem; color: var(--color-accent); font: 700 .72rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.spage-hero h1 { margin: 0; font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -.04em; }.spage-hero__lead { margin-top: 1.1rem; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.75; }

  .bucket-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-bottom: var(--space-6); }.bucket { padding: 1.5rem; border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent); border-radius: var(--radius-md); background: var(--color-surface); }.bucket--community { border-left-color: var(--color-silver); }.bucket h2 { margin: 0 0 .55rem; font-size: 1.08rem; letter-spacing: -.02em; }.bucket p { margin: 0; color: var(--color-text-muted); font-size: .94rem; line-height: 1.65; }

  .spage-section { padding-bottom: var(--space-6); }.method-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1rem; }.method { display: flex; flex-direction: column; gap: 1.1rem; align-items: flex-start; padding: 1.6rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }.method--primary { border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border)); background: linear-gradient(150deg, color-mix(in srgb, var(--color-accent) 8%, var(--color-bg)), var(--color-bg) 65%); }.method__label { margin: 0; color: var(--color-text-subtle); font: 700 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.method__desc { margin: 0; color: var(--color-text-muted); font-size: .95rem; line-height: 1.65; }.method__row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }.method__handle { padding: .55rem .75rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-accent-secondary); font: 800 1.15rem/1 var(--font-mono); letter-spacing: .02em; }

  .copy-handle { padding: .55rem .7rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: transparent; color: var(--color-text-muted); font: 700 .72rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: color .2s ease, border-color .2s ease; }.copy-handle:hover { border-color: var(--color-accent-secondary); color: var(--color-text); }.copy-handle.copied { border-color: var(--color-accent); color: var(--color-accent-secondary); }

  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }.more-card { display: flex; flex-direction: column; gap: .6rem; padding: 1.4rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); transition: border-color .2s ease, transform .2s ease; }.more-card:hover { border-color: var(--color-accent-secondary); transform: translateY(-2px); }.more-card h3 { margin: 0; color: var(--color-text); font-size: 1.05rem; letter-spacing: -.02em; }.more-card p { margin: 0; flex: 1; color: var(--color-text-muted); font-size: .92rem; line-height: 1.6; }.more-card__cta { color: var(--color-accent-secondary); font: 700 .74rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }

  .disclosure { max-width: 46rem; margin-bottom: var(--space-7); padding: 1.3rem 1.5rem; border: 1px solid var(--color-border); border-left: 3px solid var(--color-silver); border-radius: var(--radius-md); background: var(--color-bg-secondary); }.disclosure h2 { margin: 0 0 .5rem; font-size: .98rem; }.disclosure p { margin: 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.7; }

  @media (max-width: 760px) { .bucket-grid { grid-template-columns: 1fr; } }
</style>
<script>
  const copyText = async (text: string): Promise<boolean> => {
    if (!navigator.clipboard?.writeText) return false;
    await navigator.clipboard.writeText(text);
    return true;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy-handle]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy-handle') ?? '';
      const label = btn.querySelector<HTMLElement>('.copy-handle__label');
      try {
        const copied = await copyText(text);
        if (!copied) {
          if (label) label.textContent = text;
          return;
        }
        btn.classList.add('copied');
        if (label) label.textContent = 'Copied';
        window.setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = 'Copy';
        }, 1800);
      } catch {
        if (label) label.textContent = text;
      }
    });
  });
</script>
