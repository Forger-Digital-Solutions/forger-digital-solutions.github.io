---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="Notes"
  description="Build logs, research notes, and writing from Forger Digital Solutions."
>
  <div class="page-head">
    <h1 class="page-title">Notes</h1>
    <p class="page-description">
      Build logs, research notes, and thinking-out-loud from the FDS workshop. Written in the
      same spirit as the Lab: build, test, measure, learn, evolve.
    </p>
  </div>

  {notes.length === 0 ? (
    <div class="notes-empty">
      <p>No notes have been published yet. Check back soon.</p>
    </div>
  ) : (
    <ul class="notes-list">
      {notes.map((note) => (
        <li>
          <a class="note-card" href={`/notes/${note.id}`}>
            <p class="note-card__date">{fmtDate(note.data.date)}</p>
            <h2 class="note-card__title">{note.data.title}</h2>
            <p class="note-card__desc">{note.data.description}</p>
            {note.data.tags.length > 0 && (
              <div class="note-card__tags">
                {note.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
            <span class="note-card__more">Read note <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .page-head { max-width: 46rem; padding: 3rem 0 2rem; }
  .page-title { font-size: clamp(2rem, 5vw, 2.75rem); margin-bottom: 1rem; letter-spacing: -.03em; }
  .page-description { color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.7; }
  .notes-empty { padding: 3rem 0 6rem; color: var(--color-text-muted); }
  .notes-list { display: grid; gap: 1rem; margin: 0 0 5rem; padding: 0; list-style: none; }
  .note-card { display: block; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
  .note-card:hover { border-color: var(--color-accent-secondary); transform: translateY(-3px); box-shadow: var(--shadow-md); opacity: 1; }
  .note-card__date { color: var(--color-text-subtle); font: 700 .7rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .note-card__title { margin: .7rem 0 .5rem; font-size: clamp(1.25rem, 2.4vw, 1.6rem); line-height: 1.2; letter-spacing: -.02em; color: var(--color-text); }
  .note-card__desc { max-width: 44rem; color: var(--color-text-muted); line-height: 1.7; }
  .note-card__tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
  .note-card__more { display: inline-block; margin-top: 1.1rem; color: var(--color-text); font: 700 .74rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .note-card__more span { color: var(--color-accent); }
</style>
