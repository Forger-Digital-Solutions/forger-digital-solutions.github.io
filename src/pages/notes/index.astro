---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getPublishedNotes } from '../../lib/notes';

const notes = await getPublishedNotes();
---
<BaseLayout
  title="Notes"
  description="A public engineering log from Forger Digital Solutions: build logs, research notes, and writing tied to active projects."
>
  <div class="page-head">
    <h1 class="page-title">Notes</h1>
    <p class="page-description">
      Public field notes on product releases, engineering decisions, model research, findings,
      and meaningful changes across FDS.
    </p>
  </div>

  {notes.length === 0 ? (
    <div class="notes-empty">
      <p>No notes have been published yet. Check back soon.</p>
    </div>
  ) : (
    <ul class="notes-grid">
      {notes.map((note) => (
        <li><NoteCard note={note} /></li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .page-head { max-width: 46rem; padding: 3rem 0 2rem; }
  .page-title { font-size: clamp(2rem, 5vw, 2.75rem); margin-bottom: 1rem; letter-spacing: -.03em; }
  .page-description { color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.7; }
  .notes-empty { padding: 3rem 0 6rem; color: var(--color-text-muted); }
  .notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1rem; margin: 0 0 5rem; padding: 0; list-style: none; }
</style>
