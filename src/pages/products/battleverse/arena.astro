---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusPill from '../../../components/StatusPill.astro';
import BattleVerseArenaDemo from '../../../components/BattleVerseArenaDemo.astro';
import { getRegistryEntry, solutionsData } from '../../../data/registry';

const entry = getRegistryEntry('battleverse-arena');
const { arenaAudiences, arenaCapabilities } = solutionsData.battleverseDirections;
---

<BaseLayout
  title="BattleVerse Arena — Fictional Intelligence & Combat Simulation"
  description="BattleVerse Arena is Forge BattleVerse's consumer-facing fictional intelligence, canonical evidence verification, and probability-based combat simulation application."
  accent="battleverse"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/products/">Products</a><span aria-hidden="true">/</span>
    <a href="/products/battleverse/">Forge BattleVerse</a><span aria-hidden="true">/</span>
    <span aria-current="page">Arena</span>
  </nav>

  <header class="page-head arena-head" data-accent="battleverse">
    <div class="meta-bar">
      <p class="page-eyebrow">Forge BattleVerse // Consumer &amp; Research Platform</p>
      <StatusPill status={entry.development_status} />
    </div>
    <h1 class="page-title">BattleVerse Arena</h1>
    <p class="arena-tagline">Canonical evidence, explicit physics, and transparent uncertainty.</p>
    <p class="page-description">
      Built for anime and manga enthusiasts, powerscaling communities, YouTube creators, fictional-universe researchers, and structured debate communities who want reproducible methodology instead of forum consensus.
    </p>
    <div class="head-actions">
      <a href="/contact/?track=developer-preview" class="btn btn-primary">Express Preview Interest <span aria-hidden="true">→</span></a>
      <a href="/products/battleverse/creator-studio/" class="btn btn-outline">Explore Creator Studio</a>
      <a href="/models/cinnabar/oracle/" class="btn btn-ghost">Cinnabar Oracle Lineages</a>
    </div>
  </header>

  <section class="page-section page-section--surface" aria-labelledby="arena-demo-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Interactive Methodology Demonstration</p>
        <h2 id="arena-demo-heading">Inspect how Arena structures evidence vs. probability.</h2>
        <p>No simulation output becomes canonical simply because BattleVerse generated it. Every scenario isolates pinned source evidence, mathematical assumptions, and parameter sensitivity.</p>
      </div>
    </div>

    <BattleVerseArenaDemo />
  </section>

  <section class="page-section" aria-labelledby="arena-cap-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Planned Platform Capabilities</p>
        <h2 id="arena-cap-heading">Designed for rigorous matchup research and shareable analysis.</h2>
      </div>
    </div>

    <ul class="cap-grid">
      {arenaCapabilities.map((item, idx) => (
        <li class="fds-panel cap-item">
          <span class="cap-idx">0{idx + 1}</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <div class="audience-strip">
      <h3>Target Audiences</h3>
      <div class="audience-chips">
        {arenaAudiences.map((aud) => (
          <span class="audience-chip">{aud}</span>
        ))}
      </div>
    </div>

    <div class="fds-callout">
      <strong>Availability &amp; Scope Boundary:</strong> BattleVerse Arena is in active development with no public download, live web simulation engine, or commercial subscription checkout active today. Register preview interest via <a href="/contact/?track=developer-preview">Contact FDS</a>.
    </div>
  </section>
</BaseLayout>

<style>
  .arena-head { max-width: 58rem; }
  .meta-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-bottom: 0.75rem; }
  .meta-bar .page-eyebrow { margin: 0; }
  .arena-tagline { margin: 0.45rem 0 0; color: #60a5fa; font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; }
  .head-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }
  .cap-item { display: flex; align-items: baseline; gap: 0.8rem; padding: 1.05rem 1.2rem; color: var(--color-text-muted); font-size: 0.93rem; line-height: 1.55; }
  .cap-idx { color: #60a5fa; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; flex-shrink: 0; }

  .audience-strip { margin-bottom: 1.6rem; }
  .audience-strip h3 { margin: 0 0 0.75rem; font-size: 1rem; color: var(--color-text); }
  .audience-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .audience-chip {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-xs);
    background: var(--color-bg-secondary);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  @media (max-width: 780px) {
    .cap-grid { grid-template-columns: 1fr; }
  }
</style>
