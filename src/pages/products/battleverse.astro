---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusPill from '../../components/StatusPill.astro';
import SpecimenMedia from '../../components/SpecimenMedia.astro';
import { getRegistryEntry, flagshipAppsData } from '../../data/registry';

const entry = getRegistryEntry('battleverse');
const bvData = flagshipAppsData.find((p) => p.id === 'battleverse')!;

const simFields = [
  { field: 'Model / Engine Version', example: 'Explicit engine build & optional Cinnabar Oracle lineage version (e.g., pending public release)' },
  { field: 'Scenario Definition', example: 'Original FDS test silhouettes (Unit Alpha vs. Unit Beta), bounded arena geometry, starting separation & ruleset' },
  { field: 'Experimental Conditions', example: 'Canonical continuity version pinned; non-canon outliers excluded with logged audit notes' },
  { field: 'Evidence Limitations', example: 'Explicitly lists ambiguous feats, missing mass/timeframe values, and interpretative assumptions' },
  { field: 'Statistical Uncertainty', example: 'Reports win-probability envelope and parameter sensitivity instead of a single binary absolute verdict' },
];
---

<BaseLayout
  title="Forge BattleVerse — Fictional Intelligence & Simulation"
  description="Forge BattleVerse is Forger Digital Solutions' standalone fictional intelligence, canonical version-tracking, evidence auditing, and combat-simulation platform."
  accent="battleverse"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/products/">Products</a><span aria-hidden="true">/</span>
    <span aria-current="page">Forge BattleVerse</span>
  </nav>

  <header class="bv-hero" data-accent="battleverse">
    <div class="bv-hero__copy">
      <div class="meta-bar">
        <span class="page-eyebrow">FDS Applications · Fictional Intelligence</span>
        <StatusPill status={entry.development_status} />
      </div>
      <h1 class="page-title">Forge BattleVerse</h1>
      <p class="bv-tagline">Beyond opinion. Built on evidence.</p>
      <p class="page-description">
        An independent fictional intelligence, scientific simulation, canonical research, and claim-audited combat-analysis platform replacing internet consensus arguments with reproducible methodology and explicit uncertainty.
      </p>
      <div class="fds-callout">
        <strong>Relationship to Cinnabar Oracle:</strong> {bvData.relationshipToCinnabar}
      </div>
    </div>
    <div class="bv-hero__visual">
      <SpecimenMedia
        src={bvData.image!}
        mobileSrc={bvData.imageSm}
        alt={bvData.imageAlt!}
        label={bvData.imageLabel!}
        eager
      />
    </div>
  </header>

  <section class="page-section" aria-labelledby="bv-method-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Scientific Methodology</p>
        <h2 id="bv-method-heading">Four analytical disciplines behind every simulation.</h2>
      </div>
      <a href="/trust/" class="text-link">Trust &amp; Scientific Integrity <span aria-hidden="true">→</span></a>
    </div>

    <div class="pillar-grid">
      {bvData.pillars?.map((pillar, idx) => (
        <article class="pillar-cell">
          <span class="pillar-idx">0{idx + 1}</span>
          <h3>{pillar.title}</h3>
          <p>{pillar.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section page-section--surface" aria-labelledby="bv-protocol-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Reproducible Reporting Schema</p>
        <h2 id="bv-protocol-heading">Every published simulation must disclose its assumptions.</h2>
        <p>
          BattleVerse never markets fictional simulation outputs as objective canonical facts and never claims universal scientific certification where independent certification is absent.
        </p>
      </div>
    </div>

    <div class="fds-table-wrap">
      <table class="fds-table">
        <thead>
          <tr>
            <th scope="col">Required Result Field</th>
            <th scope="col">Audit Requirement</th>
          </tr>
        </thead>
        <tbody>
          {simFields.map((row) => (
            <tr>
              <th scope="row">{row.field}</th>
              <td>{row.example}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .bv-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 2.25rem;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4rem) 0 3rem;
  }
  .meta-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-bottom: 0.75rem; }
  .meta-bar .page-eyebrow { margin: 0; }
  .bv-tagline { margin: 0.45rem 0 0; color: #60a5fa; font-family: var(--font-display); font-size: 1.28rem; font-weight: 500; }
  .bv-hero .fds-callout { margin-top: 1.4rem; }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-border);
    overflow: hidden;
  }
  .pillar-cell { padding: 1.5rem; background: var(--color-bg-secondary); }
  .pillar-idx { color: #60a5fa; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; }
  .pillar-cell h3 { margin: 0.45rem 0 0.4rem; font-size: 1.08rem; }
  .pillar-cell p { margin: 0; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.62; }

  @media (max-width: 900px) {
    .bv-hero, .pillar-grid { grid-template-columns: 1fr; }
  }
</style>
