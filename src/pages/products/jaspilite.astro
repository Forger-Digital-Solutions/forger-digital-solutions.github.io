---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusPill from '../../components/StatusPill.astro';
import JaspiliteWorkbench from '../../components/JaspiliteWorkbench.astro';
import { getRegistryEntry, flagshipAppsData } from '../../data/registry';

const entry = getRegistryEntry('jaspilite');
const jaspData = flagshipAppsData.find((p) => p.id === 'jaspilite')!;

const capabilities = [
  { title: 'Project-Aware Sessions', detail: 'Keeps repository files, diffs, test outputs, and session history anchored to the codebase rather than disconnected chat windows.' },
  { title: 'Autonomous Planning & Verification', detail: 'Structured lifecycle spanning task planning, bounded code edits, debugging, automated testing, and developer review.' },
  { title: 'Multi-Agent Collaboration', detail: 'Coordinates specialist roles concurrently in Meld mode while preserving file-ownership boundaries and conflict inspection.' },
  { title: 'Unified Local & Connected Routing', detail: 'Designed to route between locally hosted open-weight models and user-provided model subscriptions under explicit governance rules.' },
];
---

<BaseLayout
  title="Jaspilite — Autonomous AI Development Platform"
  description="Jaspilite is Forger Digital Solutions' autonomous software development and multi-agent orchestration workspace featuring Auto, Meld, and Solo operating modes."
  accent="jaspilite"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/products/">Products</a><span aria-hidden="true">/</span>
    <span aria-current="page">Jaspilite</span>
  </nav>

  <header class="jasp-hero" data-accent="jaspilite">
    <div class="jasp-hero__copy">
      <div class="meta-bar">
        <span class="page-eyebrow">FDS Applications · Autonomous Software Engineering</span>
        <StatusPill status={entry.development_status} />
      </div>
      <h1 class="page-title">Jaspilite</h1>
      <p class="jasp-tagline">Your intelligence. One development workspace.</p>
      <p class="page-description">
        An autonomous AI development and multi-agent orchestration platform engineered for real repository work — planning, coding, debugging, testing, and model routing inside one black-and-crimson governed developer workspace.
      </p>
      <div class="fds-callout">
        <strong>Availability &amp; Build Honesty:</strong> Jaspilite is in active platform development. Private unsigned desktop builds remain unpublished until installer verification and signing policies are cleared by the owner. No fabricated UI screenshots are used on this page.
      </div>
    </div>
  </header>

  <section class="page-section page-section--tight" aria-labelledby="modes-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Operating Modes</p>
        <h2 id="modes-heading">Three explicit modes: Auto, Meld, and Solo.</h2>
        <p>Select a mode below to inspect how Jaspilite structures model routing, concurrency, and human governance.</p>
      </div>
    </div>

    <JaspiliteWorkbench />
  </section>

  <section class="page-section page-section--surface" aria-labelledby="jasp-cap-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Core Capabilities</p>
        <h2 id="jasp-cap-heading">Built for governed repository execution.</h2>
      </div>
    </div>

    <div class="cap-grid">
      {capabilities.map((cap, idx) => (
        <article class="cap-cell">
          <span class="cap-idx">0{idx + 1}</span>
          <h3>{cap.title}</h3>
          <p>{cap.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section" aria-labelledby="providers-heading">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Provider Integration Boundaries</p>
        <h2 id="providers-heading">Clear distinction between local models, subscriptions, and planned routes.</h2>
        <p>
          Jaspilite never promises unlimited third-party subscription usage and never implies official commercial partnerships with external model providers unless legally established.
        </p>
      </div>
    </div>

    <div class="fds-table-wrap">
      <table class="fds-table">
        <thead>
          <tr>
            <th scope="col">Integration Category</th>
            <th scope="col">Public Verification Tier</th>
            <th scope="col">Governance &amp; User Responsibility</th>
          </tr>
        </thead>
        <tbody>
          {jaspData.providerTiers?.map((tier) => (
            <tr>
              <th scope="row">{tier.tier}</th>
              <td><strong>{tier.status}</strong></td>
              <td>{tier.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <aside class="migration-box">
      <h3>Migration from Forge Control</h3>
      <p>
        {jaspData.legacyMigrationNote} Developers looking for earlier public software records can also review <a href="/projects/codeforge">CodeForge</a> (v0.2.0, installer downloads currently paused; verified source ZIP archive on <a href="/forged">/forged</a>).
      </p>
    </aside>
  </section>
</BaseLayout>

<style>
  .jasp-hero { max-width: 56rem; padding: clamp(2.5rem, 5vw, 4rem) 0 2rem; }
  .meta-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-bottom: 0.75rem; }
  .meta-bar .page-eyebrow { margin: 0; }
  .jasp-tagline { margin: 0.45rem 0 0; color: #f87171; font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; }
  .jasp-hero .fds-callout { margin-top: 1.4rem; }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-border);
    overflow: hidden;
  }
  .cap-cell { padding: 1.45rem; background: var(--color-bg); }
  .cap-idx { color: #f87171; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; }
  .cap-cell h3 { margin: 0.45rem 0 0.35rem; font-size: 1.08rem; }
  .cap-cell p { margin: 0; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.62; }

  .migration-box {
    margin-top: 1.75rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
  }
  .migration-box h3 { margin: 0 0 0.4rem; font-size: 1rem; }
  .migration-box p { margin: 0; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.62; }

  @media (max-width: 760px) { .cap-grid { grid-template-columns: 1fr; } }
</style>
