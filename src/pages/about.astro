---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout
  title="About"
  description="Forger Digital Solutions is an independent software research and development studio founded by Edward Schmidt, based in New Jersey, United States."
>
  <div class="about-wrap">
    <h1 class="page-title">About</h1>

    <p class="about-lead">
      Forger Digital Solutions is an independent software research and development studio
      focused on intelligent systems, developer tooling, creative technology, training
      infrastructure, and experimental computing.
    </p>

    <p class="about-body">
      FDS projects often begin as experiments and evolve through repeated implementation,
      measurement, testing, and refinement. Work progresses through the same loop regardless
      of domain &mdash; build, test, measure, learn, evolve &mdash; so that what survives into reusable
      architecture has already earned its place in real use.
    </p>

    <div class="founder">
      {siteConfig.authorImage
        ? <img class="founder__photo" src={siteConfig.authorImage} alt={`${siteConfig.author}, founder of Forger Digital Solutions`} width="112" height="112" loading="lazy" />
        : <div class="founder__photo founder__photo--monogram" aria-hidden="true">ES</div>}
      <div class="founder__meta">
        <p class="founder__name">{siteConfig.author}</p>
        <p class="founder__role">Founder &amp; Developer</p>
        <a class="founder__link" href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">&#8599;</span></a>
      </div>
    </div>

    <dl class="about-details">
      <div class="about-detail">
        <dt>Founded by</dt>
        <dd>{siteConfig.author}</dd>
      </div>
      <div class="about-detail">
        <dt>Location</dt>
        <dd>New Jersey, United States</dd>
      </div>
      <div class="about-detail">
        <dt>Contact</dt>
        <dd><a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a></dd>
      </div>
      <div class="about-detail">
        <dt>Community</dt>
        <dd>
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <span aria-hidden="true"> · </span>
          <a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a>
          <span aria-hidden="true"> · </span>
          <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
          <span aria-hidden="true"> · </span>
          <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </dd>
      </div>
    </dl>

    <section class="about-approach" aria-labelledby="approach-heading">
      <h2 id="approach-heading">Our approach</h2>
      <ul>
        <li>Build through experimentation</li>
        <li>Measure what matters</li>
        <li>Govern intelligence responsibly</li>
        <li>Evolve continuously</li>
      </ul>
    </section>

    <section class="about-support" aria-labelledby="support-heading">
      <h2 id="support-heading">Support the work</h2>
      <p>
        Support independent FDS research and development.
      </p>
      <a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Support FDS</a>
    </section>
  </div>
</BaseLayout>

<style>
  .about-wrap {
    max-width: 720px;
    padding: 3rem 0 4rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .about-lead {
    font-size: 1.15rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .about-body {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .founder {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .founder__photo {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border-strong);
    flex-shrink: 0;
  }

  .founder__photo--monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(140deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 35%, var(--color-surface)));
    color: #f5f7fa;
    font: 800 2rem/1 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .founder__name {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .founder__role {
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .founder__link {
    display: inline-block;
    margin-top: 0.6rem;
    font: 700 0.78rem/1 var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 480px) {
    .founder {
      flex-direction: column;
      text-align: center;
    }
  }

  .about-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-bottom: 3rem;
  }

  .about-detail dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .about-detail dd {
    margin: 0.15rem 0 0;
    color: var(--color-text);
  }

  .about-approach h2,
  .about-support h2 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .about-approach ul {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .about-approach li {
    padding: 0.5rem 0;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .about-approach li::before {
    content: '\2192 ';
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .about-support p {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }
</style>