---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectTechnologies, technologyCategories } from '../data/technology';
---
<BaseLayout title="Technology" description="How languages, runtimes, engines, model tooling, and compute environments map to current Forger Digital Solutions projects.">
  <header class="page-head">
    <p class="eyebrow">FDS // TECHNICAL FOUNDATIONS</p>
    <h1 class="page-title">Technology in context</h1>
    <p class="page-description">A stack matters because of what it enables. This map connects the major FDS systems to the languages, runtimes, engines, and technical areas actually used in their current repositories.</p>
  </header>

  <section class="project-tech" aria-labelledby="project-tech-title">
    <h2 id="project-tech-title">Where the technology is used</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>System</th><th>Technologies / areas</th><th>Why they are there</th></tr></thead>
        <tbody>
          {projectTechnologies.map((item) => (
            <tr>
              <th scope="row">{item.href ? <a href={item.href}>{item.system}</a> : item.system}</th>
              <td>{item.areas}</td><td>{item.purpose}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="broader" aria-labelledby="broader-title">
    <h2 id="broader-title">Broader technical landscape</h2>
    <div class="tech-grid">
      {technologyCategories.map((category) => (
        <article class="tech-category">
          <h3>{category.name}</h3>
          {category.description && <p>{category.description}</p>}
          <ul>{category.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <p class="tech-disclaimer">Product and platform names belong to their respective owners. A name here indicates use or investigation—not endorsement, sponsorship, certification, or partnership. Planned integrations are not treated as current support.</p>
</BaseLayout>

<style>
  .page-head { max-width: 52rem; padding: 3.5rem 0 2.5rem; }.eyebrow { margin: 0 0 .75rem; color: var(--color-accent-bright); font: 700 .68rem/1 var(--font-mono); letter-spacing: .15em; }.page-title { margin: 0; font-size: clamp(2.4rem, 6vw, 4.2rem); letter-spacing: -.05em; }.page-description { margin: 1rem 0 0; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.75; }
  .project-tech, .broader { margin-bottom: 3.5rem; }.project-tech h2, .broader h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 3vw, 2rem); }.table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: rgba(7,12,20,.92); }table { width: 100%; min-width: 48rem; border-collapse: collapse; }th, td { padding: 1rem; border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: top; line-height: 1.55; }thead th { color: var(--color-accent-bright); font: 700 .68rem/1.3 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }tbody th { width: 15%; color: var(--color-text); }tbody td { color: var(--color-text-muted); font-size: .9rem; }tbody tr:last-child > * { border-bottom: 0; }
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(15rem,1fr)); gap: 1rem; }.tech-category { padding: 1.35rem; border: 1px solid var(--color-border); border-top: 3px solid var(--color-accent); border-radius: var(--radius-md); background: linear-gradient(145deg,rgba(13,20,32,.96),rgba(7,12,20,.96)); }.tech-category h3 { margin: 0; font-size: 1.1rem; }.tech-category p { color: var(--color-text-muted); font-size: .84rem; line-height: 1.55; }.tech-category ul { margin: 1rem 0 0; padding: 0; list-style: none; }.tech-category li { padding: .45rem 0; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .86rem; }.tech-disclaimer { max-width: 54rem; margin: 0 0 5rem; color: var(--color-text-subtle); font-size: .8rem; line-height: 1.65; }
  @media(max-width:520px){ .page-head{padding-top:2.5rem}.table-wrap{margin-inline:-.25rem}.tech-grid{grid-template-columns:1fr} }
</style>
