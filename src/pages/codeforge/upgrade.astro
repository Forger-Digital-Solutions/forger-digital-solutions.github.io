---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { codeForgePlans } from '../../data/codeforge-plans';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="CodeForge Plans"
  description="CodeForge Free is available now. Expanded commercial plans are in development; pricing and tiers are not published yet."
  noindex={true}
>
  <div class="upgrade-page">
    <section class="page-section" aria-labelledby="upgrade-title">
      <SectionHeader
        eyebrow="CodeForge // Plans"
        title="CodeForge Plans & Availability"
        description="CodeForge Free is available now. Expanded commercial plans are in development — final tier names, prices, limits, and billing terms will be published only when approved."
        align="center"
        headingLevel="h1"
      />

      <div class="architecture-notice">
        <div class="architecture-notice__tag">Zero-Cost Guarantee</div>
        <p class="architecture-notice__text">
          <strong>ForgeZero Assurance:</strong> CodeForge Free is engineered to operate at zero cost. It never
          routes to paid inference, never runs local LLMs, and refuses unverified or unknown-cost routes instead of
          falling back silently. Upgrading is purely optional and is not required to use the public release.
        </p>
      </div>

      <div class="plans-grid plans-grid--two">
        {codeForgePlans.map((plan) => (
          <article class={`plan-card ${plan.highlight ? 'plan-card--highlighted' : ''}`} id={`plan-${plan.id}`}>
            <header class="plan-card__header">
              {plan.badge && <span class="plan-card__badge">{plan.badge}</span>}
              <h2 class="plan-card__name">{plan.name}</h2>
              <p class="plan-card__tagline">{plan.tagline}</p>
            </header>

            <div class="plan-card__pricing">
              <span class="plan-card__price">{plan.displayPrice}</span>
              <span class="plan-card__period">/ {plan.period}</span>
            </div>

            <p class="plan-card__audience">{plan.targetAudience}</p>

            <ul class="plan-card__features" aria-label={`${plan.name} details`}>
              {plan.features.map((feature) => (
                <li class="plan-card__feature">
                  <span class="plan-card__check" aria-hidden="true">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <footer class="plan-card__footer">
              {plan.ctaAction === 'download' && plan.ctaHref ? (
                <a href={plan.ctaHref} class="btn btn-primary plan-card__btn">
                  {plan.ctaText} <span aria-hidden="true">↓</span>
                </a>
              ) : (
                <button
                  type="button"
                  class="btn btn-outline plan-card__btn plan-preview-trigger"
                  data-plan-id={plan.id}
                  data-plan-name={plan.name}
                  aria-haspopup="dialog"
                >
                  {plan.ctaText}
                </button>
              )}
            </footer>
          </article>
        ))}
      </div>

      <!-- In-development notice dialog (no checkout exists; this is informational only) -->
      <dialog id="preview-dialog" class="preview-dialog" aria-labelledby="dialog-title">
        <form method="dialog" class="preview-dialog__form">
          <div class="preview-dialog__header">
            <span class="preview-dialog__status">Availability Notice</span>
            <button type="submit" class="preview-dialog__close" aria-label="Close dialog">✕</button>
          </div>
          <h3 id="dialog-title" class="preview-dialog__title">Expanded plans are in development</h3>
          <p class="preview-dialog__body">
            Commercial tiers for <strong id="selected-plan-name">CodeForge</strong> are not finalized. FDS has not
            published plan names, prices, limits, resets, model allocations, or billing terms, and no checkout or
            payment is accepted on this site.
          </p>
          <p class="preview-dialog__body">
            Questions and feedback are welcome while the commercial architecture is being designed.
          </p>
          <div class="preview-dialog__actions">
            <a
              id="commercial-inquiry-link"
              href={`mailto:${siteConfig.supportEmail}?subject=CodeForge%20Commercial%20Inquiry`}
              class="btn btn-primary"
            >
              Inquire via Email <span aria-hidden="true">→</span>
            </a>
            <button type="submit" class="btn btn-outline">Close</button>
          </div>
        </form>
      </dialog>

      <section class="commercial-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="commercial-faq__heading">Commercial Availability FAQ</h2>
        <div class="faq-list">
          <div class="faq-item">
            <h3 class="faq-item__q">Can I buy a paid CodeForge plan today?</h3>
            <p class="faq-item__a">
              No. Expanded commercial plans are in development, and no checkout, subscription, or payment is active
              anywhere on this site. Final tier structure will be announced only when approved.
            </p>
          </div>
          <div class="faq-item">
            <h3 class="faq-item__q">What will expanded plans change?</h3>
            <p class="faq-item__a">
              They may expand model access, GEMS-powered intelligence where it matures, usage limits, task and
              runtime allowances, concurrency, advanced engineering features, and premium provider access. Specifics
              are intentionally unpublished until finalized.
            </p>
          </div>
          <div class="faq-item">
            <h3 class="faq-item__q">Where can I get CodeForge now?</h3>
            <p class="faq-item__a">
              CodeForge Free v0.2.0 is available on the <a href="/forged">Releases</a> page and via
              <a href="https://github.com/Forger-Digital-Solutions/CodeForge/releases/latest" target="_blank" rel="noopener noreferrer">GitHub Releases</a>,
              with SHA-256 checksums published alongside each build.
            </p>
          </div>
        </div>
      </section>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('preview-dialog');
    const selectedPlanSpan = document.getElementById('selected-plan-name');
    const inquiryLink = document.getElementById('commercial-inquiry-link');
    const triggers = document.querySelectorAll('.plan-preview-trigger');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const planName = trigger.getAttribute('data-plan-name') || 'CodeForge';
        if (selectedPlanSpan) selectedPlanSpan.textContent = planName;
        if (inquiryLink) {
          inquiryLink.href = `${inquiryLink.getAttribute('href')?.split('?')[0]}?subject=${encodeURIComponent(
            'CodeForge Inquiry: ' + planName
          )}`;
        }
        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      });
    });

    if (dialog) {
      const getFocusableElements = () =>
        Array.from(
          dialog.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter((element) => !element.hasAttribute('hidden') && element.getClientRects().length > 0);

      document.addEventListener('keydown', (event) => {
        if (!dialog.open || event.key !== 'Tab') return;

        const focusable = getFocusableElements();
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (!dialog.contains(document.activeElement)) {
          event.preventDefault();
          first.focus();
        } else if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      dialog.addEventListener('click', (event) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (!isInDialog) {
          dialog.close();
        }
      });
    }
  });
</script>

<style>
  .upgrade-page {
    max-width: 72rem;
    margin: 0 auto;
  }

  .architecture-notice {
    margin: 1.5rem 0 2.5rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid rgba(49,116,255,.25);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: rgba(13,20,32,.7);
  }
  .architecture-notice__tag {
    margin-bottom: .35rem;
    color: var(--color-accent-bright);
    font: 700 .68rem/1 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .architecture-notice__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .92rem;
    line-height: 1.6;
  }

  .plans-grid {
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 3.5rem;
  }
  .plans-grid--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .plan-card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(150deg, rgba(14,22,35,.96), rgba(8,13,22,.96));
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  .plan-card--highlighted {
    border-color: rgba(78,122,222,.5);
    box-shadow: 0 0 30px rgba(49,116,255,.12);
  }
  .plan-card__badge {
    display: inline-block;
    padding: .3rem .6rem;
    margin-bottom: .8rem;
    border-radius: 999px;
    font: 700 .65rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-accent-bright);
    border: 1px solid rgba(78,122,222,.3);
    background: rgba(78,122,222,.1);
  }
  .plan-card__name {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: -.02em;
    color: var(--color-text);
  }
  .plan-card__tagline {
    margin: .4rem 0 1.2rem;
    color: var(--color-text-muted);
    font-size: .88rem;
    line-height: 1.5;
    min-height: 2.6rem;
  }
  .plan-card__pricing {
    display: flex;
    align-items: baseline;
    gap: .4rem;
    padding: .8rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.2rem;
  }
  .plan-card__price {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--color-text);
  }
  .plan-card__period {
    color: var(--color-text-subtle);
    font: 600 .78rem/1 var(--font-mono);
  }
  .plan-card__audience {
    margin: 0 0 1.2rem;
    font-size: .85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .plan-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    flex-grow: 1;
  }
  .plan-card__feature {
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    font-size: .88rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  .plan-card__check {
    color: var(--color-accent-bright);
    font-weight: 700;
  }
  .plan-card__footer {
    margin-top: auto;
  }
  .plan-card__btn {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .preview-dialog {
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: #0d1420;
    color: var(--color-text);
    box-shadow: 0 20px 50px rgba(0,0,0,.75);
    max-width: 32rem;
    margin: auto;
  }
  .preview-dialog::backdrop {
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(4px);
  }
  .preview-dialog__form {
    padding: 1.8rem;
  }
  .preview-dialog__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .preview-dialog__status {
    color: var(--color-accent-bright);
    font: 700 .68rem/1 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .preview-dialog__close {
    background: none;
    border: none;
    color: var(--color-text-subtle);
    font-size: 1.2rem;
    cursor: pointer;
    padding: .2rem .4rem;
  }
  .preview-dialog__close:hover {
    color: var(--color-text);
  }
  .preview-dialog__title {
    margin: 0 0 .8rem;
    font-size: 1.3rem;
  }
  .preview-dialog__body {
    margin: 0 0 .8rem;
    color: var(--color-text-muted);
    font-size: .92rem;
    line-height: 1.6;
  }
  .preview-dialog__actions {
    display: flex;
    gap: .8rem;
    margin-top: 1.5rem;
    justify-content: flex-end;
  }

  .commercial-faq {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .commercial-faq__heading {
    margin: 0 0 1.5rem;
    font-size: 1.35rem;
    letter-spacing: -.02em;
  }
  .faq-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  .faq-item {
    padding: 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgba(13,20,32,.5);
  }
  .faq-item__q {
    margin: 0 0 .5rem;
    font-size: 1rem;
    color: var(--color-text);
  }
  .faq-item__a {
    margin: 0;
    font-size: .88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .plans-grid--two {
      grid-template-columns: 1fr;
    }
  }
</style>
