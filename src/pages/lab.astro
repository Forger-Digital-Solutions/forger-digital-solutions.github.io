---
import BaseLayout from '../layouts/BaseLayout.astro';
import { labPrinciples } from '../data/lab';
import ProcessVisualization from '../components/ProcessVisualization.astro';
import SectionHeader from '../components/SectionHeader.astro';
---
<BaseLayout title="Lab" description="FDS engineering principles and process: evidence over assumptions, adaptive computation, governed intelligence, and building through experimentation.">
  <section class="lab-hero"><p>FDS Lab</p><h1>Build through experimentation.</h1><span></span><div>FDS projects are developed through iterative experimentation. Systems are built, tested, measured, challenged, and refined before ideas become reusable architecture.</div></section>
  <section class="principles"><SectionHeader eyebrow="Engineering Philosophy" title="How FDS approaches the work" /><div class="principles-grid">{labPrinciples.map((principle) => <article><span>{principle.number}</span><h2>{principle.title}</h2><p>{principle.description}</p></article>)}</div></section>
  <section class="lab-flow" aria-labelledby="lab-flow"><SectionHeader eyebrow="Decision Loop" title="Question to iteration" description="Execution is not the same as success. Results matter." align="center" /><ol id="lab-flow"><li>Question</li><li>Experiment</li><li>Evidence</li><li>Decision</li><li>Iteration</li></ol></section>
  <section class="process-block" aria-label="FDS development process"><h2>The broader development loop</h2><ProcessVisualization /><p>These principles describe FDS engineering philosophy, not universal scientific law or a certification claim.</p></section>
</BaseLayout>
<style>
  .lab-hero { position: relative; max-width: 52rem; padding: var(--space-7) 0; }.lab-hero::after { position: absolute; top: 15%; right: -34%; width: 22rem; aspect-ratio: 1; border: 1px solid rgba(91,150,255,.18); border-radius: 50%; box-shadow: 0 0 0 3rem rgba(66,124,244,.025), 0 0 65px rgba(30,91,228,.1); content: ''; }.lab-hero > p { color: var(--color-accent-bright); font: 700 .7rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.lab-hero h1 { margin-top: 1rem; font-size: clamp(2.7rem, 6vw, 5rem); line-height: .95; letter-spacing: -.06em; }.lab-hero > span { display: block; width: 5rem; height: 2px; margin: 1.8rem 0; background: linear-gradient(90deg, var(--color-accent), transparent); box-shadow: 0 0 12px rgba(65,132,255,.4); }.lab-hero > div { color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.75; }.principles { padding-bottom: var(--space-7); }.principles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }.principles-grid article { position: relative; min-height: 13rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: linear-gradient(145deg, rgba(13,20,32,.96), rgba(7,12,20,.96)); box-shadow: var(--shadow-sm), inset 0 1px rgba(255,255,255,.03); }.principles-grid article::after { position: absolute; right: 1rem; bottom: 1rem; width: 1.2rem; height: 1.2rem; border-right: 1px solid var(--color-border-blue); border-bottom: 1px solid var(--color-border-blue); content: ''; }.principles-grid span { color: var(--color-accent-bright); font: 700 .72rem/1 var(--font-mono); }.principles-grid h2 { margin: 2.1rem 0 .6rem; font-size: 1.23rem; }.principles-grid p { color: var(--color-text-muted); }.lab-flow { width: 100vw; margin-left: calc(50% - 50vw); padding: var(--space-7) max(1.25rem, calc((100vw - var(--content-width)) / 2)); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: linear-gradient(180deg, rgba(11,18,30,.78), rgba(6,11,19,.72)); }.lab-flow ol { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 2rem 0 0; padding: 0; list-style: none; }.lab-flow li { display: flex; flex: 1; align-items: center; gap: 1rem; color: var(--color-text); font: 700 .75rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }.lab-flow li:not(:last-child)::after { flex: 1; height: 1px; background: var(--color-accent-secondary); content: '→'; color: var(--color-accent-secondary); text-align: right; }.process-block { padding: var(--space-7) 0; text-align: center; }.process-block h2 { margin-bottom: 2rem; font-size: 1.7rem; }.process-block > p { max-width: 35rem; margin: 2rem auto 0; color: var(--color-text-subtle); font-size: .82rem; }
  @media (max-width: 650px) { .principles-grid { grid-template-columns: 1fr; }.lab-flow ol { display: grid; grid-template-columns: 1fr 1fr; }.lab-flow li:not(:last-child)::after { display: none; } }
</style>
