---
import BaseLayout from '../layouts/BaseLayout.astro';
import { labPrinciples } from '../data/lab';
import SectionHeader from '../components/SectionHeader.astro';

// The decision loop is how FDS establishes what is true; the development loop
// (Idea → Evolve) is the same discipline applied to daily execution. The two
// are related but not interchangeable, so the page presents one primary and
// one subordinate instead of two competing numbered-box diagrams.
const decisionStages = [
  { name: 'Question', desc: 'Work begins from a specific, testable objective — not activity for its own sake.' },
  { name: 'Experiment', desc: 'A bounded experiment is designed with controlled inputs and a defined success condition.' },
  { name: 'Evidence', desc: 'Results are measured against that condition. Execution alone is not evidence.' },
  { name: 'Decision', desc: 'The finding is accepted, revised, or rejected based on what the evidence supports.' },
  { name: 'Iteration', desc: 'Accepted findings are refined and challenged again before they become reusable architecture.' }
];
const executionSteps = ['Idea', 'Build', 'Test', 'Measure', 'Learn', 'Evolve'];
---
<BaseLayout title="Lab" description="FDS engineering principles and process: evidence over assumptions, adaptive computation, governed intelligence, and building through experimentation.">
  <section class="lab-hero"><p>FDS Lab</p><h1>Build through experimentation.</h1><span></span><div>FDS projects are developed through iterative experimentation. Systems are built, tested, measured, challenged, and refined before ideas become reusable architecture.</div></section>
  <section class="principles"><SectionHeader eyebrow="Engineering Philosophy" title="How FDS approaches the work" /><div class="principles-grid">{labPrinciples.map((principle) => <article><span>{principle.number}</span><h2>{principle.title}</h2><p>{principle.description}</p></article>)}</div></section>
  <section class="lab-flow" aria-labelledby="lab-flow"><SectionHeader eyebrow="Decision Loop" title="Question to iteration" description="Execution is not the same as success. Results matter. This loop is how the lab establishes what is true." align="center" /><ol id="lab-flow" class="decision-loop">{decisionStages.map((stage) => (<li class="decision-stage"><span class="decision-stage__node" aria-hidden="true"></span><div><p class="decision-stage__name">{stage.name}</p><p class="decision-stage__desc">{stage.desc}</p></div></li>))}</ol></section>
  <section class="process-block" aria-label="FDS development process"><p class="process-block__lead">The development loop applies the same discipline to daily work</p><p class="process-block__steps">{executionSteps.map((step, i) => (<span class="process-block__step">{step}{i < executionSteps.length - 1 && <span class="process-block__arrow" aria-hidden="true">→</span>}</span>))}</p><p class="process-block__note">The decision loop determines what the evidence supports; the development loop turns what survives into better systems. These principles describe FDS engineering philosophy, not universal scientific law or a certification claim.</p></section>
</BaseLayout>
<style>
  .lab-hero { position: relative; max-width: 52rem; padding: var(--space-7) 0; }.lab-hero::after { position: absolute; top: 15%; right: -34%; width: 22rem; aspect-ratio: 1; border: 1px solid rgba(91,150,255,.18); border-radius: 50%; box-shadow: 0 0 0 3rem rgba(66,124,244,.025), 0 0 65px rgba(30,91,228,.1); content: ''; }.lab-hero > p { color: var(--color-accent-bright); font: 700 .7rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.lab-hero h1 { margin-top: 1rem; font-size: clamp(2.7rem, 6vw, 5rem); line-height: .95; letter-spacing: -.06em; }.lab-hero > span { display: block; width: 5rem; height: 2px; margin: 1.8rem 0; background: linear-gradient(90deg, var(--color-accent), transparent); box-shadow: 0 0 12px rgba(65,132,255,.4); }.lab-hero > div { color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.75; }.principles { padding-bottom: var(--space-7); }.principles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }.principles-grid article { position: relative; min-height: 13rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: linear-gradient(145deg, rgba(13,20,32,.96), rgba(7,12,20,.96)); box-shadow: var(--shadow-sm), inset 0 1px rgba(255,255,255,.03); }.principles-grid article::after { position: absolute; right: 1rem; bottom: 1rem; width: 1.2rem; height: 1.2rem; border-right: 1px solid var(--color-border-blue); border-bottom: 1px solid var(--color-border-blue); content: ''; }.principles-grid span { color: var(--color-accent-bright); font: 700 .72rem/1 var(--font-mono); }.principles-grid h2 { margin: 2.1rem 0 .6rem; font-size: 1.23rem; }.principles-grid p { color: var(--color-text-muted); }.lab-flow { width: 100vw; margin-left: calc(50% - 50vw); padding: var(--space-7) max(1.25rem, calc((100vw - var(--content-width)) / 2)); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: linear-gradient(180deg, rgba(11,18,30,.78), rgba(6,11,19,.72)); } /* One connected rail, not five boxes. */ .decision-loop { position: relative; max-width: 42rem; margin: 2.4rem auto 0; padding: 0 0 0 2.4rem; display: grid; gap: 1.6rem; list-style: none; } .decision-loop::before { position: absolute; top: .4rem; bottom: .4rem; left: .39rem; width: 1px; background: linear-gradient(180deg, var(--color-accent-secondary), color-mix(in srgb, var(--color-accent-secondary) 25%, transparent)); content: ''; } .decision-stage { position: relative; display: grid; gap: .2rem; text-align: left; } .decision-stage__node { position: absolute; top: .3rem; left: -2.4rem; width: .85rem; height: .85rem; border: 2px solid var(--color-accent-secondary); border-radius: 50%; background: var(--color-bg); } .decision-stage__name { margin: 0; color: var(--color-text); font: 700 .82rem/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; } .decision-stage__desc { margin: .35rem 0 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.65; }.process-block { padding: var(--space-7) 0; text-align: center; }.process-block__lead { margin: 0 0 1rem; color: var(--color-text-subtle); font: 700 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.process-block__steps { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .5rem .35rem; }.process-block__step { color: var(--color-text-muted); font: 700 .78rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }.process-block__arrow { margin: 0 .55rem; color: var(--color-accent-secondary); }.process-block__note { max-width: 35rem; margin: 2.2rem auto 0; color: var(--color-text-subtle); font-size: .82rem; }
  @media (max-width: 650px) { .principles-grid { grid-template-columns: 1fr; }.decision-loop { max-width: none; gap: 1.4rem; } }
</style>
