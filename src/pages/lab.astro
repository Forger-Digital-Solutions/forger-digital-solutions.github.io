---
import BaseLayout from '../layouts/BaseLayout.astro';
import { labPrinciples } from '../data/lab';
import { releases } from '../data/kayla/releases';
import SectionHeader from '../components/SectionHeader.astro';

// The decision loop is how FDS establishes what is true; the development loop
// (Idea → Evolve) is the same discipline applied to daily execution. The two
// are related but not interchangeable, so the page presents one primary and
// one subordinate instead of two competing numbered-box diagrams.
const decisionStages = [
  { name: 'Question', desc: 'Work begins from a specific, testable objective — not activity for its own sake.' },
  { name: 'Experiment', desc: 'A bounded experiment is designed with controlled inputs and a defined success condition.' },
  { name: 'Evidence', desc: 'Results are measured against that condition. Execution alone is not evidence.' },
  { name: 'Decision', desc: 'The finding is accepted, revised, or rejected based on what the evidence supports.' },
  { name: 'Iteration', desc: 'Accepted findings are refined and challenged again before they become reusable architecture.' }
];
const executionSteps = ['Idea', 'Build', 'Test', 'Measure', 'Learn', 'Evolve'];

// Publishable engineering evidence, sourced from repository-verifiable facts:
// the canonical release records and the automated validation pipeline of this
// very site. No private benchmarks or unsupported numbers.
const releaseHistory = releases
  .slice()
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .map((release) => ({
    name: release.appId === 'codeforge' ? 'CodeForge' : 'ForgerEMS',
    version: release.version,
    date: release.date,
    state: release.status === 'stable' ? 'Stable release' : 'Public preview',
    href: release.appId === 'codeforge'
      ? 'https://github.com/Forger-Digital-Solutions/CodeForge/releases/tag/v0.2.0'
      : 'https://github.com/Forger-Digital-Solutions/ForgerEMS/releases',
  }));

const evidence = [
  {
    title: 'Automated verification pipeline',
    body: 'Every site change runs a unit-test suite, Astro type checking, content validation, internal-link checks, Kayla golden-question checks, and archive checksum verification before it can be called done.',
  },
  {
    title: 'Accessibility & UI gates',
    body: 'Browser tests with axe-core accessibility scanning, UI contract tests for the homepage and ecosystem, and a signature accessibility check run alongside the unit suite.',
  },
  {
    title: 'Packaged-app validation',
    body: 'CodeForge releases are built and consumer-verified on GitHub-hosted Windows runners, with SHA-256 checksums published alongside every installer and portable build.',
  },
  {
    title: 'Fail-closed reliability engineering',
    body: 'CodeForge\'s ForgeZero boundary refuses paid, local, unknown-cost, and unverified model routes instead of silently falling back; command risk classification and secret scanning run before model context leaves the machine.',
  },
  {
    title: 'Evaluation methodology',
    body: 'Training Grounds separates activity from demonstrated learning: held-out evaluation, checkpoints, learning-versus-memorization checks, and diagnosis-driven remediation govern how GEMS lineages advance.',
  },
  {
    title: 'Efficiency research',
    body: 'ForgeGreen — in active development — reduces measurable computational work upstream of verification and completion authorities without weakening any of them.',
  },
];
---
<BaseLayout title="Engineering" description="FDS engineering: release history, testing discipline, evaluation methodology, and reliability engineering — evidence over assumptions.">
  <section class="lab-hero"><p>FDS Lab // Engineering</p><h1>Build through experimentation.</h1><span></span><div>FDS projects are developed through iterative experimentation. Systems are built, tested, measured, challenged, and refined before ideas become reusable architecture — and the evidence is public wherever it can be.</div></section>

  <section class="evidence" aria-labelledby="evidence-title">
    <SectionHeader eyebrow="Engineering Evidence" title="What the work actually produces" description="Publishable proof from the release record and the automated pipeline — process claims stay tied to verifiable artifacts." />
    <div class="evidence-grid">
      {evidence.map((item) => <article class="evidence-card"><h3>{item.title}</h3><p>{item.body}</p></article>)}
    </div>
  </section>

  <section class="release-evidence" aria-labelledby="release-evidence-title">
    <SectionHeader eyebrow="Public Release History" title="Shipped software" description="The canonical release record. Details, assets, and checksums live on each project's GitHub Releases page." />
    <ul class="release-list" role="list">
      {releaseHistory.map((release) => (
        <li class="release-row">
          <span class="release-row__name">{release.name}</span>
          <span class="release-row__version">{release.version}</span>
          <span class="release-row__state">{release.state}</span>
          <span class="release-row__date"><time datetime={release.date}>{release.date}</time></span>
          <a class="text-link release-row__link" href={release.href} target="_blank" rel="noopener noreferrer">Releases <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="principles"><SectionHeader eyebrow="Engineering Philosophy" title="How FDS approaches the work" /><div class="principles-grid">{labPrinciples.map((principle) => <article><span>{principle.number}</span><h2>{principle.title}</h2><p>{principle.description}</p></article>)}</div></section>
  <section class="lab-flow" aria-labelledby="lab-flow"><SectionHeader eyebrow="Decision Loop" title="Question to iteration" description="Execution is not the same as success. Results matter. This loop is how the lab establishes what is true." align="center" /><ol id="lab-flow" class="decision-loop">{decisionStages.map((stage) => (<li class="decision-stage"><span class="decision-stage__node" aria-hidden="true"></span><div><p class="decision-stage__name">{stage.name}</p><p class="decision-stage__desc">{stage.desc}</p></div></li>))}</ol></section>
  <section class="process-block" aria-label="FDS development process"><p class="process-block__lead">The development loop applies the same discipline to daily work</p><p class="process-block__steps">{executionSteps.map((step, i) => (<span class="process-block__step">{step}{i < executionSteps.length - 1 && <span class="process-block__arrow" aria-hidden="true">→</span>}</span>))}</p><p class="process-block__note">The decision loop determines what the evidence supports; the development loop turns what survives into better systems. These principles describe FDS engineering philosophy, not universal scientific law or a certification claim.</p></section>
</BaseLayout>
<style>
  .lab-hero { position: relative; max-width: 52rem; padding: var(--space-7) 0; }.lab-hero::after { position: absolute; top: 15%; right: -34%; width: 22rem; aspect-ratio: 1; border: 1px solid rgba(91,150,255,.18); border-radius: 50%; box-shadow: 0 0 0 3rem rgba(66,124,244,.025), 0 0 65px rgba(30,91,228,.1); content: ''; }.lab-hero > p { color: var(--color-accent-bright); font: 700 .7rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }.lab-hero h1 { margin-top: 1rem; font-size: clamp(2.7rem, 6vw, 5rem); line-height: .95; letter-spacing: -.06em; }.lab-hero > span { display: block; width: 5rem; height: 2px; margin: 1.8rem 0; background: linear-gradient(90deg, var(--color-accent), transparent); box-shadow: 0 0 12px rgba(65,132,255,.4); }.lab-hero > div { color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.75; }

  /* Engineering evidence: publishable proof cards. */
  .evidence { padding-bottom: var(--space-6); }
  .evidence-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1rem; }
  .evidence-card { padding: 1.3rem 1.35rem; border: 1px solid var(--color-border); border-top: 3px solid var(--color-accent); border-radius: var(--radius-md); background: linear-gradient(150deg, rgba(13,20,32,.96), rgba(7,12,20,.96)); }
  .evidence-card h3 { margin: 0 0 .5rem; color: var(--color-text); font-size: 1.02rem; letter-spacing: -.01em; }
  .evidence-card p { margin: 0; color: var(--color-text-muted); font-size: .88rem; line-height: 1.65; }

  /* Release history rows. */
  .release-evidence { padding-bottom: var(--space-6); }
  .release-list { display: grid; gap: 1px; margin: 0; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-border); list-style: none; overflow: hidden; }
  .release-row { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; align-items: baseline; padding: 1rem 1.2rem; background: rgba(6,11,19,.94); }
  .release-row__name { color: var(--color-text); font-weight: 800; }
  .release-row__version { color: var(--color-accent-bright); font: 700 .78rem/1 var(--font-mono); }
  .release-row__state { color: var(--color-text-subtle); font: 650 .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .release-row__date { margin-left: auto; color: var(--color-text-subtle); font: 650 .74rem/1 var(--font-mono); }
  .release-row__link { font-size: .82rem; }

  .principles { padding-bottom: var(--space-7); }.principles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }.principles-grid article { position: relative; min-height: 13rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: linear-gradient(145deg, rgba(13,20,32,.96), rgba(7,12,20,.96)); box-shadow: var(--shadow-sm), inset 0 1px rgba(255,255,255,.03); }.principles-grid article::after { position: absolute; right: 1rem; bottom: 1rem; width: 1.2rem; height: 1.2rem; border-right: 1px solid var(--color-border-blue); border-bottom: 1px solid var(--color-border-blue); content: ''; }.principles-grid span { color: var(--color-accent-bright); font: 700 .72rem/1 var(--font-mono); }.principles-grid h2 { margin: 2.1rem 0 .6rem; font-size: 1.23rem; }.principles-grid p { color: var(--color-text-muted); }.lab-flow { width: 100vw; margin-left: calc(50% - 50vw); padding: var(--space-7) max(1.25rem, calc((100vw - var(--content-width)) / 2)); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: linear-gradient(180deg, rgba(11,18,30,.78), rgba(6,11,19,.72)); } /* One connected rail, not five boxes. */ .decision-loop { position: relative; max-width: 42rem; margin: 2.4rem auto 0; padding: 0 0 0 2.4rem; display: grid; gap: 1.6rem; list-style: none; } .decision-loop::before { position: absolute; top: .4rem; bottom: .4rem; left: .39rem; width: 1px; background: linear-gradient(180deg, var(--color-accent-secondary), color-mix(in srgb, var(--color-accent-secondary) 25%, transparent)); content: ''; } .decision-stage { position: relative; display: grid; gap: .2rem; text-align: left; } .decision-stage__node { position: absolute; top: .3rem; left: -2.4rem; width: .85rem; height: .85rem; border: 2px solid var(--color-accent-secondary); border-radius: 50%; background: var(--color-bg); } .decision-stage__name { margin: 0; color: var(--color-text); font: 700 .82rem/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; } .decision-stage__desc { margin: .35rem 0 0; color: var(--color-text-muted); font-size: .92rem; line-height: 1.65; }.process-block { padding: var(--space-7) 0; text-align: center; }.process-block__lead { margin: 0 0 1rem; color: var(--color-text-subtle); font: 700 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }.process-block__steps { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .5rem .35rem; }.process-block__step { color: var(--color-text-muted); font: 700 .78rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }.process-block__arrow { margin: 0 .55rem; color: var(--color-accent-secondary); }.process-block__note { max-width: 35rem; margin: 2.2rem auto 0; color: var(--color-text-subtle); font-size: .82rem; }
  @media (max-width: 650px) { .principles-grid { grid-template-columns: 1fr; }.decision-loop { max-width: none; gap: 1.4rem; }.release-row__date { margin-left: 0; } }
</style>
