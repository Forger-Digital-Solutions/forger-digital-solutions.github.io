---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusPill from '../../../components/StatusPill.astro';
import ModelCardPanel from '../../../components/ModelCardPanel.astro';
import { getRegistryEntry } from '../../../data/registry';

const entry = getRegistryEntry('hackmanite-prime');
---

<BaseLayout
  title="Hackmanite Prime — Specialist Gaming Coding Model"
  description="Hackmanite Prime is FDS's planned 27B specialist model targeting Apache-2.0 Qwen/Qwen3.8-27B for game-dev coding and engine scripting."
  accent="hackmanite"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/models/">Models</a><span aria-hidden="true">/</span>
    <a href="/models/hackmanite/">Hackmanite</a><span aria-hidden="true">/</span>
    <span aria-current="page">Prime</span>
  </nav>

  <header class="page-head">
    <div class="meta-bar">
      <p class="page-eyebrow">Hackmanite Family · Planned Specialist Line</p>
      <StatusPill status={entry.development_status} />
    </div>
    <h1 class="page-title">Hackmanite Prime</h1>
    <p class="page-description">
      Designed for responsive specialist gaming assistance, engine API scripting, shader authoring, and gameplay implementation on top of the open-weight <code>Qwen/Qwen3.8-27B</code> foundation.
    </p>
  </header>

  <section class="page-section page-section--tight">
    <ModelCardPanel entry={entry} showLink={false} />
  </section>

  <section class="page-section page-section--surface">
    <div class="fds-section-head">
      <div class="fds-section-head__copy">
        <p class="fds-eyebrow"><span class="fds-eyebrow__rule"></span>Lifecycle &amp; Provenance Distinction</p>
        <h2>Four distinct milestones before public availability.</h2>
      </div>
    </div>

    <div class="fds-table-wrap" tabindex="0" role="region" aria-label="Scrollable data table">
      <table class="fds-table">
        <thead>
          <tr>
            <th scope="col">Stage</th>
            <th scope="col">Hackmanite Prime Status</th>
            <th scope="col">Explanation</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">01 · Base Model Provenance</th>
            <td>Third-party open-weight foundation</td>
            <td>Planned foundation is <code>Qwen/Qwen3.8-27B</code>. FDS clearly attributes base-model provenance and never markets adapted models as trained from scratch.</td>
          </tr>
          <tr>
            <th scope="row">02 · Specialist Fine-Tuning</th>
            <td>Planned / Not publicly certified</td>
            <td>Controlled post-training runs require cleared Project Forge datasets under explicit dataset-eligibility review.</td>
          </tr>
          <tr>
            <th scope="row">03 · Independent Evaluation</th>
            <td>Pending public benchmark export</td>
            <td>Will be compared directly against unadapted <code>Qwen/Qwen3.8-27B</code> on isolated game-engineering coding tasks.</td>
          </tr>
          <tr>
            <th scope="row">04 · Public Deployment</th>
            <td>Not publicly available</td>
            <td>No public weights, adapters, or live inference endpoint are offered on this website.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="nav-foot">
      <a href="/models/hackmanite/reasoning/" class="btn btn-outline">Compare with Hackmanite Reasoning <span aria-hidden="true">→</span></a>
      <a href="/models/hackmanite/" class="text-link">Back to Hackmanite family</a>
    </div>
  </section>
</BaseLayout>

<style>
  .meta-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-bottom: 0.75rem; }
  .meta-bar .page-eyebrow { margin: 0; }
  .nav-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
</style>
