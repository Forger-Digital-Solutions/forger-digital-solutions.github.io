---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecimenMedia from '../../components/SpecimenMedia.astro';

const focusPillars = [
  { title: 'Game Engine Internals', body: 'Architecture, memory models, scene graphs, asset streaming, and build automation across Unreal Engine, Godot, and custom C++/Rust runtimes.' },
  { title: 'Real-Time Graphics & Shaders', body: 'PBR material authoring, HLSL/GLSL/WGSL shader debugging, shadow cascades, GPU profiling, and deterministic frame-time budgets.' },
  { title: 'Physics, Collision & Simulation', body: 'Fixed-timestep integration, rigid-body constraints, character controllers, spatial partitioning, and deterministic netcode synchronization.' },
  { title: 'Technical Art & Asset Pipelines', body: 'Blender-to-engine validation, skeletal rigging checks, UV packing, LOD budgets, and automated scene-integrity checks.' },
];
---

<BaseLayout
  title="Gaming & Game Engineering Research"
  description="Project Forge gaming research covering game engine engineering, real-time graphics, physics, NPC intelligence, and technical art for Hackmanite."
  accent="hackmanite"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/research/">Research</a><span aria-hidden="true">/</span>
    <span aria-current="page">Gaming &amp; Game Engineering</span>
  </nav>

  <header class="page-head">
    <p class="page-eyebrow">Project Forge // Division Track · Hackmanite Foundation</p>
    <h1 class="page-title">Universal Gaming &amp; Game Engineering</h1>
    <p class="page-description">
      Studying the full technical stack of interactive world creation — from low-level engine C++ and GPU shaders to skeletal animation, NPC decision systems, and automated asset validation.
    </p>
  </header>

  <section class="page-section page-section--tight">
    <SpecimenMedia
      src="/images/forge/hackmanite-gamedev.webp"
      mobileSrc="/images/forge/hackmanite-gamedev-sm.webp"
      alt="3D game-engine split visualization transitioning from UV layout, shader graph, and skeletal rig wireframe into lit PBR mountain fortress."
      label="Game-Development Pipeline Concept — Research Division Illustration"
      eager
    />
  </section>

  <section class="page-section page-section--surface">
    <div class="pillar-grid">
      {focusPillars.map((item, i) => (
        <article class="pillar-card">
          <span>0{i + 1}</span>
          <h2>{item.title}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
    <div class="track-links">
      <a href="/models/hackmanite/" class="btn btn-outline">Explore Hackmanite Models <span aria-hidden="true">→</span></a>
      <a href="/studio/state-lines/" class="text-link">See State Lines studio direction</a>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--color-border-structural); border-radius: var(--radius-md); background: var(--color-border); overflow: hidden; }
  .pillar-card { padding: 1.5rem; background: var(--color-bg); }
  .pillar-card span { color: var(--accent-hackmanite); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; }
  .pillar-card h2 { margin: 0.45rem 0 0.4rem; font-size: 1.15rem; }
  .pillar-card p { margin: 0; color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.65; }
  .track-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
  @media (max-width: 760px) { .pillar-grid { grid-template-columns: 1fr; } }
</style>
