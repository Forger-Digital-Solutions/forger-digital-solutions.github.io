---
import { solutionsData } from '../data/registry';

const scenarios = solutionsData.battleverseDirections.arenaScenarios;
---

<div class="arena-demo" data-arena-demo>
  <div class="arena-demo__banner" role="note">
    <strong>Illustrative Demonstration Only:</strong> Built with 100% original FDS test silhouettes to show how BattleVerse separates canonical evidence, physical assumptions, and probabilistic uncertainty. This static webpage does not run a live backend simulation engine and never establishes canonical fact.
  </div>

  <div class="arena-demo__controls" role="tablist" aria-label="Illustrative BattleVerse Arena scenarios">
    {scenarios.map((sc, idx) => (
      <button
        type="button"
        role="tab"
        id={`arena-tab-${sc.id}`}
        aria-selected={idx === 0 ? 'true' : 'false'}
        aria-controls={`arena-panel-${sc.id}`}
        class={`arena-tab ${idx === 0 ? 'is-active' : ''}`}
        data-arena-target={sc.id}
      >
        <span class="arena-tab__num">SCENARIO 0{idx + 1}</span>
        <span class="arena-tab__title">{sc.title}</span>
      </button>
    ))}
  </div>

  {scenarios.map((sc, idx) => (
    <div
      id={`arena-panel-${sc.id}`}
      class="arena-panel"
      role="tabpanel"
      aria-labelledby={`arena-tab-${sc.id}`}
      data-arena-panel={sc.id}
      hidden={idx !== 0}
    >
      <div class="arena-env">
        <span class="arena-env__tag">{sc.category}</span>
        <p class="arena-env__spec">{sc.environment}</p>
      </div>

      <div class="arena-fighters">
        <div class="arena-fighter">
          <div class="arena-fighter__top">
            <h3>{sc.fighterA.name}</h3>
            <span class="arena-band">{sc.fighterA.winBand}</span>
          </div>
          <p>{sc.fighterA.profile}</p>
          <span class="arena-band__caption">Illustrative modeled probability band</span>
        </div>

        <div class="arena-vs" aria-hidden="true">VS</div>

        <div class="arena-fighter">
          <div class="arena-fighter__top">
            <h3>{sc.fighterB.name}</h3>
            <span class="arena-band arena-band--alt">{sc.fighterB.winBand}</span>
          </div>
          <p>{sc.fighterB.profile}</p>
          <span class="arena-band__caption">Illustrative modeled probability band</span>
        </div>
      </div>

      <div class="arena-audit-grid">
        <section class="arena-audit-box">
          <h4>01 · Canonical Evidence &amp; Exclusions</h4>
          <ul>
            {sc.canonicalEvidence.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="arena-audit-box">
          <h4>02 · Explicit Mathematical Assumptions</h4>
          <ul>
            {sc.mathAssumptions.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="arena-audit-box arena-audit-box--wide">
          <h4>03 · Statistical Sensitivity &amp; Non-Canonical Disclosure</h4>
          <ul>
            {sc.uncertaintyNotes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('[data-arena-demo]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-arena-target]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-arena-panel]'));

    const activate = (targetId: string) => {
      tabs.forEach((t) => {
        const active = t.dataset.arenaTarget === targetId;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.arenaPanel !== targetId;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => activate(tab.dataset.arenaTarget || ''));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const next = tabs[(idx + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
          next.focus();
          activate(next.dataset.arenaTarget || '');
        }
      });
    });
  });
</script>

<style>
  .arena-demo {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
  }

  .arena-demo__banner {
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-left: 3px solid #60a5fa;
    border-radius: var(--radius-sm);
    background: rgba(59, 130, 246, 0.08);
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .arena-demo__banner strong {
    color: var(--color-text);
  }

  .arena-demo__controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .arena-tab {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease;
  }

  .arena-tab:hover {
    border-color: rgba(96, 165, 250, 0.45);
  }

  .arena-tab.is-active {
    border-color: #60a5fa;
    background: rgba(59, 130, 246, 0.12);
  }

  .arena-tab__num {
    color: #93c5fd;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .arena-tab__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .arena-env {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .arena-env__tag {
    color: #93c5fd;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .arena-env__spec {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .arena-fighters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
    margin: 1.1rem 0;
  }

  .arena-fighter {
    padding: 1.15rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  .arena-fighter__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .arena-fighter h3 {
    margin: 0;
    font-size: 1.06rem;
  }

  .arena-band {
    padding: 0.2rem 0.55rem;
    border: 1px solid rgba(96, 165, 250, 0.45);
    border-radius: var(--radius-xs);
    background: rgba(59, 130, 246, 0.14);
    color: #dbeafe;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .arena-band--alt {
    border-color: rgba(129, 140, 248, 0.45);
    background: rgba(129, 140, 248, 0.14);
    color: #e0e7ff;
  }

  .arena-fighter p {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .arena-band__caption {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .arena-vs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.4rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .arena-audit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .arena-audit-box {
    padding: 1.1rem;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-sm);
    background: var(--color-recessed);
  }

  .arena-audit-box--wide {
    grid-column: 1 / -1;
  }

  .arena-audit-box h4 {
    margin: 0 0 0.55rem;
    color: #93c5fd;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .arena-audit-box ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.62;
  }

  .arena-audit-box li + li {
    margin-top: 0.35rem;
  }

  @media (max-width: 820px) {
    .arena-demo {
      padding: 1.05rem;
    }
    .arena-demo__controls,
    .arena-fighters,
    .arena-audit-grid {
      grid-template-columns: 1fr;
    }
    .arena-vs {
      padding: 0.15rem 0;
    }
  }
</style>
