---
const systems = [
  { label: 'AI + Research', detail: 'Training, evaluation, governed intelligence' },
  { label: 'Applications', detail: 'Useful tools and creative software' },
  { label: 'Infrastructure', detail: 'Developer systems and adaptive compute' },
  { label: 'Community', detail: 'Accessible, public-facing technology' }
];
---
<div class="ecosystem-map" role="img" aria-label="Forger Digital Solutions ecosystem connecting AI research, applications, infrastructure, and community software">
  <div class="ecosystem-map__core">
    <span>FDS</span>
    <small>ECOSYSTEM</small>
  </div>
  <div class="ecosystem-map__orbit" aria-hidden="true"></div>
  <div class="ecosystem-map__systems">
    {systems.map((system, index) => (
      <article class={`ecosystem-node ecosystem-node--${index + 1}`}>
        <span class="ecosystem-node__index">0{index + 1}</span>
        <strong>{system.label}</strong>
        <small>{system.detail}</small>
      </article>
    ))}
  </div>
</div>

<style>
  .ecosystem-map { position: relative; isolation: isolate; min-height: 34rem; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: radial-gradient(circle at 50% 48%, rgba(25,79,204,.17), transparent 23%), linear-gradient(145deg, rgba(12,20,36,.88), rgba(5,9,16,.96)); box-shadow: var(--shadow-panel), inset 0 1px rgba(255,255,255,.04); }
  .ecosystem-map::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(93,142,240,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(93,142,240,.06) 1px, transparent 1px); background-size: 38px 38px; mask-image: radial-gradient(circle, #000, transparent 78%); content: ''; }
  .ecosystem-map__core { position: absolute; z-index: 3; top: 50%; left: 50%; display: grid; place-items: center; width: 8.2rem; height: 8.2rem; border: 1px solid rgba(92,153,255,.62); border-radius: 50%; background: radial-gradient(circle at 36% 28%, rgba(85,147,255,.31), rgba(7,20,47,.94) 55%); box-shadow: 0 0 54px rgba(27,91,230,.3), inset 0 0 24px rgba(117,174,255,.1); transform: translate(-50%, -50%); }
  .ecosystem-map__core::after { position: absolute; inset: -.6rem; border: 1px dashed rgba(125,168,240,.28); border-radius: inherit; content: ''; animation: ecosystem-spin 28s linear infinite; }
  .ecosystem-map__core span { color: #f8fbff; font: 850 1.65rem/1 var(--font-mono); letter-spacing: .16em; text-indent: .16em; }.ecosystem-map__core small { margin-top: -2.3rem; color: #8cbcff; font: 700 .55rem/1 var(--font-mono); letter-spacing: .15em; }
  .ecosystem-map__orbit { position: absolute; top: 50%; left: 50%; width: min(72%, 34rem); aspect-ratio: 1.75; border: 1px solid rgba(100,151,243,.2); border-radius: 50%; transform: translate(-50%, -50%) rotate(-7deg); }
  .ecosystem-map__orbit::before, .ecosystem-map__orbit::after { position: absolute; top: 50%; width: 32%; height: 1px; background: linear-gradient(90deg, transparent, rgba(91,150,255,.55)); content: ''; }.ecosystem-map__orbit::before { right: 100%; }.ecosystem-map__orbit::after { left: 100%; transform: rotate(180deg); }
  .ecosystem-map__systems { position: absolute; inset: 0; }
  .ecosystem-node { position: absolute; z-index: 2; display: grid; width: min(15rem, 32%); padding: .85rem 1rem; border: 1px solid rgba(161,184,222,.18); border-radius: var(--radius-md); background: rgba(8,14,25,.86); box-shadow: inset 0 1px rgba(255,255,255,.035), 0 14px 36px rgba(0,0,0,.25); backdrop-filter: blur(10px); }
  .ecosystem-node::before { position: absolute; top: 50%; width: 4.5rem; height: 1px; background: linear-gradient(90deg, rgba(84,145,255,.5), transparent); content: ''; }
  .ecosystem-node--1 { top: 10%; left: 7%; }.ecosystem-node--2 { top: 11%; right: 7%; }.ecosystem-node--3 { bottom: 10%; left: 7%; }.ecosystem-node--4 { right: 7%; bottom: 10%; }
  .ecosystem-node--1::before, .ecosystem-node--3::before { left: 100%; }.ecosystem-node--2::before, .ecosystem-node--4::before { right: 100%; transform: rotate(180deg); }
  .ecosystem-node__index { color: var(--color-accent-bright); font: 700 .6rem/1 var(--font-mono); letter-spacing: .12em; }.ecosystem-node strong { margin-top: .45rem; color: var(--color-text); font-size: .9rem; }.ecosystem-node small { margin-top: .25rem; color: var(--color-text-subtle); font-size: .72rem; line-height: 1.4; }
  @keyframes ecosystem-spin { to { transform: rotate(360deg); } }
  @media (max-width: 680px) { .ecosystem-map { min-height: 35rem; }.ecosystem-map__core { top: 30%; }.ecosystem-map__orbit { top: 30%; width: 76%; }.ecosystem-map__systems { top: 50%; display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; padding: 1rem; }.ecosystem-node { position: relative; inset: auto; width: auto; min-width: 0; }.ecosystem-node::before { display: none; } }
  @media (max-width: 430px) { .ecosystem-map__systems { grid-template-columns: 1fr; }.ecosystem-map { min-height: 46rem; } }
  @media (prefers-reduced-motion: reduce) { .ecosystem-map__core::after { animation: none; } }
</style>
