---
import type { Project } from '../types';

interface Props {
  project: Project;
  /** 'hero' renders the large detail-page banner; 'card' renders the compact card motif. */
  variant?: 'hero' | 'card';
}

const { project, variant = 'hero' } = Astro.props;
const style: NonNullable<Project['visualStyle']> = project.visualStyle ?? 'nodes';
const accent = project.accentColor || 'var(--color-accent)';
---
<div
  class:list={['pvisual', `pvisual--${variant}`, `pvisual--${style}`]}
  style={`--pv-accent: ${accent}`}
  role="img"
  aria-label={`Abstract FDS visual identity for ${project.name}`}
>
  <svg viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`pv-fade-${project.slug}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--pv-accent)" stop-opacity="0.22" />
        <stop offset="1" stop-color="var(--pv-accent)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect width="480" height="270" fill={`url(#pv-fade-${project.slug})`} />

    {style === 'nodes' && (
      <g class="pv-stroke" fill="none">
        <path d="M60 60 L180 60 L300 135 L420 135" />
        <path d="M60 135 L180 135 L300 60 L420 60" />
        <path d="M60 210 L180 210 L300 135 L420 210" />
        <path d="M180 135 L300 210" />
        <g class="pv-fill">
          <circle cx="60" cy="60" r="7" /><circle cx="60" cy="135" r="7" /><circle cx="60" cy="210" r="7" />
          <circle cx="180" cy="60" r="9" /><circle cx="180" cy="135" r="9" /><circle cx="180" cy="210" r="9" />
          <circle cx="300" cy="60" r="9" /><circle cx="300" cy="135" r="11" /><circle cx="300" cy="210" r="9" />
          <circle cx="420" cy="60" r="7" /><circle cx="420" cy="135" r="7" /><circle cx="420" cy="210" r="7" />
        </g>
      </g>
    )}

    {style === 'blocks' && (
      <g class="pv-stroke" fill="none">
        <rect x="70" y="150" width="60" height="60" rx="6" />
        <rect x="140" y="150" width="60" height="60" rx="6" />
        <rect x="105" y="88" width="60" height="60" rx="6" class="pv-block-fill" />
        <rect x="250" y="60" width="150" height="40" rx="6" />
        <rect x="250" y="112" width="110" height="40" rx="6" />
        <rect x="278" y="164" width="82" height="40" rx="6" />
        <path d="M250 80 L200 80 M250 132 L200 132 L200 80" />
        <g class="pv-fill">
          <circle cx="200" cy="80" r="4" /><circle cx="200" cy="132" r="4" />
        </g>
      </g>
    )}

    {style === 'manuscript' && (
      <g class="pv-stroke" fill="none">
        <rect x="90" y="55" width="150" height="180" rx="8" transform="rotate(-4 165 145)" />
        <rect x="120" y="45" width="150" height="180" rx="8" class="pv-block-fill" />
        <g class="pv-lines">
          <line x1="140" y1="80" x2="250" y2="80" /><line x1="140" y1="100" x2="250" y2="100" />
          <line x1="140" y1="120" x2="230" y2="120" /><line x1="140" y1="140" x2="250" y2="140" />
          <line x1="140" y1="160" x2="210" y2="160" /><line x1="140" y1="185" x2="250" y2="185" />
        </g>
        <g class="pv-fill"><circle cx="320" cy="90" r="5" /><circle cx="360" cy="150" r="5" /><circle cx="330" cy="200" r="5" /></g>
        <path d="M320 90 L360 150 L330 200" />
      </g>
    )}

    {style === 'civic' && (
      <g class="pv-stroke" fill="none">
        <path d="M240 40 L120 100 L120 200 L240 240 L360 200 L360 100 Z" class="pv-block-fill" />
        <path d="M240 40 L240 240 M120 100 L360 200 M360 100 L120 200 M120 150 L360 150" />
        <g class="pv-fill">
          <circle cx="240" cy="40" r="7" /><circle cx="120" cy="100" r="6" /><circle cx="360" cy="100" r="6" />
          <circle cx="120" cy="200" r="6" /><circle cx="360" cy="200" r="6" /><circle cx="240" cy="240" r="7" />
          <circle cx="240" cy="140" r="9" />
        </g>
      </g>
    )}

    {style === 'map' && (
      <g class="pv-stroke" fill="none">
        <path d="M40 100 L160 70 L300 110 L440 80" />
        <path d="M40 160 L160 130 L300 170 L440 140" />
        <path d="M40 220 L160 190 L300 230 L440 200" />
        <g class="pv-pins">
          <path d="M150 95 a16 16 0 1 1 0.1 0 Z M150 95 L150 125" class="pv-block-fill" />
          <path d="M300 65 a12 12 0 1 1 0.1 0 Z M300 65 L300 88" />
          <path d="M380 150 a12 12 0 1 1 0.1 0 Z M380 150 L380 173" />
        </g>
        <g class="pv-fill"><circle cx="150" cy="80" r="4" /><circle cx="300" cy="53" r="3" /><circle cx="380" cy="138" r="3" /></g>
      </g>
    )}
  </svg>
</div>

<style>
  .pvisual {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--pv-accent) 30%, var(--color-border));
    background:
      radial-gradient(60% 90% at 78% 15%, color-mix(in srgb, var(--pv-accent) 14%, transparent), transparent 70%),
      var(--color-bg-secondary);
  }
  .pvisual--hero { aspect-ratio: 16 / 7; }
  .pvisual--card { aspect-ratio: 16 / 9; }
  .pvisual svg { display: block; width: 100%; height: 100%; }
  .pv-stroke { stroke: var(--pv-accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .pv-stroke path, .pv-stroke line, .pv-stroke rect { opacity: 0.85; }
  .pv-fill circle { fill: var(--pv-accent); stroke: none; }
  .pv-block-fill { fill: color-mix(in srgb, var(--pv-accent) 12%, transparent); }
  .pv-lines line { stroke: color-mix(in srgb, var(--pv-accent) 65%, var(--color-text-subtle)); stroke-width: 3; }
  @media (prefers-reduced-motion: no-preference) {
    .pv-fill circle { animation: pv-pulse 4s ease-in-out infinite; }
    .pv-fill circle:nth-child(even) { animation-delay: 1.2s; }
    @keyframes pv-pulse { 50% { opacity: 0.55; } }
  }
</style>
