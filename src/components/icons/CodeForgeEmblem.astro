---
/**
 * CODEFORGE EMBLEM — the authoritative CodeForge identity, inline variant.
 *
 * Geometry recovered from the CodeForge product source
 * (apps/desktop/assets/icon.svg, embedded in the "Welcome to CodeForge"
 * onboarding flow). The static canonical asset lives at
 * /public/images/codeforge/codeforge-icon.svg; this component carries the
 * same geometry organized for the web: each orbital plane groups its own
 * track and spheres, so the allowed slow plane drift keeps every node
 * attached to its path by construction.
 *
 * `uid` keeps gradient ids unique when the emblem renders more than once
 * per page. `x/y/width/height` allow nesting inside a parent SVG scene.
 */
interface Props {
  uid?: string;
  class?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}

const { uid = 'cf', class: className, x, y, width, height } = Astro.props;
const id = (name: string) => `${uid}-${name}`;
const url = (name: string) => `url(#${uid}-${name})`;
---

<svg
  viewBox="0 0 256 256"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['cf-emblem', className]}
  aria-hidden="true"
  x={x}
  y={y}
  width={width}
  height={height}
>
  <defs>
    <radialGradient id={id('bg')} cx="50%" cy="50%" r="68%">
      <stop offset="0%" stop-color="#1e1f24" /><stop offset="55%" stop-color="#131418" /><stop offset="100%" stop-color="#08090b" />
    </radialGradient>
    <linearGradient id={id('rim')} x1="8%" y1="8%" x2="92%" y2="92%">
      <stop offset="0%" stop-color="#f1f2f4" /><stop offset="18%" stop-color="#c9ccd2" /><stop offset="42%" stop-color="#a8adb5" /><stop offset="72%" stop-color="#7d828a" /><stop offset="100%" stop-color="#c2c6cd" />
    </linearGradient>
    <linearGradient id={id('orbit')} x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#e6e8ec" /><stop offset="45%" stop-color="#b8bec7" /><stop offset="100%" stop-color="#8b9099" />
    </linearGradient>
    <radialGradient id={id('diamond-top')} cx="32%" cy="22%" r="85%">
      <stop offset="0%" stop-color="#ffffff" /><stop offset="28%" stop-color="#dbe0e6" /><stop offset="62%" stop-color="#9aa2af" /><stop offset="100%" stop-color="#5c6575" />
    </radialGradient>
    <radialGradient id={id('diamond-left')} cx="20%" cy="35%" r="90%">
      <stop offset="0%" stop-color="#f2f4f7" /><stop offset="35%" stop-color="#b9c0cc" /><stop offset="100%" stop-color="#3e4552" />
    </radialGradient>
    <radialGradient id={id('diamond-right')} cx="78%" cy="30%" r="90%">
      <stop offset="0%" stop-color="#ffffff" /><stop offset="30%" stop-color="#c8d0dc" /><stop offset="100%" stop-color="#4a5261" />
    </radialGradient>
    <radialGradient id={id('sphere')} cx="32%" cy="28%" r="75%">
      <stop offset="0%" stop-color="#ffffff" /><stop offset="18%" stop-color="#e8ecf0" /><stop offset="48%" stop-color="#a9b0bc" /><stop offset="100%" stop-color="#5a6474" />
    </radialGradient>
    <radialGradient id={id('sphere-dark')} cx="32%" cy="28%" r="75%">
      <stop offset="0%" stop-color="#f1f3f5" /><stop offset="45%" stop-color="#9aa2b1" /><stop offset="100%" stop-color="#3a404c" />
    </radialGradient>
  </defs>

  <!-- metallic rim + graphite disc -->
  <circle cx="128" cy="128" r="127" fill="none" stroke={url('rim')} stroke-width="3" />
  <circle cx="128" cy="128" r="122" fill={url('bg')} />
  <circle cx="128" cy="128" r="98" fill="none" stroke="#2e2f35" stroke-width="0.7" opacity="0.35" />
  <circle cx="128" cy="128" r="98" fill="none" stroke="#3a3d44" stroke-width="0.7" stroke-dasharray="1 7" opacity="0.35" />
  <circle cx="128" cy="128" r="56" fill="none" stroke="#3a3d44" stroke-width="0.6" stroke-dasharray="1 8" opacity="0.28" />

  <!-- orbital plane A: steep diagonal (-18deg) with two attached nodes -->
  <g class="cf-plane cf-plane--a">
    <ellipse cx="128" cy="128" rx="108" ry="46" transform="rotate(-18 128 128)" stroke={url('orbit')} stroke-width="4.2" opacity="0.98" />
    <ellipse cx="128" cy="128" rx="108" ry="46" transform="rotate(-18 128 128)" stroke="#0a0b0d" stroke-width="1" opacity="0.35" />
    <g>
      <circle cx="183.2" cy="73" r="20" fill="#07080a" opacity="0.45" />
      <circle cx="183.2" cy="73" r="20" fill={url('sphere')} stroke="#d6dae0" stroke-width="0.7" />
      <ellipse cx="177.2" cy="66" rx="6.5" ry="4.2" fill="#ffffff" opacity="0.42" />
    </g>
    <g>
      <circle cx="72.8" cy="183" r="13" fill={url('sphere-dark')} stroke="#c2c6cd" stroke-width="0.5" />
      <circle cx="70.8" cy="180" r="2.4" fill="#ffffff" opacity="0.38" />
    </g>
  </g>

  <!-- orbital plane B: opposite diagonal (42deg) with two attached nodes -->
  <g class="cf-plane cf-plane--b">
    <ellipse cx="128" cy="128" rx="108" ry="40" transform="rotate(42 128 128)" stroke={url('orbit')} stroke-width="3.8" opacity="0.95" />
    <g>
      <circle cx="208.2" cy="200.3" r="15.8" fill="#07080a" opacity="0.42" />
      <circle cx="208.2" cy="200.3" r="15.8" fill={url('sphere')} stroke="#d6dae0" stroke-width="0.6" />
      <ellipse cx="202.8" cy="193.9" rx="5.2" ry="3.4" fill="#ffffff" opacity="0.40" />
    </g>
    <g>
      <circle cx="47.8" cy="56" r="7.8" fill={url('sphere-dark')} stroke="#c2c6cd" stroke-width="0.5" />
      <circle cx="46.2" cy="54" r="2" fill="#ffffff" opacity="0.38" />
    </g>
  </g>

  <!-- orbital plane C: shallow third axis (78deg) with two attached nodes -->
  <g class="cf-plane cf-plane--c">
    <ellipse cx="128" cy="128" rx="102" ry="36" transform="rotate(78 128 128)" stroke="#a8adb5" stroke-width="3.2" opacity="0.9" />
    <ellipse cx="128" cy="128" rx="102" ry="36" transform="rotate(78 128 128)" stroke="#d6dae0" stroke-width="0.7" opacity="0.45" />
    <g>
      <circle cx="163.2" cy="120.5" r="6.2" fill={url('sphere-dark')} stroke="#c2c6cd" stroke-width="0.45" />
      <circle cx="162" cy="118.7" r="1.5" fill="#ffffff" opacity="0.36" />
    </g>
    <g>
      <circle cx="92.8" cy="135.5" r="6.5" fill={url('sphere-dark')} stroke="#c2c6cd" stroke-width="0.45" />
      <circle cx="91.2" cy="133.3" r="1.6" fill="#ffffff" opacity="0.36" />
    </g>
  </g>

  <!-- faceted crystal core (stable) -->
  <path d="M 128 204 L 102 152 L 78 106 L 128 56 L 178 106 L 154 152 Z" fill="#06070a" opacity="0.42" />
  <g class="cf-diamond">
    <path d="M 128 56 L 178 106 L 128 118 L 78 106 Z" fill={url('diamond-top')} stroke="rgba(255,255,255,0.55)" stroke-width="0.6" />
    <path d="M 78 106 L 128 118 L 102 152 L 78 106" fill="#8f99ab" stroke="rgba(255,255,255,0.22)" stroke-width="0.5" />
    <path d="M 78 106 L 102 152 L 128 204 L 128 118 L 78 106" fill={url('diamond-left')} stroke="rgba(255,255,255,0.18)" stroke-width="0.5" />
    <path d="M 178 106 L 128 118 L 154 152 L 178 106" fill="#b8c0ce" stroke="rgba(255,255,255,0.22)" stroke-width="0.5" />
    <path d="M 178 106 L 154 152 L 128 204 L 128 118 L 178 106" fill={url('diamond-right')} stroke="rgba(255,255,255,0.2)" stroke-width="0.5" />
    <path d="M 128 118 L 128 204 L 102 152 Z" fill="#2f3542" opacity="0.92" />
    <path d="M 128 118 L 154 152 L 128 204 Z" fill="#e8ecf2" opacity="0.96" />
    <path d="M 128 118 L 102 152 L 128 162 Z" fill="#d4dae6" opacity="0.85" />
    <path d="M 128 118 L 128 162 L 154 152 Z" fill="#f7f8fa" opacity="0.98" />
    <ellipse cx="128" cy="204" rx="26" ry="6" fill="#000000" opacity="0.28" />
  </g>
  <!-- crystal illumination: slow top-edge shine breathe -->
  <g class="cf-shine">
    <path d="M 78 106 L 128 118 L 178 106" fill="none" stroke="#ffffff" stroke-width="0.9" opacity="0.55" />
    <circle cx="128" cy="118.5" r="1.6" fill="#ffffff" opacity="0.95" />
  </g>
</svg>

<style>
  .cf-emblem { display: block; }
  .cf-plane { transform-box: view-box; transform-origin: 128px 128px; }
  .cf-plane--a { animation: cf-plane-drift 150s linear infinite; }
  .cf-plane--b { animation: cf-plane-drift 210s linear infinite reverse; }
  .cf-plane--c { animation: cf-plane-drift 265s linear infinite; }
  .cf-shine { animation: cf-shine-breathe 11s ease-in-out infinite; }
  @keyframes cf-plane-drift { to { transform: rotate(360deg); } }
  @keyframes cf-shine-breathe { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .cf-plane, .cf-shine { animation: none; }
  }
</style>
