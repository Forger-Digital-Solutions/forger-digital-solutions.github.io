---
import { siteConfig } from '../config/site';
const COUNTER_URL = `https://countapi.mileshilliard.com/api/v1/hit/${siteConfig.visitorCounterKey}`;
---
<span class="visitor-counter" id="fds-visitor-counter" data-counter-url={COUNTER_URL} aria-label="Visitor count">
  <span class="visitor-counter__dot" aria-hidden="true"></span>
  <span class="visitor-counter__label">Visitors</span>
  <span class="visitor-counter__value" id="fds-visitor-count">--</span>
</span>
<script>
  (function () {
    const STORAGE_KEY = 'fds_visitor_id';
    const EXPIRY_KEY = 'fds_visitor_expiry';
    const COUNTED_KEY = 'fds_visitor_counted_at';
    const DEDUP_MS = 24 * 60 * 60 * 1000;
    const url = document.getElementById('fds-visitor-counter')?.dataset.counterUrl;

    const valueEl = document.getElementById('fds-visitor-count');
    if (!valueEl || !url) return;

    const generateId = () => {
      const arr = new Uint8Array(16);
      crypto.getRandomValues(arr);
      return Array.from(arr, (b) => b.toString(16).padStart(2, '0')).join('');
    };

    let visitorId: string | null = null;
    let expiry: number | null = null;
    try {
      visitorId = window.localStorage.getItem(STORAGE_KEY);
      expiry = Number(window.localStorage.getItem(EXPIRY_KEY));
      if (Number.isNaN(expiry)) expiry = null;
    } catch {
      // blocked storage
    }

    const now = Date.now();
    const isExpired = !expiry || now >= expiry;

    if (!visitorId || isExpired) {
      visitorId = generateId();
      try {
        window.localStorage.setItem(STORAGE_KEY, visitorId);
        window.localStorage.setItem(EXPIRY_KEY, String(now + DEDUP_MS));
      } catch {
        // ignore storage failures
      }
    }

    let counted = false;
    let bc: BroadcastChannel | null = null;

    try {
      bc = new BroadcastChannel('fds_visitor_counter');
      bc.addEventListener('message', (ev) => {
        if (ev.data && ev.data.type === 'fds_counted') {
          counted = true;
          valueEl.textContent = String(ev.data.value ?? '0');
        }
      });
    } catch {
      // BroadcastChannel not supported — ignore
    }

    const tryCount = async () => {
      if (counted) return;
      counted = true;
      try {
        const res = await fetch(url, { method: 'GET', keepalive: true });
        if (!res.ok) throw new Error('Counter request failed');
        const data = await res.json();
        const value = data.value != null ? Number(data.value).toLocaleString() : '0';
        valueEl.textContent = value;
        bc?.postMessage({ type: 'fds_counted', value: data.value });
        try { window.localStorage.setItem(COUNTED_KEY, String(Date.now())); } catch {}
      } catch {
        valueEl.textContent = '0';
      }
    };

    const recentLocalCount = (() => {
      try {
        const raw = window.localStorage.getItem(COUNTED_KEY);
        if (!raw) return false;
        return Date.now() - Number(raw) < 2000;
      } catch {
        return false;
      }
    })();

    if (recentLocalCount) return;

    setTimeout(() => {
      if (counted) return;
      tryCount();
    }, 150);
  })();
</script>
<style>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font: 700 .68rem/1 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .visitor-counter__dot {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 .5rem var(--color-accent);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity:0.6; transform: scale(.85); }
  }
  .visitor-counter__value {
    color: var(--color-text);
    min-width: 1.6rem;
    text-align: right;
  }
  @media (max-width: 640px) {
    .visitor-counter { display: none; }
  }
</style>
