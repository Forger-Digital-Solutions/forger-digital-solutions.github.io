---
import { siteConfig } from '../config/site';
const COUNTER_URL = `https://countapi.mileshilliard.com/api/v1/hit/${siteConfig.visitorCounterKey}`;
---
<span class="visitor-counter" id="fds-visitor-counter" data-counter-url={COUNTER_URL} data-state="pending" aria-label="Visitor count">
  <span class="visitor-counter__dot" aria-hidden="true"></span>
  <span class="visitor-counter__label">Visitors</span>
  <span class="visitor-counter__value" id="fds-visitor-count">--</span>
</span>
<script>
  (function () {
    // One browser visit is counted per 24-hour window. The only local state is
    // a last-hit timestamp and a short-lived cross-tab claim: no visitor
    // identifier, nothing personal, nothing sent anywhere by this script.
    const LAST_HIT_KEY = 'fds_visitor_last_hit';
    const CLAIM_KEY = 'fds_visitor_claim';
    const CHANNEL = 'fds_visitor_counter';
    const DEDUP_MS = 24 * 60 * 60 * 1000;
    const CLAIM_TTL_MS = 5000; // a stale claim never blocks the next real visit
    const FOLLOWER_WAIT_MS = 3000; // how long a co-loading tab waits for the winner's value

    const counterEl = document.getElementById('fds-visitor-counter');
    const valueEl = document.getElementById('fds-visitor-count');
    const hitUrl = counterEl?.dataset.counterUrl;
    if (!counterEl || !valueEl || !hitUrl) return;
    const getUrl = hitUrl.replace('/hit/', '/get/');

    const store = {
      get(key: string): string | null {
        try { return window.localStorage.getItem(key); } catch { return null; }
      },
      set(key: string, value: string): void {
        try { window.localStorage.setItem(key, value); } catch { /* blocked storage */ }
      }
    };

    const format = (raw: unknown): string => {
      const n = Number(raw);
      return Number.isFinite(n) ? n.toLocaleString() : '0';
    };

    // The counter stays invisible until a real value exists, so a failed or
    // blocked fetch never leaves a bare placeholder or a misleading 0.
    const setValue = (value: string) => {
      valueEl.textContent = value;
      counterEl.dataset.state = 'ready';
    };

    let bc: BroadcastChannel | null = null;
    try {
      bc = new BroadcastChannel(CHANNEL);
      bc.addEventListener('message', (ev) => {
        if (ev.data && ev.data.type === 'fds_counted') {
          // The winning tab's hit covers this browser's 24-hour window too.
          store.set(LAST_HIT_KEY, String(Date.now()));
          setValue(format(ev.data.value));
        }
      });
    } catch {
      // BroadcastChannel not supported — tabs fall back to the read endpoint.
    }

    const readCount = async () => {
      try {
        const res = await fetch(getUrl, { method: 'GET', keepalive: true });
        if (!res.ok) throw new Error('Counter read failed');
        const data = await res.json();
        if (data.value != null) setValue(format(data.value));
      } catch {
        // Backend unreachable or blocked: leave the counter hidden rather than
        // showing a misleading 0. A real value from another tab can still
        // reveal it via BroadcastChannel.
      }
    };

    let claimId: string | null = null;

    const recordHit = async () => {
      // Re-verify the claim at fetch time: a tab that lost a sub-millisecond
      // write race (its claim was overwritten) becomes a follower instead of
      // double-counting.
      try {
        const claim = JSON.parse(store.get(CLAIM_KEY) ?? '{}') as { id?: string };
        if (!claim.id || claim.id !== claimId) {
          void readCount();
          return;
        }
      } catch {
        // claim unreadable: proceed as the sole claimant
      }
      try {
        const res = await fetch(hitUrl, { method: 'GET', keepalive: true });
        if (!res.ok) throw new Error('Counter request failed');
        const data = await res.json();
        store.set(LAST_HIT_KEY, String(Date.now()));
        setValue(format(data.value));
        bc?.postMessage({ type: 'fds_counted', value: data.value });
      } catch {
        // No timestamp is stored on failure, so the next navigation retries;
        // the counter itself stays hidden instead of showing a fake value.
      }
      store.set(CLAIM_KEY, '');
    };

    // Multi-tab: exactly one tab claims the 24-hour increment. The claim is
    // re-read after writing; a tab whose claim was overwritten becomes a
    // follower and only reads, so five tabs never equal five visitors.
    const tryClaim = (): boolean => {
      claimId = Array.from(crypto.getRandomValues(new Uint8Array(8)), (b) => b.toString(16).padStart(2, '0')).join('');
      const now = Date.now();
      const raw = store.get(CLAIM_KEY);
      if (raw) {
        try {
          const claim = JSON.parse(raw) as { id?: string; ts?: number };
          if (claim && claim.id !== claimId && typeof claim.ts === 'number' && now - claim.ts < CLAIM_TTL_MS) return false;
        } catch {
          // malformed claim: overwrite it
        }
      }
      store.set(CLAIM_KEY, JSON.stringify({ id: claimId, ts: now }));
      const check = store.get(CLAIM_KEY);
      if (!check) return false;
      try { return (JSON.parse(check) as { id?: string }).id === claimId; } catch { return false; }
    };

    const lastHit = Number(store.get(LAST_HIT_KEY));
    const eligible = !Number.isFinite(lastHit) || lastHit <= 0 || Date.now() - lastHit >= DEDUP_MS;

    if (!eligible) {
      void readCount();
      return;
    }

    if (!tryClaim()) {
      // Another tab took the increment: show its value if it reports in, else
      // fall back to the read-only endpoint without incrementing.
      setTimeout(() => {
        if (counterEl.dataset.state !== 'ready') void readCount();
      }, FOLLOWER_WAIT_MS);
      return;
    }

    setTimeout(recordHit, 150);
  })();
</script>
<style>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font: 700 .68rem/1 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .visitor-counter[data-state='pending'] {
    visibility: hidden;
  }
  .visitor-counter__dot {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 .5rem var(--color-accent);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity:0.6; transform: scale(.85); }
  }
  .visitor-counter__value {
    color: var(--color-text);
    min-width: 1.6rem;
    text-align: right;
  }
  @media (max-width: 640px) {
    .visitor-counter { display: none; }
  }
</style>
