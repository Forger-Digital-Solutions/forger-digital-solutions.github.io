---
import type { Product } from '../data/products';
import VisualEvidence from './VisualEvidence.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const displayVersion = product.version;
const statusLabel = {
  'free': 'Free',
  'paid': 'Paid',
  'donation': 'Donation-supported',
  'coming-soon': 'Coming Soon',
  'private-beta': 'Private Beta',
  'public-beta': 'Public Preview / Beta',
  'released': 'Released',
  'unavailable': 'Unavailable',
}[product.status] ?? product.status;
---

<article class="product-card" style={`--product-accent: var(--color-accent)`}>
  <div class="product-card__header">
    <span class="product-card__category">{product.category}</span>
    <span class="product-card__status product-card__status--{product.status}">{statusLabel}</span>
  </div>
  <h3 class="product-card__name">{product.name}</h3>
  <p class="product-card__tagline">{product.tagline}</p>
  <p class="product-card__description">{product.description}</p>

  {product.visual && (
    <VisualEvidence
      src={product.visual.src}
      alt={product.visual.alt}
      caption={product.visual.caption ?? ''}
      state={product.visual.state}
    />
  )}

  {product.videoUrl && (
    <>
      <div class="product-card__video" data-video-facade data-video-src={product.videoUrl}>
        {product.videoPoster ? (
          <button
            type="button"
            class="video-facade"
            aria-label={`Play video: ${product.name} public preview`}
            data-video-title={`${product.name} public preview video`}
          >
            <img
              src={product.videoPoster}
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span class="video-facade__scrim" aria-hidden="true"></span>
            <span class="video-facade__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" focusable="false"><path d="M8 5v14l11-7z"></path></svg>
            </span>
            <span class="video-facade__meta" aria-hidden="true">
              <span class="video-facade__title">{product.name} — public preview</span>
              <span class="video-facade__source">Video · loads from YouTube on play</span>
            </span>
          </button>
        ) : (
          <iframe
            src={product.videoUrl}
            title={`${product.name} public preview video`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        )}
      </div>
      <p class="product-card__visual-note">Public preview video; this is the current product evidence for the prerelease build. The embed loads only after you choose to play it.</p>
    </>
  )}

  <div class="product-card__meta">
    {product.platform.length > 0 && (
      <span class="product-card__platform">{product.platform.join(' / ')}</span>
    )}
    {displayVersion && <span class="product-card__version">{displayVersion}</span>}
  </div>
  <div class="product-card__actions">
    {product.downloadUrl && (
      <a href={product.downloadUrl} class="btn btn-primary">
        Download {product.name}
      </a>
    )}
    {product.upgradeUrl && (
      <a href={product.upgradeUrl} class="btn btn-outline">
        Upgrade & Licensing <span aria-hidden="true">→</span>
      </a>
    )}
    {product.purchaseUrl && <a href={product.purchaseUrl} class="btn btn-outline">Purchase</a>}
    {product.docsUrl && <a href={product.docsUrl} class="text-link">Documentation <span aria-hidden="true">→</span></a>}
    {product.releaseNotesUrl && <a href={product.releaseNotesUrl} class="text-link">Release Notes <span aria-hidden="true">→</span></a>}
  </div>
  </article>

<script>
  // Video facade: the third-party embed loads only when the visitor presses
  // play — better first paint, and no Google requests before that choice.
  // The click is the play gesture, so the loaded player starts with the video
  // the visitor asked for; nothing plays on its own.
  const installFacades = (root: Document | Element) => {
    root.querySelectorAll('[data-video-facade]').forEach((wrapper) => {
      const button = wrapper.querySelector('button');
      if (!button) return;
      button.addEventListener('click', () => {
        const src = wrapper.getAttribute('data-video-src');
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.src = src + (src.includes('?') ? '&' : '?') + 'autoplay=1';
        iframe.title = button.getAttribute('data-video-title') || 'Product video';
        // autoplay must be granted here because the facade URL requests it;
        // the click above is still the only gesture that creates the player.
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', '');
        wrapper.replaceChildren(iframe);
      }, { once: true });
    });
  };
  installFacades(document);
</script>

<style>
  .product-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding: 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(145deg, rgba(14,22,35,.96), rgba(8,13,22,.96));
    box-shadow: var(--shadow-sm), inset 0 1px rgba(255,255,255,.035);
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .product-card::before { position: absolute; z-index: -1; inset: 0; background: radial-gradient(20rem circle at var(--card-x, 80%) var(--card-y, 10%), rgba(49,116,255,.16), transparent 55%), linear-gradient(rgba(100,150,235,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(100,150,235,.04) 1px, transparent 1px); background-size: auto, 30px 30px, 30px 30px; content: ''; opacity: .45; transition: opacity .25s ease; }
  .product-card:hover {
    border-color: var(--color-accent-secondary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .product-card:hover::before { opacity: .95; }
  .product-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .75rem;
  }
  .product-card__category {
    color: var(--color-accent);
    font: 700 .68rem/1 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .product-card__status {
    padding: .3rem .6rem;
    border-radius: 999px;
    font: 700 .65rem/1 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .product-card__status--released,
  .product-card__status--public-beta {
    color: #78ce9a;
    border: 1px solid rgba(120,206,154,.25);
    background: rgba(120,206,154,.08);
  }
  .product-card__status--coming-soon,
  .product-card__status--private-beta {
    color: var(--color-status-experimental);
    border: 1px solid rgba(233,186,97,.25);
    background: rgba(233,186,97,.08);
  }
  .product-card__status--free,
  .product-card__status--donation {
    color: var(--color-accent-secondary);
    border: 1px solid rgba(95,168,255,.2);
    background: rgba(95,168,255,.06);
  }
  .product-card__status--paid {
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }
  .product-card__status--unavailable {
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border);
  }
  .product-card__name {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -.02em;
    color: var(--color-text);
  }
  .product-card__tagline {
    margin: 0;
    color: var(--color-accent-secondary);
    font-size: .95rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .product-card__description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .92rem;
    line-height: 1.65;
  }
  .product-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    align-items: center;
    margin-top: .2rem;
  }
  .product-card__platform {
    color: var(--color-text-subtle);
    font: 700 .65rem/1 var(--font-mono);
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .product-card__version {
    color: var(--color-text-muted);
    font: 700 .65rem/1 var(--font-mono);
  }
  .product-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    align-items: center;
    margin-top: .4rem;
  }
  .product-card__video {
    margin-top: .4rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-sm);
  }
  /* The play-time iframe is created at runtime, so it never carries Astro's
     scoped attribute — style it through a global selector. */
  .product-card__video :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .video-facade {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
  }
  .video-facade img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .video-facade__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4,8,16,.06) 40%, rgba(4,8,16,.72));
    transition: background .2s ease;
  }
  .video-facade:hover .video-facade__scrim,
  .video-facade:focus-visible .video-facade__scrim { background: linear-gradient(180deg, rgba(4,8,16,.02) 30%, rgba(4,8,16,.8)); }
  .video-facade__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(214,233,255,.85);
    border-radius: 50%;
    background: rgba(12,26,54,.78);
    color: #eaf2ff;
    box-shadow: 0 0 22px rgba(47,107,255,.55);
    transition: transform .2s ease, background .2s ease;
  }
  .video-facade:hover .video-facade__play,
  .video-facade:focus-visible .video-facade__play { transform: translate(-50%, -50%) scale(1.07); background: rgba(23,52,110,.9); }
  .video-facade__play svg { margin-left: .14rem; }
  .video-facade__meta {
    position: absolute;
    left: .8rem;
    bottom: .7rem;
    display: grid;
    gap: .18rem;
    text-align: left;
  }
  .video-facade__title {
    color: #f2f6fc;
    font: 800 .82rem/1.25 var(--font-sans);
    letter-spacing: .01em;
    text-shadow: 0 1px 6px rgba(0,0,0,.7);
  }
  .video-facade__source {
    color: rgba(226,236,250,.82);
    font: 650 .62rem/1.3 var(--font-mono);
    letter-spacing: .05em;
  }
  .video-facade:focus-visible {
    outline: 2px solid var(--color-accent-bright);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-facade__scrim, .video-facade__play { transition: none; }
    .video-facade:hover .video-facade__play { transform: translate(-50%, -50%); }
  }
  .product-card__visual-note {
    margin: -.2rem 0 0;
    color: var(--color-text-subtle);
    font: .68rem/1.45 var(--font-mono);
  }
</style>
