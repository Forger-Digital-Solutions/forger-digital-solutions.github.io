---
/**
 * We The People signature composition: the source trace.
 *
 * A question becomes a plain-language answer, and the answer stays connected
 * to what makes it trustworthy — the official source, the jurisdiction, and
 * the relevant service. Renders the same canonical copy that used to flow
 * through the generic H2/paragraph template; claims stay single-sourced in
 * projects.ts (which also feeds Kayla's knowledge corpus).
 */
import type { Project } from '../../types';
import { getSection } from '../../lib/signature';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const understandSection = getSection(project, 'Understand Public Information');
const sourcesSection = getSection(project, 'Official Sources');
const servicesSection = getSection(project, 'Services & Resources');
const claritySection = getSection(project, 'Accessibility & Clarity');
const neutralitySection = getSection(project, 'Neutrality');

const sourceItems = servicesSection.items ?? [];
---

<section class="sig-trace" aria-labelledby="wtp-trace-title">
  <p class="sig-kicker">SYSTEM // SOURCE TRACEABILITY</p>
  <h2 id="wtp-trace-title" class="sig-title">From question to source</h2>
  <p class="sig-intro">{understandSection.body}</p>

  <div class="sig-trace__grid">
    <div class="sig-trace__path">
      <article class="sig-trace__node sig-trace__node--q">
        <p class="sig-trace__label">01 // The question</p>
        <h3 class="sig-trace__name">Dense, scattered public information</h3>
        <p class="sig-trace__text">{project.problem}</p>
      </article>

      <p class="sig-trace__link" aria-hidden="true">
        <span class="sig-trace__link-line"></span>
        <span class="sig-trace__link-tag">Plain language</span>
        <span class="sig-trace__link-line"></span>
      </p>

      <article class="sig-trace__node sig-trace__node--a">
        <p class="sig-trace__label">02 // The answer</p>
        <h3 class="sig-trace__name">An understandable next step</h3>
        <p class="sig-trace__text">{claritySection.body}</p>
      </article>
    </div>

    <div class="sig-trace__sources">
      <p class="sig-trace__sources-title">The answer stays traceable to</p>
      <ul class="sig-trace__trail">
        <li class="sig-trace__source">
          <p class="sig-trace__source-label">Official source</p>
          <p class="sig-trace__text">{sourcesSection.body}</p>
        </li>
        <li class="sig-trace__source">
          <p class="sig-trace__source-label">Jurisdiction</p>
          <p class="sig-trace__text">The boundaries between local, state, and federal information stay visible.</p>
        </li>
        <li class="sig-trace__source">
          <p class="sig-trace__source-label">Relevant service</p>
          <p class="sig-trace__text">{sourceItems.slice(1).join('. ')}.</p>
        </li>
      </ul>
    </div>
  </div>

  <aside class="sig-trace__neutral" aria-label="Neutrality commitment">
    <span class="sig-trace__neutral-mark" aria-hidden="true">◇</span>
    <p class="sig-trace__text">{neutralitySection.body}</p>
  </aside>
</section>

<style>
  .sig-trace {
    padding-top: 2.75rem;
    scroll-margin-top: 4.5rem;
  }
  .sig-kicker {
    margin: 0 0 .4rem;
    color: var(--color-text-subtle);
    font: 700 .68rem/1.3 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .sig-title {
    margin: 0 0 .8rem;
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
    font-weight: 750;
    letter-spacing: -.025em;
    color: var(--color-text);
  }
  .sig-intro {
    max-width: 46rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .sig-trace__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  /* Question → answer path */
  .sig-trace__node {
    padding: .95rem 1.05rem 1.05rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .sig-trace__node--a {
    border-color: color-mix(in srgb, var(--eco-color) 32%, var(--color-border));
  }
  .sig-trace__label {
    margin: 0 0 .45rem;
    color: var(--eco-color);
    font: 700 .64rem/1 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .sig-trace__name {
    margin: 0 0 .4rem;
    font-size: 1.02rem;
    font-weight: 750;
    letter-spacing: -.01em;
    color: var(--color-text);
  }
  .sig-trace__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .86rem;
    line-height: 1.6;
  }
  .sig-trace__link {
    display: flex;
    gap: .6rem;
    align-items: center;
    margin: 0;
    padding: .35rem 0 .35rem 1.05rem;
  }
  .sig-trace__link-line {
    flex: 0 0 1.1rem;
    height: 1px;
    background: color-mix(in srgb, var(--eco-color) 50%, transparent);
  }
  .sig-trace__link-tag {
    color: var(--color-text-subtle);
    font: 700 .62rem/1 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  /* Source trail: a verification rail the answer hangs from. */
  .sig-trace__sources {
    position: relative;
    padding: 1.15rem 1.15rem 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }
  .sig-trace__sources::before {
    content: '';
    position: absolute;
    top: 1.55rem;
    bottom: 1.35rem;
    left: .78rem;
    width: 1px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--eco-color) 55%, transparent), color-mix(in srgb, var(--eco-color) 18%, transparent));
  }
  .sig-trace__sources-title {
    margin: 0 0 .8rem;
    color: var(--color-text-subtle);
    font: 700 .64rem/1 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .sig-trace__trail {
    display: grid;
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sig-trace__source {
    position: relative;
  }
  .sig-trace__source::before {
    content: '';
    position: absolute;
    top: .3rem;
    left: -1.02rem;
    width: .5rem;
    height: .5rem;
    border: 1px solid color-mix(in srgb, var(--eco-color) 65%, transparent);
    border-radius: 50%;
    background: var(--color-bg-secondary);
  }
  .sig-trace__source-label {
    margin: 0 0 .25rem;
    color: var(--color-text);
    font: 700 .74rem/1.4 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  /* Neutrality: a commitment, not a decoration — lighter than the privacy
     block that follows so the two asides don't read as duplicates. */
  .sig-trace__neutral {
    display: flex;
    gap: .7rem;
    align-items: flex-start;
    max-width: 46rem;
    margin-top: 1.75rem;
    padding: .15rem 0 .15rem 1rem;
    border-left: 2px solid color-mix(in srgb, var(--eco-color) 55%, transparent);
  }
  .sig-trace__neutral-mark {
    color: var(--eco-color);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .sig-trace__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
