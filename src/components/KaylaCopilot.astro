---
---

<div id="kayla-root">
  <button
    id="kayla-launcher"
    class="kayla-launcher"
    type="button"
    aria-label="Open Kayla Copilot"
    aria-expanded="false"
    aria-controls="kayla-panel"
  >
    <span class="kayla-launcher__icon" aria-hidden="true">K</span>
    <span class="kayla-launcher__tooltip">Kayla Copilot</span>
  </button>

  <aside
    id="kayla-panel"
    class="kayla-panel"
    hidden
    role="dialog"
    aria-label="Kayla Copilot chat"
    aria-modal="true"
  >
    <div class="kayla-panel__header">
      <div class="kayla-panel__title">
        <span class="kayla-panel__name">Kayla Copilot</span>
        <span class="kayla-panel__subtitle">The Forger Digital Solutions Copilot</span>
      </div>
      <div class="kayla-panel__status" role="status" aria-live="polite">
        <span class="kayla-status-dot" aria-hidden="true"></span>
        <span class="kayla-status-text">Online</span>
      </div>
      <button class="kayla-close" type="button" aria-label="Close Kayla Copilot">&times;</button>
    </div>

    <div id="kayla-conversation" class="kayla-conversation" aria-live="polite" aria-relevant="additions text" tabindex="0"></div>

    <div id="kayla-starters" class="kayla-starters">
      <button class="kayla-starter" type="button" data-query="Where should I start?">Where should I start?</button>
      <button class="kayla-starter" type="button" data-query="What can I use now?">What can I use now?</button>
      <button class="kayla-starter" type="button" data-query="Explore the projects">Explore the projects</button>
      <button class="kayla-starter" type="button" data-query="Learn about GEMS">Learn about GEMS</button>
      <button class="kayla-starter" type="button" data-query="Try CodeForge">Try CodeForge</button>
      <button class="kayla-starter" type="button" data-query="Support FDS">Support FDS</button>
    </div>

    <div class="kayla-input-row">
      <label for="kayla-input" class="kayla-input-label">Ask Kayla</label>
      <input
        id="kayla-input"
        class="kayla-input"
        type="text"
        placeholder="Ask about FDS..."
        autocomplete="off"
        maxlength="2000"
      />
      <button id="kayla-send" class="kayla-send" type="button" aria-label="Send message">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
        </svg>
      </button>
    </div>
  </aside>
</div>

<script>
  import { initKaylaCopilot } from './KaylaCopilot';
  initKaylaCopilot();
</script>

<style is:global>
  /* is:global is required, not stylistic: every message bubble, action
     button, source link, and regenerated starter is created at runtime by
     KaylaCopilot.ts via document.createElement, so none of them ever carry
     the data-astro-cid attribute Astro's scoping relies on. A scoped block
     here silently matches nothing on any dynamically created element —
     confirmed live: action buttons rendered as unstyled default <button>s
     and message bubbles had no background, padding, or radius at all.
     Class names are kayla-* and used nowhere else in the site, so global
     scope carries no collision risk. */
  .kayla-launcher {
    position: fixed;
    z-index: 9000;
    right: 1.25rem;
    bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    padding: .7rem 1.1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-accent);
    color: #f5f7fa;
    font: 800 .78rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: transform .2s ease, opacity .2s ease, border-color .2s ease;
  }
  .kayla-launcher:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent-hover);
  }
  .kayla-launcher:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .kayla-launcher--hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1rem);
  }
  .kayla-launcher__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgba(255,255,255,.18);
    font-size: .82rem;
  }
  .kayla-launcher__tooltip {
    display: none;
  }
  @media (min-width: 480px) {
    .kayla-launcher__tooltip {
      display: inline;
    }
  }

  .kayla-panel {
    position: fixed;
    z-index: 9001;
    right: 1.25rem;
    bottom: 5rem;
    width: min(100vw - 2.5rem, 26rem);
    max-height: min(70vh, 38rem);
    /* Dynamic viewport units track the on-screen keyboard and collapsing
       browser chrome where supported; the vh line above remains the fallback.
       Phase 13: composer must stay reachable when the visual viewport shrinks
       to keyboard-open heights. */
    max-height: min(70dvh, 38rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(1.2rem) scale(.97);
    pointer-events: none;
    transition: opacity .25s ease, transform .25s ease;
  }
  .kayla-panel--open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .kayla-panel[hidden] {
    display: none;
  }

  .kayla-panel__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .kayla-panel__title {
    display: flex;
    flex-direction: column;
    gap: .15rem;
    flex: 1 1 auto;
    min-width: 0;
  }
  .kayla-panel__name {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -.01em;
  }
  .kayla-panel__subtitle {
    color: var(--color-text-subtle);
    font: 700 .68rem/1.2 var(--font-mono);
    letter-spacing: .04em;
  }
  .kayla-panel__status {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font: 700 .68rem/1 var(--font-mono);
  }
  .kayla-status-dot {
    display: inline-block;
    width: .5rem;
    height: .5rem;
    border-radius: 50%;
    background: #63a8ff;
  }
  .kayla-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    transition: color .2s ease, border-color .2s ease;
  }
  .kayla-close:hover {
    color: var(--color-text);
    border-color: var(--color-accent-secondary);
  }

  .kayla-conversation {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: .8rem;
    overscroll-behavior: contain;
  }

  .kayla-msg {
    max-width: 92%;
    padding: .7rem .9rem;
    border-radius: var(--radius-md);
    font-size: .92rem;
    line-height: 1.55;
  }
  .kayla-msg--user {
    align-self: flex-end;
    background: var(--color-accent);
    color: #f5f7fa;
    border-bottom-right-radius: .25rem;
  }
  .kayla-msg--kayla {
    align-self: flex-start;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-bottom-left-radius: .25rem;
  }
  .kayla-msg__text {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .kayla-msg__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .6rem;
  }

  .kayla-action-btn {
    padding: .45rem .7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-accent-secondary);
    font: 700 .72rem/1 var(--font-mono);
    letter-spacing: .04em;
    cursor: pointer;
    transition: background .2s ease, border-color .2s ease, color .2s ease;
  }
  .kayla-action-btn:hover {
    background: rgba(95,168,255,.1);
    border-color: var(--color-accent-secondary);
    color: var(--color-text);
  }

  .kayla-msg__sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem;
    margin-top: .55rem;
    padding-top: .5rem;
    border-top: 1px dashed var(--color-border);
  }
  .kayla-msg__sources-label {
    color: var(--color-text-subtle);
    font: 700 .64rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .kayla-source-link,
  .kayla-source-text {
    color: var(--color-text-muted);
    font: 600 .72rem/1.3 var(--font-mono);
    letter-spacing: .01em;
  }
  .kayla-source-link {
    text-decoration: underline;
    text-underline-offset: .15em;
    text-decoration-color: var(--color-border-strong);
    transition: color .2s ease;
  }
  .kayla-source-link:hover,
  .kayla-source-link:focus-visible {
    color: var(--color-accent-secondary);
  }

  .kayla-starters {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    padding: .6rem 1rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .kayla-starter {
    padding: .45rem .7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-secondary);
    color: var(--color-text-muted);
    font: 700 .72rem/1 var(--font-mono);
    letter-spacing: .03em;
    cursor: pointer;
    transition: border-color .2s ease, color .2s ease, background .2s ease;
  }
  .kayla-starter:hover {
    border-color: var(--color-accent-secondary);
    color: var(--color-text);
    background: rgba(95,168,255,.08);
  }

  .kayla-input-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .7rem 1rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    padding-bottom: max(.7rem, env(safe-area-inset-bottom));
  }
  .kayla-input-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .kayla-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: .6rem .75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: .92rem;
    outline: none;
    transition: border-color .2s ease;
  }
  .kayla-input::placeholder {
    color: var(--color-text-subtle);
  }
  .kayla-input:focus {
    border-color: var(--color-accent-secondary);
  }
  .kayla-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #f5f7fa;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  .kayla-stop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .5rem .8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-accent-secondary);
    color: #f5f7fa;
    font: 700 .72rem/1 var(--font-mono);
    letter-spacing: .04em;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  .kayla-stop:hover {
    background: var(--color-accent);
    transform: translateY(-1px);
  }
  .kayla-msg--streaming .kayla-msg__text::after {
    content: '▋';
    animation: kayla-blink 1s infinite;
    opacity: .7;
  }
  @keyframes kayla-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @media (max-width: 480px) {
    .kayla-panel {
      right: 0;
      bottom: 0;
      left: 0;
      width: 100vw;
      max-height: min(85vh, 38rem);
      max-height: min(85dvh, 38rem);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border-bottom: 0;
    }
    .kayla-launcher {
      right: 1rem;
      bottom: 1rem;
    }
  }

  /* Keyboard-open / short viewports (Phase 13): the transcript and the
     composer win. The subtitle and the starter-chip row are progressive
     enhancement — hiding them keeps the composer reachable when the visual
     viewport collapses. The !important on starters beats the inline
     display:flex the controller sets after each answer. */
  @media (max-height: 28rem) {
    .kayla-panel__subtitle {
      display: none;
    }
    .kayla-panel__header {
      flex-wrap: nowrap;
      padding: .6rem .8rem;
    }
    .kayla-starters {
      display: none !important;
    }
    .kayla-conversation {
      padding: .7rem;
      gap: .6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kayla-launcher,
    .kayla-panel,
    .kayla-close,
    .kayla-send,
    .kayla-starter,
    .kayla-action-btn,
    .kayla-msg--streaming .kayla-msg__text::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
    .kayla-msg--streaming .kayla-msg__text::after {
      opacity: .7;
    }
  }
</style>
