---
import type { Project } from '../types';
import ProjectStatus from './ProjectStatus.astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;

// Map ecosystem names to display colors and icons
const ecosystemConfig: Record<string, { display: string; color: string }> = {
  'Intelligence': { display: 'INTELLIGENCE', color: '#4f8fff' },
  'Gaming': { display: 'GAMING', color: '#b487ff' },
  'Publishing': { display: 'PUBLISHING', color: '#d9813f' },
  'Civic': { display: 'CIVIC', color: '#8792a8' },
  'Foraging': { display: 'FORAGING', color: '#76b77d' }
};

const eco = project.ecosystem ? ecosystemConfig[project.ecosystem] : null;
const isFlagship = project.flagship || featured;

// Flagship badge must reflect this project's actual maturity, not a fixed
// string — CodeForge (RELEASED) and GEMS (RESEARCH) are both flagship
// projects but are not the same kind of thing.
const flagshipBadge: Record<string, string> = {
  RELEASED: 'Flagship Release',
  RESEARCH: 'Flagship Research',
  'ACTIVE DEVELOPMENT': 'Flagship Product',
  'PRIVATE DEVELOPMENT': 'Flagship Product',
  'PREVIEW / BETA': 'Flagship Preview',
  CONCEPT: 'Flagship Concept'
};
const badgeLabel = flagshipBadge[project.status] ?? 'Flagship';
---

<article 
  class:list={['project-card', { 'project-card--flagship': isFlagship }]} 
  id={project.id} 
  style={`--project-accent: ${project.accentColor || 'var(--color-accent)'};--eco-color: ${eco?.color || project.accentColor}`}
>
  <div class="project-card__orbit" aria-hidden="true"></div>
  
  <div class="project-card__header">
    <div class="project-card__meta">
      {eco && (
        <span class="project-card__ecosystem" data-ecosystem={project.ecosystem?.toLowerCase()}>
          {eco.display}
        </span>
      )}
    </div>
    <ProjectStatus status={project.status} />
  </div>
  
  <div class="project-card__body">
    <div class="project-card__identity">
      {isFlagship && <span class="project-card__badge">{badgeLabel}</span>}
      <h3 class="project-card__title">
        <a href={`/projects/${project.slug}`}>{project.name}</a>
      </h3>
    </div>
    
    <p class="project-card__summary">{project.summary}</p>
    
    {project.audience && (
      <p class="project-card__audience">
        <span class="audience-label">Built for</span>
        <span class="audience-text">{project.audience.split(',')[0]}</span>
      </p>
    )}
  </div>
  
  <div class="project-card__footer">
    <div class="project-card__capabilities">
      {project.tags.slice(0, 3).map((tag) => (
        <span class="capability-chip">{tag}</span>
      ))}
    </div>
    
    <a class="project-card__link" href={`/projects/${project.slug}`}>
      <span>Explore</span>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M4 2.5L9.5 7L4 11.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 19rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(155deg, 
      color-mix(in srgb, var(--eco-color) 6%, rgba(14,21,33,.97)) 0%, 
      rgba(9,14,23,.97) 55%);
    box-shadow: var(--shadow-sm);
    transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  
  .project-card::before {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      var(--eco-color), 
      color-mix(in srgb, var(--eco-color) 30%, transparent) 65%, 
      transparent);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    content: '';
  }
  
  .project-card:hover {
    border-color: color-mix(in srgb, var(--eco-color) 55%, var(--color-border));
    box-shadow: var(--shadow-md), 0 0 32px color-mix(in srgb, var(--eco-color) 8%, transparent);
    transform: translateY(-3px);
  }
  
  .project-card--flagship {
    grid-column: span 2;
    min-height: 20rem;
  }

  /* Subtle orbital decoration */
  .project-card__orbit {
    position: absolute;
    top: .75rem;
    right: .75rem;
    width: 4rem;
    height: 4rem;
    border: 1px solid color-mix(in srgb, var(--eco-color) 15%, transparent);
    border-radius: 50%;
    opacity: .4;
  }
  
  .project-card__orbit::before {
    position: absolute;
    inset: .5rem;
    border: 1px solid color-mix(in srgb, var(--eco-color) 12%, transparent);
    border-radius: inherit;
    content: '';
  }
  
  .project-card__orbit::after {
    position: absolute;
    top: 50%;
    right: -.4rem;
    left: -.4rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--eco-color) 20%, transparent), transparent);
    content: '';
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: .5rem;
    margin-bottom: .8rem;
  }
  
  .project-card__meta {
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }
  
  .project-card__ecosystem {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    width: fit-content;
    padding: .28rem .5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--eco-color) 12%, transparent);
    color: var(--eco-color);
    font: 700 .6rem/1 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  
  .project-card__ecosystem::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 4px currentColor;
  }

  .project-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-card__identity {
    margin-bottom: .6rem;
  }
  
  .project-card__badge {
    display: inline-block;
    margin-bottom: .45rem;
    padding: .22rem .45rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--eco-color) 15%, transparent);
    color: var(--eco-color);
    font: 700 .58rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .project-card__title {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -.02em;
  }
  
  .project-card__title a {
    color: var(--color-text);
    transition: color .2s ease;
  }
  
  .project-card__title a:hover {
    color: var(--eco-color);
  }

  .project-card__summary {
    flex: 1;
    margin: 0 0 .8rem;
    color: var(--color-text-muted);
    font-size: .88rem;
    line-height: 1.6;
  }
  
  /* Limit summary to 3 lines */
  .project-card__summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__audience {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .35rem;
    margin: 0 0 .5rem;
    color: var(--color-text-muted);
    font-size: .78rem;
    line-height: 1.4;
  }
  
  .audience-label {
    color: var(--color-text-subtle);
    font: 650 .65rem/1 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  
  .audience-text {
    color: var(--color-text-muted);
  }

  .project-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .6rem;
    margin-top: auto;
    padding-top: .8rem;
    border-top: 1px solid rgba(255,255,255,.04);
  }

  .project-card__capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: .3rem;
  }
  
  .capability-chip {
    padding: .28rem .5rem;
    border-radius: 999px;
    background: rgba(255,255,255,.035);
    color: var(--color-text-muted);
    font: 600 .62rem/1 var(--font-mono);
    letter-spacing: .03em;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--color-text);
    font: 700 .72rem/1 var(--font-mono);
    letter-spacing: .05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color .2s ease;
  }
  
  .project-card__link svg {
    color: var(--eco-color);
    transition: transform .2s ease;
  }
  
  .project-card__link:hover {
    color: var(--eco-color);
  }
  
  .project-card__link:hover svg {
    transform: translateX(2px);
  }
  
  .project-card__link:focus-visible {
    outline: 2px solid var(--eco-color);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Responsive */
  @media (max-width: 760px) {
    .project-card--flagship {
      grid-column: auto;
    }
    .project-card {
      min-height: 0;
    }
  }
  
  @media (max-width: 480px) {
    .project-card__capabilities {
      display: none;
    }
    .project-card__link {
      flex: 1;
      justify-content: flex-end;
    }
    /* Truncate long audience text on very small screens */
    .project-card__audience {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
  
  /* Scroll margin for anchor navigation - accounts for sticky header (~60px) */
  .project-card {
    scroll-margin-top: 4.5rem;
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
    .project-card:hover {
      transform: none;
    }
    .project-card__link svg {
      transition: none;
    }
    .project-card__link:hover svg {
      transform: none;
    }
  }
</style>
