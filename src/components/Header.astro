---
import { siteConfig } from '../config/site';
const { githubUrl, supportUrl } = siteConfig;
---
<nav class="navbar" aria-label="Main navigation">
  <div class="nav-container">
    <a href="/" class="logo" aria-label="Forger Digital Solutions home">
      <img src="/images/brand/fds-logo.png" width="44" height="44" alt="" />
      <span class="logo-text">FDS</span>
    </a>
    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-navigation"><span class="hamburger"></span></button>
    <ul class="nav-links" id="site-navigation">
      <li><a href="/projects">Projects</a></li><li><a href="/lab">Lab</a></li><li><a href="/technology">Technology</a></li><li><a href="/certifications">Certifications</a></li><li><a href="/about">About</a></li>
      {githubUrl && <li><a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>}
      <li><a href={supportUrl} target="_blank" rel="noopener noreferrer" class="support-btn">Support FDS</a></li>
    </ul>
  </div>
</nav>
<style>
  .navbar { position: sticky; top: 0; z-index: 100; display: flex; justify-content: center; padding: .7rem 1.25rem; border-bottom: 1px solid var(--color-border); background: rgba(9,10,12,.88); backdrop-filter: blur(14px); }.nav-container { display: flex; align-items: center; justify-content: space-between; width: min(100%, var(--content-wide)); }.logo { display: inline-flex; align-items: center; gap: .55rem; color: var(--color-text); }.logo img { width: 2.25rem; height: 2.25rem; object-fit: contain; }.logo-text { font: 800 .95rem/1 var(--font-mono); letter-spacing: .12em; }.nav-links { display: flex; align-items: center; gap: .95rem; margin: 0; padding: 0; list-style: none; }.nav-links a { color: var(--color-text-muted); font-size: .82rem; }.nav-links a:hover { color: var(--color-text); opacity: 1; }.nav-links .support-btn { padding: .5rem .7rem; border-radius: var(--radius-sm); background: var(--color-accent); color: #15100b; font-size: .72rem; font-weight: 800; }.mobile-menu-btn { display: none; padding: .6rem; border: 0; background: transparent; color: var(--color-text); }.hamburger, .hamburger::before, .hamburger::after { display: block; width: 1.45rem; height: 2px; background: currentColor; content: ''; }.hamburger { position: relative; }.hamburger::before { position: absolute; top: -.45rem; }.hamburger::after { position: absolute; top: .45rem; }
  @media (max-width: 860px) { .mobile-menu-btn { display: block; }.nav-links { position: fixed; top: 4.35rem; right: 1rem; left: 1rem; display: grid; gap: 0; padding: .6rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-bg-secondary); box-shadow: var(--shadow-md); opacity: 0; transform: translateY(-1rem); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }.nav-links.active { opacity: 1; transform: translateY(0); pointer-events: auto; }.nav-links li, .nav-links a { display: block; }.nav-links a { padding: .75rem; }.nav-links .support-btn { margin-top: .25rem; text-align: center; } }
</style>
<script>
  const mobileBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn'); const navLinks = document.querySelector('.nav-links');
  const closeMenu = () => { mobileBtn?.setAttribute('aria-expanded', 'false'); navLinks?.classList.remove('active'); };
  mobileBtn?.addEventListener('click', () => { const open = mobileBtn.getAttribute('aria-expanded') === 'true'; mobileBtn.setAttribute('aria-expanded', String(!open)); navLinks?.classList.toggle('active', !open); });
  navLinks?.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) closeMenu(); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
</script>
