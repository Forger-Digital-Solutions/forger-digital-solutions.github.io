---
import { siteConfig } from '../config/site';
const { githubUrl } = siteConfig;
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);

/** Company-first navigation: what we build, what we research, what ships. */
const primaryNav = [
  { label: 'Products', href: '/projects' },
  { label: 'AI Research', href: '/projects/gems-training-grounds' },
  { label: 'Releases', href: '/forged' },
  { label: 'Engineering', href: '/lab' },
  { label: 'Company', href: '/about' },
];

/** Full access preserved on mobile via the secondary menu block. */
const secondaryNav = [
  { label: 'Engineering Log', href: '/notes' },
  { label: 'Technology', href: '/technology' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Support', href: '/support' },
];
---
<nav class="navbar" aria-label="Main navigation">
  <div class="nav-container">
    <a href="/" class="logo" aria-label="Forger Digital Solutions home">
      <img src="/images/brand/fds-logo.png" width="44" height="44" alt="" />
      <span class="logo-system">Forger Digital Solutions</span>
    </a>
    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-navigation"><span class="hamburger"></span></button>
     <ul class="nav-links" id="site-navigation">
       {primaryNav.map((item) => <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      <li class="nav-actions">
        {githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="nav-github" aria-label="FDS on GitHub"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>}
        <a href="/forged" class="cta-btn">Get CodeForge</a>
      </li>
      <li class="nav-secondary">
        <p class="nav-secondary__label" id="nav-secondary-label">More</p>
        <ul aria-labelledby="nav-secondary-label">
          {secondaryNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </li>
    </ul>
  </div>
</nav>
<style>
  .navbar { position: sticky; top: 0; z-index: 100; display: flex; justify-content: center; padding: .62rem 1.25rem; border-bottom: 1px solid rgba(158,187,232,.14); background: linear-gradient(180deg, rgba(5,9,16,.91), rgba(5,9,16,.76)); box-shadow: 0 12px 35px rgba(0,0,0,.18); backdrop-filter: blur(20px) saturate(130%); }.navbar::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 1px; background: linear-gradient(90deg, transparent 6%, rgba(42,107,244,.5) 36%, rgba(198,212,233,.16) 62%, transparent 94%); content: ''; }.nav-container { display: flex; align-items: center; justify-content: space-between; width: min(100%, var(--content-wide)); }.logo { display: inline-flex; align-items: center; gap: .48rem; color: var(--color-text); }.logo img { width: 2.35rem; height: 2.35rem; object-fit: contain; filter: drop-shadow(0 0 11px rgba(40,103,237,.28)); }.logo-system { max-width: 7.2rem; padding-left: .52rem; border-left: 1px solid var(--color-border-strong); color: var(--color-text-subtle); font: 650 .5rem/1.35 var(--font-mono); letter-spacing: .11em; text-transform: uppercase; }.nav-links { display: flex; align-items: center; gap: .18rem; margin: 0; padding: 0; list-style: none; }.nav-links > li > a:not(.cta-btn) { position: relative; display: inline-flex; padding: .62rem .55rem; color: var(--color-text-muted); font-size: .76rem; font-weight: 650; }.nav-links > li > a:not(.cta-btn)::after { position: absolute; right: .55rem; bottom: .2rem; left: .55rem; height: 1px; background: var(--color-accent-bright); content: ''; opacity: 0; transform: scaleX(.25); transition: opacity .2s ease, transform .2s ease; }.nav-links > li > a:not(.cta-btn):hover, .nav-links > li > a[aria-current='page']:not(.cta-btn) { color: var(--color-text); opacity: 1; }.nav-links > li > a:not(.cta-btn):hover::after, .nav-links > li > a[aria-current='page']:not(.cta-btn)::after { opacity: 1; transform: scaleX(1); }
  .nav-actions { display: flex; align-items: center; gap: .3rem; margin-left: .35rem; padding-left: .55rem; border-left: 1px solid var(--color-border); }.nav-github { display: inline-flex; padding: .38rem; color: var(--color-text-subtle); }.nav-github:hover { color: var(--color-accent-bright); }
  .nav-links .cta-btn { margin-left: .1rem; padding: .58rem .8rem; border: 1px solid rgba(103,157,255,.32); border-radius: var(--radius-sm); background: linear-gradient(135deg, #153fae, #2558d4); color: #f5f7fa; font-size: .69rem; font-weight: 800; box-shadow: 0 7px 22px rgba(26,79,210,.2); }
  .nav-secondary { display: none; }
  .mobile-menu-btn { display: none; padding: .7rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: rgba(255,255,255,.025); color: var(--color-text); }.hamburger, .hamburger::before, .hamburger::after { display: block; width: 1.35rem; height: 2px; background: currentColor; content: ''; transition: transform .2s ease, top .2s ease, opacity .2s ease; }.hamburger { position: relative; }.hamburger::before { position: absolute; top: -.42rem; }.hamburger::after { position: absolute; top: .42rem; }.mobile-menu-btn[aria-expanded='true'] .hamburger { background: transparent; }.mobile-menu-btn[aria-expanded='true'] .hamburger::before { top: 0; transform: rotate(45deg); }.mobile-menu-btn[aria-expanded='true'] .hamburger::after { top: 0; transform: rotate(-45deg); }
  @media (max-width: 1100px) { .mobile-menu-btn { display: block; }.nav-links { position: fixed; top: 4.25rem; right: 1rem; left: 1rem; display: grid; gap: 0; max-height: calc(100dvh - 5rem); overflow-y: auto; padding: .7rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); background: rgba(7,12,21,.97); box-shadow: var(--shadow-md); opacity: 0; transform: translateY(-1rem); backdrop-filter: blur(22px); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }.nav-links.active { opacity: 1; transform: translateY(0); pointer-events: auto; }.nav-links li, .nav-links a { display: block; }.nav-links > li > a:not(.cta-btn) { padding: .8rem; }.nav-links > li > a:not(.cta-btn)::after { right: .8rem; bottom: .35rem; left: .8rem; }.nav-links .cta-btn { margin: .35rem 0 0; text-align: center; }.nav-actions { display: flex; justify-content: center; gap: 1.4rem; margin: .35rem 0; padding: .5rem 0; border: 0; border-top: 1px solid var(--color-border); }.nav-github { display: inline-flex; padding: .5rem; }
    .nav-secondary { display: block; margin-top: .4rem; padding: .6rem 0 .2rem; border-top: 1px solid var(--color-border); }.nav-secondary__label { margin: 0 0 .2rem; color: var(--color-text-subtle); font: 700 .58rem/1.4 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }.nav-secondary ul { display: grid; margin: 0; padding: 0; list-style: none; }.nav-secondary a { display: block; padding: .55rem .8rem; color: var(--color-text-muted); font-size: .8rem; font-weight: 650; }.nav-secondary a:hover { color: var(--color-text); } }
  @media (min-width: 1101px) { .nav-secondary { display: none !important; } }
  @media (max-width: 520px) { .logo img { width: 2.1rem; height: 2.1rem; }.logo-system { max-width: 6.3rem; padding-left: .42rem; font-size: .44rem; } }
</style>
<script>
  const mobileBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn'); const navLinks = document.querySelector('.nav-links');
  const closeMenu = () => { mobileBtn?.setAttribute('aria-expanded', 'false'); navLinks?.classList.remove('active'); };
  mobileBtn?.addEventListener('click', () => { const open = mobileBtn.getAttribute('aria-expanded') === 'true'; mobileBtn.setAttribute('aria-expanded', String(!open)); navLinks?.classList.toggle('active', !open); });
  navLinks?.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) closeMenu(); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
</script>
