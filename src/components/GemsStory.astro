---
/**
 * Homepage GEMS teaser: a concise statement, one visual that already identifies
 * all four lineages plus Training Grounds, a compact status strip, and a route
 * into the full page. Per-GEM depth (state, learning journey, affordability)
 * deliberately lives only in GemsDeep on the GEMS project page — repeating the
 * four lineages again as cards here duplicated what the visual already shows.
 */
import SectionHeader from './SectionHeader.astro';
import VisualEvidence from './VisualEvidence.astro';
import { visualAssets } from '../data/visuals';

const statusStrip = ['From-Scratch Research', 'Training Grounds', 'Held-Out Evaluation', 'Advancement by Evidence'];
---

<section class="gems-story page-section" aria-labelledby="gems-story-title">
  <SectionHeader
    eyebrow="Inside GEMS"
    title="Four roles. One deliberate learning program."
    description="GEMS develops a family of specialized models while Training Grounds supplies curriculum, trials, evaluation, and advancement checkpoints."
  />

  <p class="gems-story__why">
    GEMS remains the original, longer-horizon effort to develop FDS-specific model intelligence through its own from-scratch research
    and learning process. Every lineage advances rung by rung inside Training Grounds, and no capability is claimed until evidence supports it.
  </p>

  <div class="gems-story__evidence">
    <VisualEvidence {...visualAssets.gemsFamily} />
  </div>

  <ul class="gems-story__status" role="list">
    {statusStrip.map((item) => <li>{item}</li>)}
  </ul>

  <div class="gems-story__cta">
    <a class="btn btn-primary" href="/projects/gems-training-grounds">Explore GEMS / Training Grounds <span aria-hidden="true">→</span></a>
    <p class="gems-story__more">The full page covers each lineage's research status, the learning journey, and what is not yet claimed.</p>
  </div>
</section>

<style>
  .gems-story { position: relative; }
  .gems-story__why { max-width: 48rem; margin: 0 0 1.6rem; color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.7; }

  .gems-story__status { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.4rem 0 0; padding: 0; list-style: none; }
  .gems-story__status li { padding: .45rem .75rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font: 700 .68rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }

  .gems-story__cta { display: flex; flex-wrap: wrap; gap: .9rem 1.4rem; align-items: center; margin-top: 1.6rem; }
  .gems-story__more { max-width: 26rem; margin: 0; color: var(--color-text-subtle); font-size: .88rem; line-height: 1.6; }

  @media (max-width: 520px) {
    .gems-story__why { font-size: .98rem; }
  }
</style>
