---
interface Props {
  src: string;
  mobileSrc?: string;
  alt: string;
  label: string;
  caption?: string;
  eager?: boolean;
  aspect?: '16/9' | '21/9' | '4/3';
}

const { src, mobileSrc, alt, label, caption, eager = false, aspect = '16/9' } = Astro.props;
---

<figure class="specimen-media">
  <div class={`specimen-media__frame specimen-media__frame--${aspect.replace('/', '-')}`}>
    <picture>
      {mobileSrc && <source media="(max-width: 760px)" srcset={mobileSrc} type="image/webp" />}
      <img
        src={src}
        alt={alt}
        width="1600"
        height="893"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding={eager ? 'sync' : 'async'}
      />
    </picture>
  </div>
  <figcaption class="specimen-media__meta">
    <span class="specimen-media__tag">{label}</span>
    {caption && <span class="specimen-media__caption">{caption}</span>}
  </figcaption>
</figure>

<style>
  .specimen-media {
    margin: 0;
  }

  .specimen-media__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border-structural);
    border-radius: var(--radius-md);
    background: var(--color-recessed);
    box-shadow: var(--surface-highlight);
  }

  .specimen-media__frame--16-9 {
    aspect-ratio: 16 / 9;
  }

  .specimen-media__frame--21-9 {
    aspect-ratio: 21 / 9;
  }

  .specimen-media__frame--4-3 {
    aspect-ratio: 4 / 3;
  }

  .specimen-media__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .specimen-media__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-top: 0.65rem;
  }

  .specimen-media__tag {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .specimen-media__caption {
    color: var(--color-text-subtle);
    font-size: 0.8rem;
    line-height: 1.45;
  }
</style>
