---
/**
 * Signature GEMS learning-system visual for the homepage.
 *
 * Replaces the former static four-box SVG with a live architecture: Training
 * Grounds as a central learning core, a seven-stage cycle (Curriculum → Teach
 * → Test → Diagnose → Refine → Verify → Advance) rendered as a segmented ring
 * around it, and the four GEM lineages connected as system nodes with slow
 * bidirectional data pulses. Stage labels, lineage names, and roles are real
 * HTML (lineages come from the canonical data module); the SVG carries only
 * decorative geometry and is aria-hidden.
 *
 * Responsive by structure, not scale: below 640px the square diagram becomes
 * a vertical system stack (lineage → core → numbered stage list) instead of a
 * shrunken desktop image.
 */
import { gems } from '../data/gems';

const STAGES = ['Curriculum', 'Teach', 'Test', 'Diagnose', 'Refine', 'Verify', 'Advance'] as const;
const STEP = 360 / 7;
const CYCLE_S = 7.7; // one full learning cycle; each stage holds the ring for 1.1s

const rad = (deg: number) => (deg * Math.PI) / 180;
const pt = (deg: number, r: number) => [500 + r * Math.cos(rad(deg)), 500 + r * Math.sin(rad(deg))] as const;
const arc = (a0: number, a1: number, r: number) => {
  const [x0, y0] = pt(a0, r);
  const [x1, y1] = pt(a1, r);
  return `M ${x0.toFixed(1)} ${y0.toFixed(1)} A ${r} ${r} 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
};

// Stage labels sit inside the ring band, close to the core-facing edge, so the
// larger lineage modules and their connectors never obscure the readable cycle.
const stages = STAGES.map((label, i) => {
  const mid = -90 + i * STEP;
  const left = 50 + 17.5 * Math.cos(rad(mid));
  const top = 50 + 17.5 * Math.sin(rad(mid));
  return { label, left, top, delay: i * (CYCLE_S / 7), num: String(i + 1).padStart(2, '0') };
});

const ringSegs = STAGES.map((_, i) => {
  const mid = -90 + i * STEP;
  return arc(mid - STEP / 2 + 2.8, mid + STEP / 2 - 2.8, 252);
});

const calTicks = Array.from({ length: 16 }, (_, k) => {
  const a = k * 22.5;
  const [x0, y0] = pt(a, 281);
  const [x1, y1] = pt(a, 292);
  return { d: `M ${x0.toFixed(1)} ${y0.toFixed(1)} L ${x1.toFixed(1)} ${y1.toFixed(1)}`, major: k % 4 === 0 };
});

// Fixed, sparse instrumentation points — decorative, deterministic, quiet.
const fieldPoints = [
  { x: 96, y: 120, r: 2 }, { x: 210, y: 74, r: 1.4 }, { x: 806, y: 96, r: 1.6 },
  { x: 918, y: 176, r: 2.2 }, { x: 62, y: 812, r: 1.8 }, { x: 148, y: 916, r: 1.3 },
  { x: 872, y: 886, r: 2 }, { x: 942, y: 768, r: 1.4 }, { x: 500, y: 34, r: 1.4 }, { x: 500, y: 968, r: 1.4 }
];

const gemColors: Record<string, string> = {
  topaz: '#e9ba61',
  sapphire: '#6fa3ff',
  peridot: '#58c9a2',
  garnet: '#c18cff'
};

const gemPalettes: Record<string, { light: string; mid: string; deep: string; edge: string }> = {
  topaz: { light: '#fff1b7', mid: '#e9ba61', deep: '#a85e22', edge: '#5e3115' },
  sapphire: { light: '#d5f1ff', mid: '#6fa3ff', deep: '#2751cc', edge: '#152b72' },
  peridot: { light: '#efffb1', mid: '#92d84a', deep: '#3f9b4b', edge: '#214c32' },
  garnet: { light: '#ffd4f5', mid: '#c18cff', deep: '#963d9e', edge: '#4a205e' }
};
---

<figure class="gems-system" data-visual-candidate="reactor-pipeline">
  <div class="gems-system__frame">
    <p class="gems-system__hud" aria-hidden="true">
      <span>GEMS // TRAINING GROUNDS</span>
      <span>LEARNING CYCLE // ACTIVE</span>
    </p>

    <div class="gems-stage">
      <svg class="gems-ambient" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
        <g class="gems-art__field">
          {fieldPoints.map((p) => <circle cx={p.x} cy={p.y} r={p.r}></circle>)}
        </g>
        <circle class="gems-art__calib" cx="500" cy="500" r="286"></circle>
        <g class="gems-art__ticks">
          {calTicks.map((t) => <path d={t.d} class:list={[{ 'tick--major': t.major }]}></path>)}
        </g>
      </svg>

      <svg class="gems-conduits" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
        <g class="gems-art__connectors">
          <!-- Every conduit starts at its lineage module's visible port and
               ends at one explicit Training Grounds reactor port. -->
          <path class="gems-art__connector gems-art__connector--topaz" data-conduit-for="topaz" d="M 500 205 L 500 236"></path>
          <path class="gems-art__connector gems-art__connector--sapphire" data-conduit-for="sapphire" d="M 205 500 L 236 500"></path>
          <path class="gems-art__connector gems-art__connector--peridot" data-conduit-for="peridot" d="M 795 500 L 764 500"></path>
          <path class="gems-art__connector gems-art__connector--garnet" data-conduit-for="garnet" d="M 500 795 L 500 764"></path>
          <path class="gems-art__conduit-ticks gems-art__conduit-ticks--topaz" data-conduit-ticks-for="topaz" d="M494 212h12m-12 8h12m-12 8h12"></path>
          <path class="gems-art__conduit-ticks gems-art__conduit-ticks--sapphire" data-conduit-ticks-for="sapphire" d="M212 494v12m8-12v12m8-12v12"></path>
          <path class="gems-art__conduit-ticks gems-art__conduit-ticks--peridot" data-conduit-ticks-for="peridot" d="M788 494v12m-8-12v12m-8-12v12"></path>
          <path class="gems-art__conduit-ticks gems-art__conduit-ticks--garnet" data-conduit-ticks-for="garnet" d="M494 788h12m-12-8h12m-12-8h12"></path>
          <circle class="gems-art__port gems-art__port--topaz" data-conduit-endpoint="topaz" cx="500" cy="236" r="5"></circle>
          <circle class="gems-art__port gems-art__port--sapphire" data-conduit-endpoint="sapphire" cx="236" cy="500" r="5"></circle>
          <circle class="gems-art__port gems-art__port--peridot" data-conduit-endpoint="peridot" cx="764" cy="500" r="5"></circle>
          <circle class="gems-art__port gems-art__port--garnet" data-conduit-endpoint="garnet" cx="500" cy="764" r="5"></circle>
        </g>
      </svg>

      <svg class="gems-mobile-conduits" viewBox="0 0 400 640" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="gems-art__connector gems-art__connector--topaz" data-conduit-for="topaz" d="M 160 112 L 110 160"></path>
        <path class="gems-art__connector gems-art__connector--sapphire" data-conduit-for="sapphire" d="M 240 112 L 290 160"></path>
        <path class="gems-art__connector gems-art__connector--peridot" data-conduit-for="peridot" d="M 150 112 C 92 174 20 248 20 294 L 110 318"></path>
        <path class="gems-art__connector gems-art__connector--garnet" data-conduit-for="garnet" d="M 250 112 C 308 174 380 248 380 294 L 290 318"></path>
      </svg>

      <svg class="gems-art" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="gemsCore" cx="50%" cy="42%" r="65%">
            <stop stop-color="#1b3158"></stop>
            <stop offset="0.62" stop-color="#101d38"></stop>
            <stop offset="1" stop-color="#0a1426"></stop>
          </radialGradient>
          <marker id="gems-stage-arrow" markerWidth="7" markerHeight="7" refX="5.6" refY="3.5" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M1 1 6 3.5 1 6" fill="none" stroke="#a7c4ff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
          </marker>
        </defs>

        <g class="gems-art__ring">
          {ringSegs.map((d) => <path d={d} marker-end="url(#gems-stage-arrow)"></path>)}
        </g>
        <g class="gems-art__ring-glow">
          {ringSegs.map((d, i) => <path d={d} marker-end="url(#gems-stage-arrow)" style={`animation-delay: ${stages[i].delay}s`}></path>)}
        </g>
        <path class="gems-art__sweep" d={ringSegs[0]} marker-end="url(#gems-stage-arrow)"></path>

        <circle class="gems-art__track" cx="500" cy="500" r="222"></circle>
        <circle class="gems-art__core" cx="500" cy="500" r="140"></circle>
      </svg>

      <div class="gems-core-wrap">
        <div class="gems-core">
          <svg class="gems-core__facets" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <path d="M100 8 164 31 190 100 164 169 100 192 36 169 10 100 36 31Z"></path>
            <path d="M100 8 100 52 164 31 M100 52 190 100 143 100 164 169 M100 52 57 100 36 31 M57 100 10 100 36 169 100 192 M57 100 100 52 143 100 100 148 57 100Z"></path>
            <path d="M100 148 100 192 M143 100 190 100 M57 100 36 169 M100 52 100 8"></path>
            <path d="M100 52 143 100 100 148 57 100Z M100 74 126 100 100 126 74 100Z M57 100 100 100 M100 52 100 148"></path>
            <circle cx="100" cy="52" r="2.6"></circle><circle cx="143" cy="100" r="2.6"></circle>
            <circle cx="100" cy="148" r="2.6"></circle><circle cx="57" cy="100" r="2.6"></circle>
          </svg>
          <span class="gems-core__index" aria-hidden="true">TG / 07</span>
          <span class="gems-core__name">Training Grounds</span>
          <span class="gems-core__sub">Learning program</span>
          <span class="gems-core__gate">Evidence-gated advancement</span>
        </div>

      </div>

      <ul class="gems-nodes" role="list" aria-label="GEMS research lineages">
        {gems.map((gem, index) => (
          <li class="gems-node" data-gem={gem.key} data-research-state={gem.state} tabindex="0" aria-labelledby={`${gem.key}-name`} aria-describedby={`${gem.key}-role ${gem.key}-state`} style={`--gem-color:${gemColors[gem.key] ?? 'var(--color-accent-bright)'};--gem-facet:url(#gem-${gem.key}-facet);--gem-shade:url(#gem-${gem.key}-shade)`}>
            <span class="gems-node__port" data-gem-port={gem.key} aria-hidden="true"></span>
            <svg class="gems-node__gemstone" data-gem-core={gem.key} viewBox="0 0 120 132" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id={`gem-${gem.key}-facet`} x1="0" y1="0" x2="1" y2="1">
                  <stop stop-color={gemPalettes[gem.key]?.light ?? '#dce8ff'}></stop>
                  <stop offset="0.48" stop-color={gemPalettes[gem.key]?.mid ?? '#6fa3ff'}></stop>
                  <stop offset="1" stop-color={gemPalettes[gem.key]?.deep ?? '#152b72'}></stop>
                </linearGradient>
                <linearGradient id={`gem-${gem.key}-shade`} x1="0" y1="0" x2="0.8" y2="1">
                  <stop stop-color={gemPalettes[gem.key]?.mid ?? '#6fa3ff'}></stop>
                  <stop offset="1" stop-color={gemPalettes[gem.key]?.edge ?? '#152b72'}></stop>
                </linearGradient>
              </defs>
              <circle class="gems-node__compute-ring" cx="60" cy="66" r="54"></circle>
              <circle class="gems-node__compute-ring gems-node__compute-ring--inner" cx="60" cy="66" r="47"></circle>
              <path class="gems-node__micro-ticks" d="M60 2v8 M60 122v8 M0 66h8 M112 66h8 M18 24l6 6 M96 102l6 6 M102 24l-6 6 M24 102l-6 6"></path>
              <circle class="gems-node__compute-node" cx="60" cy="7" r="2.3"></circle>
              <circle class="gems-node__compute-node" cx="113" cy="66" r="2.3"></circle>
              <circle class="gems-node__compute-node" cx="60" cy="125" r="2.3"></circle>
              <circle class="gems-node__compute-node" cx="7" cy="66" r="2.3"></circle>
              <polygon class="gems-node__facet gems-node__facet--crown" points="28,39 43,28 60,23 77,28 92,39 78,52 60,57 42,52"></polygon>
              <polygon class="gems-node__facet gems-node__facet--left" points="28,39 42,52 60,57 51,91 39,83"></polygon>
              <polygon class="gems-node__facet gems-node__facet--center" points="42,52 60,57 78,52 69,94 60,108 51,94"></polygon>
              <polygon class="gems-node__facet gems-node__facet--right" points="78,52 92,39 81,83 69,91"></polygon>
              <polygon class="gems-node__facet gems-node__facet--pavilion" points="39,83 51,91 60,108 69,91 81,83 60,118"></polygon>
              <path class="gems-node__gem-outline" d="M28 39 43 28 60 23 77 28 92 39 81 83 60 118 39 83Z M28 39 60 57 92 39 M39 83 60 57 81 83 M60 57 60 108"></path>
            </svg>
            <span class="gems-node__index">TG-L0{index + 1}</span>
            <span class="gems-node__name" id={`${gem.key}-name`}>{gem.name}</span>
            <span class="gems-node__role" id={`${gem.key}-role`}>{gem.role}</span>
            <span class="gems-node__state" id={`${gem.key}-state`}><span aria-hidden="true"></span>{gem.state}</span>
          </li>
        ))}
      </ul>

      <ol class="gems-cycle" aria-label="Training Grounds learning cycle">
        {stages.map((stage, i) => (
          <li
            data-stage={i + 1}
            style={`--d: ${stage.delay}s; left: ${stage.left.toFixed(2)}%; top: ${stage.top.toFixed(2)}%;`}
          >
            <span class="gems-cycle__num" aria-hidden="true">{stage.num}</span>
            <span class="gems-cycle__label">{stage.label}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <figcaption class="gems-system__caption">
    <span class="gems-system__state">Conceptual diagram</span>
    <span class="gems-system__text">
      GEMS learning system: one shared Training Grounds program runs a seven-stage cycle; four independent lineages advance only when evidence supports it.
    </span>
  </figcaption>
</figure>

<script is:inline>
  (() => {
    const el = document.querySelector('.gems-system');
    if (!el || !('IntersectionObserver' in window)) return;
    const requestedCandidate = new URLSearchParams(window.location.search).get('gems');
    if (['neural-lattice', 'reactor-pipeline'].includes(requestedCandidate || '')) {
      el.setAttribute('data-visual-candidate', requestedCandidate);
    }
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          el.removeAttribute('data-gems-paused');
        } else {
          el.setAttribute('data-gems-paused', '');
        }
      });
    }, { rootMargin: '100px 0px 100px 0px', threshold: 0.02 });
    obs.observe(el);
  })();
</script>

<style>
  .gems-system { margin: 0; }
  .gems-system[data-gems-paused] .gems-art__sweep,
  .gems-system[data-gems-paused] .gems-cycle li,
  :global([data-bg-paused]) .gems-system .gems-art__sweep,
  :global([data-bg-paused]) .gems-system .gems-cycle li { animation-play-state: paused; }

  .gems-system__frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 1rem 1.4rem 1.3rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: #070b12;
    box-shadow: var(--shadow-md), inset 0 1px rgba(255,255,255,.04);
  }
  .gems-system__frame::before {
    position: absolute; z-index: 6; top: 1.05rem; left: 1.4rem;
    width: .45rem; height: .45rem; border-radius: 50%;
    background: var(--color-status-experimental); content: '';
  }
  .gems-system__frame::after {
    position: absolute; z-index: 6; inset: .55rem;
    border: 1px solid rgba(111,163,255,.08); border-radius: var(--radius-md);
    content: ''; pointer-events: none;
  }
  .gems-system__hud {
    position: relative; z-index: 6; display: flex; justify-content: space-between;
    gap: 1rem; margin: 0 0 .4rem; padding-left: .9rem;
    color: var(--color-text-subtle); font: 700 .62rem/1.4 var(--font-mono);
    letter-spacing: .13em;
  }
  .gems-stage {
    position: relative; isolation: isolate; width: min(100%, 40rem);
    aspect-ratio: 1; margin: 0 auto;
  }
  .gems-ambient, .gems-conduits, .gems-mobile-conduits, .gems-art {
    position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;
  }
  .gems-ambient { z-index: 1; }
  .gems-conduits, .gems-mobile-conduits { z-index: 2; }
  .gems-mobile-conduits { display: none; }
  .gems-art { z-index: 3; }
  .gems-art__field circle { fill: rgba(148,183,255,.12); }
  .gems-art__calib { fill: none; stroke: rgba(111,163,255,.055); stroke-width: 1; stroke-dasharray: 1 9; }
  .gems-art__ticks path { stroke: rgba(148,183,255,.1); stroke-width: 1; }
  .gems-art__ticks .tick--major { stroke: rgba(148,183,255,.18); stroke-width: 1.4; }

  .gems-art__connector {
    fill: none; stroke: rgba(132,158,205,.72); stroke-width: 1.6;
    vector-effect: non-scaling-stroke; transition: stroke .18s ease, stroke-width .18s ease;
  }
  .gems-art__conduit-ticks {
    fill: none; stroke: rgba(178,202,241,.62); stroke-width: 1.35;
    stroke-linecap: round; vector-effect: non-scaling-stroke;
    transition: stroke .18s ease, opacity .18s ease;
  }
  .gems-art__port { fill: #a7c4ff; stroke: #070b12; stroke-width: 2; transition: fill .18s ease; }
  .gems-art__ring path { fill: none; stroke: rgba(75,105,165,.72); stroke-width: 11; stroke-linecap: butt; }
  .gems-art__sweep {
    display: block; fill: none; stroke: #9fc0ff; stroke-width: 11; stroke-linecap: butt;
    transform-box: view-box; transform-origin: 500px 500px; animation: gemsStageSweep 7.7s linear infinite;
  }
  @keyframes gemsStageSweep { to { transform: rotate(360deg); } }
  .gems-art__track { fill: none; stroke: rgba(111,163,255,.12); stroke-width: 1; stroke-dasharray: 2 7; }
  .gems-art__core { fill: url(#gemsCore); stroke: rgba(145,182,247,.36); stroke-width: 1.2; }

  /* Training Grounds stays the processor at the center of the seven-stage cycle. */
  .gems-core-wrap { position: absolute; inset: 0; z-index: 3; width: 35%; aspect-ratio: 1; margin: auto; }
  .gems-core {
    position: absolute; inset: 0; isolation: isolate;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .28rem; padding: 8%; overflow: hidden; text-align: center;
    clip-path: polygon(50% 0,82% 9%,100% 34%,100% 66%,82% 91%,50% 100%,18% 91%,0 66%,0 34%,18% 9%);
    background: linear-gradient(145deg,rgba(22,42,76,.98),rgba(7,14,27,.99) 72%);
  }
  .gems-core__facets { position: absolute; z-index: 0; inset: 4%; width: 92%; height: 92%; color: #91b4f5; fill: rgba(115,157,231,.045); stroke: currentColor; stroke-width: 1; opacity: .3; pointer-events: none; }
  .gems-core__facets path:nth-child(2) { fill: none; stroke-opacity: .42; }
  .gems-core__facets path:nth-child(3) { fill: none; stroke-opacity: .28; }
  .gems-core__facets path:nth-child(4) { fill: none; stroke-opacity: .38; }
  .gems-core__facets circle { fill: currentColor; stroke: none; }
  .gems-core__index, .gems-core__name, .gems-core__sub, .gems-core__gate { position: relative; z-index: 1; padding: 0 .2rem; background: rgba(7,14,27,.76); }
  .gems-core__index { color: #a7c4ff; font: 750 clamp(.48rem,.86vw,.58rem)/1 var(--font-mono); letter-spacing: .2em; }
  .gems-core__name { color: var(--color-text); font-size: clamp(.8rem,1.65vw,1.02rem); font-weight: 800; line-height: 1.12; text-wrap: balance; }
  .gems-core__sub { color: #a7c4ff; font: 700 clamp(.5rem,1vw,.58rem)/1 var(--font-mono); letter-spacing: .17em; text-transform: uppercase; }
  .gems-core__gate { color: var(--color-text-subtle); font: 650 clamp(.46rem,.9vw,.54rem)/1.35 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }

  /* Stage labels sit above ambient artwork and remain real, readable text. */
  .gems-cycle { position: absolute; inset: 0; z-index: 5; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .gems-cycle li {
    position: absolute; display: flex; align-items: center; gap: .3rem;
    transform: translate(-50%,-50%); color: #c3d2ec;
    font: 700 clamp(.55rem,1.15vw,.66rem)/1 var(--font-mono);
    letter-spacing: .075em; text-transform: uppercase; white-space: nowrap;
    animation: gemsLabelLight 7.7s linear infinite; animation-delay: var(--d,0s);
  }
  @keyframes gemsLabelLight { 0% { color:#93a5c6 } 6% { color:#eaf2ff } 30%,100% { color:#93a5c6 } }
  .gems-cycle__num {
    display: inline-flex; flex: none; align-items: center; justify-content: center;
    width: 1.12rem; height: 1.12rem; border: 1px solid rgba(146,180,239,.56);
    border-radius: 50%; color: #d6e4ff; font-size: .56rem; line-height: 1;
  }

  /* Each lineage is a floating cut-stone compute core with a local technical rail.
     Corner marks and an oval scrim protect its gem and text without a card shell. */
  .gems-nodes { display: contents; }
  .gems-node {
    position: absolute; z-index: 4; isolation: isolate;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .08rem; width: 25%; height: 25%; box-sizing: border-box; padding: 0 .25rem;
    border: 0; background: none; box-shadow: none; text-align: center;
    outline: none;
  }
  .gems-node::before {
    position: absolute; z-index: -1; inset: 0;
    background:
      linear-gradient(var(--gem-color),var(--gem-color)) left top/15px 1px,
      linear-gradient(var(--gem-color),var(--gem-color)) left top/1px 15px,
      linear-gradient(var(--gem-color),var(--gem-color)) right top/15px 1px,
      linear-gradient(var(--gem-color),var(--gem-color)) right top/1px 15px,
      linear-gradient(var(--gem-color),var(--gem-color)) left bottom/15px 1px,
      linear-gradient(var(--gem-color),var(--gem-color)) left bottom/1px 15px,
      linear-gradient(var(--gem-color),var(--gem-color)) right bottom/15px 1px,
      linear-gradient(var(--gem-color),var(--gem-color)) right bottom/1px 15px;
    background-repeat: no-repeat; opacity: .48; content: ''; pointer-events: none;
    transition: opacity .18s ease;
  }
  .gems-node::after {
    position: absolute; z-index: -2; inset: -8% -12%;
    background: radial-gradient(ellipse,rgba(7,11,18,.99) 0%,rgba(7,11,18,.96) 56%,rgba(7,11,18,0) 100%);
    content: ''; pointer-events: none;
  }
  .gems-node__gemstone { display: block; flex: none; width: 5rem; height: 5.45rem; max-width: 90%; overflow: visible; color: var(--gem-color); }
  .gems-node__compute-ring { fill: none; stroke: var(--gem-color); stroke-width: .8; stroke-opacity: .3; stroke-dasharray: 1.5 4; transition: stroke-opacity .18s ease; }
