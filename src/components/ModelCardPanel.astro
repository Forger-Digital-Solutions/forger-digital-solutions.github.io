---
import StatusPill from './StatusPill.astro';
import { availabilityDisplayLabels, type PublicRegistryEntry } from '../data/registry';

interface Props {
  entry: PublicRegistryEntry;
  showLink?: boolean;
}

const { entry, showLink = true } = Astro.props;
---

<article class="model-card" data-accent={entry.accent} data-category={entry.category} data-status={entry.development_status}>
  <header class="model-card__head">
    <div>
      <p class="model-card__division">{entry.division} · {entry.version}</p>
      <h3 class="model-card__name">
        {showLink ? <a href={entry.route}>{entry.name}</a> : entry.name}
      </h3>
    </div>
    <StatusPill status={entry.development_status} />
  </header>

  <p class="model-card__summary">{entry.public_summary}</p>

  <dl class="model-card__meta">
    {entry.base_architecture && (
      <div>
        <dt>Base Architecture &amp; Provenance</dt>
        <dd>{entry.base_architecture}</dd>
      </div>
    )}
    {entry.parameter_count && (
      <div>
        <dt>Parameter Scale</dt>
        <dd>{entry.parameter_count}</dd>
      </div>
    )}
    <div>
      <dt>Public Availability</dt>
      <dd>{availabilityDisplayLabels[entry.availability]}</dd>
    </div>
    {entry.modalities && entry.modalities.length > 0 && (
      <div>
        <dt>Target Modalities</dt>
        <dd>{entry.modalities.join(' · ')}</dd>
      </div>
    )}
    {entry.license_info && (
      <div>
        <dt>License / Terms</dt>
        <dd>{entry.license_info}</dd>
      </div>
    )}
    <div>
      <dt>Last Verified</dt>
      <dd><time datetime={entry.last_verified}>{entry.last_verified}</time></dd>
    </div>
  </dl>

  <div class="model-card__boundaries">
    <div>
      <h4>Known Limitations</h4>
      <ul>
        {entry.known_limitations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h4>Explicit Non-Claims</h4>
      <ul>
        {entry.non_claims.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  {showLink && (
    <footer class="model-card__foot">
      <a class="text-link" href={entry.route}>
        Open full specification <span aria-hidden="true">→</span>
      </a>
      <span class="model-card__evidence">Evidence: {entry.public_evidence}</span>
    </footer>
  )}
</article>

<style>
  .model-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border-structural);
    border-top: 2px solid var(--page-accent, var(--color-accent-bright));
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: var(--surface-highlight);
  }

  .model-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .model-card__division {
    margin: 0;
    color: var(--page-accent, var(--color-text-subtle));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .model-card__name {
    margin: 0.3rem 0 0;
    font-size: 1.4rem;
    letter-spacing: -0.025em;
  }

  .model-card__name a {
    color: var(--color-text);
  }

  .model-card__name a:hover {
    color: var(--page-accent, var(--color-accent-bright));
  }

  .model-card__summary {
    max-width: 54rem;
    margin: 0.85rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .model-card__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 1.1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .model-card__meta dt {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .model-card__meta dd {
    margin: 0.25rem 0 0;
    color: var(--color-text);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .model-card__boundaries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.1rem;
  }

  .model-card__boundaries h4 {
    margin: 0 0 0.45rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .model-card__boundaries ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.58;
  }

  .model-card__boundaries li + li {
    margin-top: 0.3rem;
  }

  .model-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .model-card__evidence {
    color: var(--color-text-subtle);
    font-size: 0.78rem;
  }

  @media (max-width: 820px) {
    .model-card__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .model-card__boundaries {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .model-card__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
