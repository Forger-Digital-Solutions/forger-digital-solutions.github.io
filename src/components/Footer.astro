---
/**
 * The footer is company navigation, not a content section: products first,
 * research and engineering next, company and legal last. Social links moved
 * here from the header; builder/hosting credit lives in a small colophon.
 */
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();

const columns: { title: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    title: 'Products',
    links: [
      { label: 'CodeForge', href: '/projects/codeforge' },
      { label: 'ForgerEMS', href: '/projects/forgerems' },
      { label: 'KyraBlox', href: '/projects/kyrablox' },
      { label: 'Kayla Publisher', href: '/projects/kayla-ai-publisher' },
      { label: 'We The People', href: '/projects/we-the-people' },
      { label: 'FarmStand Finder', href: '/projects/farmstand-finder' },
    ],
  },
  {
    title: 'AI / Research',
    links: [
      { label: 'GEMS', href: '/projects/gems-training-grounds' },
      { label: 'Training Grounds', href: '/projects/gems-training-grounds#training-grounds' },
      { label: 'Engineering', href: '/lab' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Community Impact', href: '/community-impact' },
      { label: 'Support', href: '/support' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { label: 'GitHub', href: siteConfig.githubUrl, external: true },
      { label: 'Releases', href: '/forged' },
      { label: 'Engineering Log', href: '/notes' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Use', href: '/terms' },
    ],
  },
];
---
<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <p class="footer-kicker"><span></span> FDS NETWORK // ACTIVE</p>
      <h2 class="footer-logo"><span>F</span><span>D</span><span>S</span></h2>
      <p class="footer-description">
        An independent AI and software company based in New Jersey. Real products where they are ready;
        transparent research where they are not.
      </p>
      <ul class="footer-social" aria-label="FDS on other platforms">
        <li><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
        <li><a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        {siteConfig.tiktokUrl && <li><a href={siteConfig.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a></li>}
      </ul>
    </div>

    {columns.map((column) => (
      <nav class="footer-links" aria-label={column.title}>
        <h3>{column.title}</h3>
        <ul>
          {column.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="footer-bottom">
    <p class="footer-system-line">FORGER DIGITAL SOLUTIONS // AI SYSTEMS, SOFTWARE ENGINEERING, DEVELOPER TOOLS</p>
    <p class="footer-colophon">&copy; {currentYear} Forger Digital Solutions <span class="footer-colophon__detail">(site: Astro, GitHub Pages)</span></p>
  </div>
</footer>

<style>
.footer {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(10,16,27,.94), #05080e);
  border-top: 1px solid var(--color-border);
  margin-top: 3rem;
  padding: 2.25rem 0 1.5rem;
}
.footer::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(104,149,230,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(104,149,230,.045) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, #000, transparent 75%); content: ''; pointer-events: none; }

.footer-container {
  position: relative;
  /* Same centered measure as .site-main — the footer must never run flush to
     the viewport edge on wide screens. */
  width: min(calc(100% - 2.5rem), var(--content-width));
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) repeat(5, minmax(0, 1fr));
  gap: 1.5rem 1.6rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
}
.footer-kicker { display: flex; align-items: center; gap: .5rem; margin: 0 0 .85rem; color: var(--color-accent-bright); font: 700 .62rem/1 var(--font-mono); letter-spacing: .13em; }.footer-kicker span { width: .42rem; height: .42rem; border-radius: 50%; background: var(--color-accent-bright); box-shadow: 0 0 12px rgba(87,150,255,.8); animation: footer-pulse 3s ease-in-out infinite; }

.footer-logo {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0 0 .6rem;
  color: var(--color-silver);
  letter-spacing: .14em;
}
.footer-logo span:nth-child(1), .footer-logo span:nth-child(3) { color: var(--color-accent-bright); }

.footer-description {
  max-width: 24rem;
  margin: 0;
  color: var(--color-text-muted);
  font-size: 0.83rem;
  line-height: 1.55;
}

.footer-social { display: flex; flex-wrap: wrap; gap: .3rem .9rem; margin: .9rem 0 0; padding: 0; list-style: none; }
.footer-social a { color: var(--color-text-subtle); font-size: .78rem; }
.footer-social a:hover { color: var(--color-text); }

.footer-links h3 {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--color-text-subtle);
  margin: 0 0 .7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.footer-links ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 0.35rem;
}

.footer-links a {
  color: var(--color-text-muted);
  font-size: 0.83rem;
  transition: color 0.2s;
}

.footer-links a:hover {
  color: var(--color-text);
}

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem 1.5rem;
  align-items: baseline;
  justify-content: space-between;
  width: min(calc(100% - 2.5rem), var(--content-width));
  margin: .75rem auto 0;
  padding-top: 1rem;
  /* The Kayla launcher is fixed in the bottom-right corner. At the very end of
     the page it sat on top of the copyright line, so the last row keeps that
     corner clear rather than the whole footer growing to avoid it. */
  padding-inline-end: 14.5rem;
  margin-top: .75rem;
  border-top: 1px solid var(--color-border);
  color: var(--color-text-subtle);
  font-size: 0.72rem;
}
.footer-bottom p { margin: 0; }
.footer-system-line { color: var(--color-accent-bright); font: 650 .6rem/1.4 var(--font-mono); letter-spacing: .12em; }
.footer-colophon__detail { color: var(--color-text-subtle); opacity: .75; }
@keyframes footer-pulse { 50% { opacity: .42; box-shadow: 0 0 4px rgba(87,150,255,.4); } }

@media (max-width: 1150px) {
  .footer-container { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 700px) {
  .footer-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* Narrow screens cannot spare a 12rem gutter, so clear the launcher below. */
  .footer-bottom { padding-inline-end: 0; padding-bottom: 3.5rem; }
}
@media (max-width: 420px) {
  .footer-container { gap: 1.25rem 1.5rem; }
}
@media (prefers-reduced-motion: reduce) { .footer-kicker span { animation: none; } }
</style>
