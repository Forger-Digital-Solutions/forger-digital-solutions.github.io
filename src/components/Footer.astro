---
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';

const currentYear = new Date().getFullYear();
const featuredProjects = projects.filter(p => p.featured);
---
<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <h2 class="footer-logo">FDS</h2>
      <p class="footer-description">
        Independent software research and development focused on intelligent systems, 
        developer infrastructure, creative technology, and experimental computing.
      </p>
    </div>
    
    <div class="footer-links">
      <h3>Site</h3>
      <ul>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/forged">Forged</a></li>
        <li><a href="/lab">Lab</a></li>
        <li><a href="/notes">Notes</a></li>
        <li><a href="/technology">Technology</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/support">Support FDS</a></li>
        <li><a href="/support/hardware">Hardware Donations</a></li>
        <li><a href="/community-impact">Community Impact</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Connect</h3>
      <ul>
        <li><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
        <li><a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        {siteConfig.tiktokUrl && <li><a href={siteConfig.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a></li>}
        <li><a href={`mailto:${siteConfig.supportEmail}`}>Support Email</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Legal</h3>
      <ul>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
      </ul>
    </div>

    <div class="footer-featured">
      <h3>Featured Projects</h3>
      {featuredProjects.map(project => (
        <div class="footer-project">
          <a href={`/projects/${project.slug}`}>{project.name}</a>
          <span class="footer-status">{project.status}</span>
        </div>
      ))}
    </div>
  </div>
  
  <div class="footer-bottom">
    <p>&copy; {currentYear} Forger Digital Solutions. Built with Astro &bull; Hosted on GitHub Pages</p>
  </div>
</footer>

<style>
.footer {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  margin-top: 4rem;
  padding: 3rem 0 2rem;
}

.footer-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-border);
}

.footer-logo {
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  background: linear-gradient(180deg, #f2f4f7 0%, #aeb5c0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.footer-description {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

.footer-links h3 {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.footer-links ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 0.5rem;
}

.footer-links a {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  transition: color 0.2s;
}

.footer-links a:hover {
  color: var(--color-text);
}

.footer-project {
  margin-bottom: 0.75rem;
}

.footer-project a {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  transition: color 0.2s;
}

.footer-project a:hover {
  color: var(--color-text);
}

.footer-status {
  display: block;
  font-size: 0.7rem;
  margin-top: 0.25rem;
}

.footer-bottom {
  text-align: center;
  padding-top: 1.5rem;
  margin-top: 1rem;
  border-top: 1px solid var(--color-border);
  color: var(--color-text-muted);
  font-size: 0.75rem;
}

@media (max-width: 767px) {
  .footer-container {
    grid-template-columns: 1fr;
  }
}
</style>
