---
/**
 * The footer is navigation, not a content section. It previously carried a
 * Featured Projects column that restated links already reachable from Projects,
 * which on short pages made the footer compete with the page itself.
 */
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <p class="footer-kicker"><span></span> FDS NETWORK // ACTIVE</p>
      <h2 class="footer-logo"><span>F</span><span>D</span><span>S</span></h2>
      <p class="footer-description">
        Independent software and AI engineering across developer tools, model research,
        game creation, publishing, civic information, local discovery, and diagnostics.
      </p>
    </div>
    
    <div class="footer-links">
      <h3>Site</h3>
      <ul>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/forged">Forged</a></li>
        <li><a href="/lab">Lab</a></li>
        <li><a href="/notes">Notes</a></li>
        <li><a href="/technology">Technology</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/support">Support FDS</a></li>
        <li><a href="/support/hardware">Hardware Donations</a></li>
        <li><a href="/community-impact">Community Impact</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Connect</h3>
      <ul>
        <li><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
        <li><a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        {siteConfig.tiktokUrl && <li><a href={siteConfig.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a></li>}
        <li><a href={`mailto:${siteConfig.supportEmail}`}>Support Email</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Legal</h3>
      <ul>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
      </ul>
    </div>

  </div>
  
  <div class="footer-bottom">
    <p class="footer-system-line">FORGER DIGITAL SOLUTIONS // SOFTWARE, AI RESEARCH, AND PRACTICAL TOOLS</p>
    <p>&copy; {currentYear} Forger Digital Solutions. Built with Astro &bull; Hosted on GitHub Pages</p>
  </div>
</footer>

<style>
.footer {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(10,16,27,.94), #05080e);
  border-top: 1px solid var(--color-border);
  margin-top: 3rem;
  padding: 2.25rem 0 1.5rem;
}
.footer::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(104,149,230,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(104,149,230,.045) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, #000, transparent 75%); content: ''; pointer-events: none; }

.footer-container {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
  gap: 1.5rem 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
}
.footer-kicker { display: flex; align-items: center; gap: .5rem; margin: 0 0 .85rem; color: var(--color-accent-bright); font: 700 .62rem/1 var(--font-mono); letter-spacing: .13em; }.footer-kicker span { width: .42rem; height: .42rem; border-radius: 50%; background: var(--color-accent-bright); box-shadow: 0 0 12px rgba(87,150,255,.8); animation: footer-pulse 3s ease-in-out infinite; }

.footer-logo {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0 0 .6rem;
  color: var(--color-silver);
  letter-spacing: .14em;
}
.footer-logo span:nth-child(1), .footer-logo span:nth-child(3) { color: var(--color-accent-bright); }

.footer-description {
  max-width: 26rem;
  margin: 0;
  color: var(--color-text-muted);
  font-size: 0.83rem;
  line-height: 1.55;
}

.footer-links h3 {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-text-subtle);
  margin: 0 0 .7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.footer-links ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 0.35rem;
}

.footer-links a {
  color: var(--color-text-muted);
  font-size: 0.83rem;
  transition: color 0.2s;
}

.footer-links a:hover {
  color: var(--color-text);
}

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem 1.5rem;
  align-items: baseline;
  justify-content: space-between;
  padding-top: 1rem;
  /* The Kayla launcher is fixed in the bottom-right corner. At the very end of
     the page it sat on top of the copyright line, so the last row keeps that
     corner clear rather than the whole footer growing to avoid it. */
  padding-inline-end: 14.5rem;
  margin-top: .75rem;
  border-top: 1px solid var(--color-border);
  color: var(--color-text-subtle);
  font-size: 0.72rem;
}
.footer-bottom p { margin: 0; }
.footer-system-line { color: var(--color-accent-bright); font: 650 .6rem/1.4 var(--font-mono); letter-spacing: .12em; }
@keyframes footer-pulse { 50% { opacity: .42; box-shadow: 0 0 4px rgba(87,150,255,.4); } }

@media (max-width: 900px) {
  /* Two columns rather than one long stack: the link groups are short, so
     stacking them made the footer taller than most of the pages above it. */
  .footer-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .footer-brand { grid-column: 1 / -1; }
  /* Narrow screens cannot spare a 12rem gutter, so clear the launcher below. */
  .footer-bottom { padding-inline-end: 0; padding-bottom: 3.5rem; }
}
@media (max-width: 420px) {
  .footer-container { gap: 1.25rem 1.5rem; }
}
@media (prefers-reduced-motion: reduce) { .footer-kicker span { animation: none; } }
</style>
