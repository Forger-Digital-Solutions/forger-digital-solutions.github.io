---
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';

const currentYear = new Date().getFullYear();
const featuredProjects = projects.filter(p => p.featured);
---
<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <p class="footer-kicker"><span></span> FDS NETWORK // ACTIVE</p>
      <h2 class="footer-logo"><span>F</span><span>D</span><span>S</span></h2>
      <p class="footer-description">
        Independent software research and development focused on intelligent systems, 
        developer infrastructure, creative technology, and experimental computing.
      </p>
    </div>
    
    <div class="footer-links">
      <h3>Site</h3>
      <ul>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/forged">Forged</a></li>
        <li><a href="/lab">Lab</a></li>
        <li><a href="/notes">Notes</a></li>
        <li><a href="/technology">Technology</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/support">Support FDS</a></li>
        <li><a href="/support/hardware">Hardware Donations</a></li>
        <li><a href="/community-impact">Community Impact</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Connect</h3>
      <ul>
        <li><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
        <li><a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        {siteConfig.tiktokUrl && <li><a href={siteConfig.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a></li>}
        <li><a href={`mailto:${siteConfig.supportEmail}`}>Support Email</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Legal</h3>
      <ul>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
      </ul>
    </div>

    <div class="footer-featured">
      <h3>Featured Projects</h3>
      {featuredProjects.map(project => (
        <div class="footer-project">
          <a href={`/projects/${project.slug}`}>{project.name}</a>
          <span class="footer-status">{project.status}</span>
        </div>
      ))}
    </div>
  </div>
  
  <div class="footer-bottom">
    <p class="footer-system-line">FORGER DIGITAL SOLUTIONS // BUILDING SOFTWARE THAT LEARNS, ADAPTS, AND CREATES</p>
    <p>&copy; {currentYear} Forger Digital Solutions. Built with Astro &bull; Hosted on GitHub Pages</p>
  </div>
</footer>

<style>
.footer {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(10,16,27,.94), #05080e);
  border-top: 1px solid var(--color-border);
  margin-top: 4rem;
  padding: 3rem 0 2rem;
}
.footer::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(104,149,230,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(104,149,230,.045) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, #000, transparent 75%); content: ''; pointer-events: none; }

.footer-container {
  position: relative;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-border);
}
.footer-kicker { display: flex; align-items: center; gap: .5rem; margin: 0 0 .85rem; color: var(--color-accent-bright); font: 700 .62rem/1 var(--font-mono); letter-spacing: .13em; }.footer-kicker span { width: .42rem; height: .42rem; border-radius: 50%; background: var(--color-accent-bright); box-shadow: 0 0 12px rgba(87,150,255,.8); animation: footer-pulse 3s ease-in-out infinite; }

.footer-logo {
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--color-silver);
  letter-spacing: .14em;
}
.footer-logo span:nth-child(1), .footer-logo span:nth-child(3) { color: var(--color-accent-bright); }

.footer-description {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

.footer-links h3 {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-family: var(--font-mono);
}

.footer-links ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 0.5rem;
}

.footer-links a {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  transition: color 0.2s;
}

.footer-links a:hover {
  color: var(--color-text);
}

.footer-project {
  margin-bottom: 0.75rem;
}

.footer-project a {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  transition: color 0.2s;
}

.footer-project a:hover {
  color: var(--color-text);
}

.footer-status {
  display: block;
  font-size: 0.7rem;
  margin-top: 0.25rem;
}

.footer-bottom {
  text-align: center;
  padding-top: 1.5rem;
  margin-top: 1rem;
  border-top: 1px solid var(--color-border);
  color: var(--color-text-muted);
  font-size: 0.75rem;
}
.footer-system-line { margin: 0 0 .75rem; color: var(--color-accent-bright); font: 650 .62rem/1.4 var(--font-mono); letter-spacing: .12em; }
@keyframes footer-pulse { 50% { opacity: .42; box-shadow: 0 0 4px rgba(87,150,255,.4); } }

@media (max-width: 767px) {
  .footer-container {
    grid-template-columns: 1fr;
  }
}
@media (prefers-reduced-motion: reduce) { .footer-kicker span { animation: none; } }
</style>
