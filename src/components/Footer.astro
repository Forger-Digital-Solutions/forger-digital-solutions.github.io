---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();

const columns: { title: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    title: 'Models',
    links: [
      { label: 'Model Catalog', href: '/models/' },
      { label: 'Alexandrite', href: '/models/alexandrite/' },
      { label: 'Hackmanite', href: '/models/hackmanite/' },
      { label: 'Cinnabar', href: '/models/cinnabar/' },
      { label: 'Model Cards', href: '/model-cards/' },
      { label: 'Evaluations', href: '/evaluations/' },
    ],
  },
  {
    title: 'Products',
    links: [
      { label: 'Jaspilite', href: '/products/jaspilite/' },
      { label: 'Forge BattleVerse', href: '/products/battleverse/' },
      { label: 'BattleVerse Arena', href: '/products/battleverse/arena/' },
      { label: 'Creator Studio', href: '/products/battleverse/creator-studio/' },
      { label: 'ForgerEMS', href: '/projects/forgerems' },
      { label: 'Downloads & Releases', href: '/downloads/' },
      { label: 'Extended Portfolio', href: '/projects' },
    ],
  },
  {
    title: 'Solutions',
    links: [
      { label: 'Studio & Enterprise', href: '/solutions/' },
      { label: 'Game Developers', href: '/solutions/game-developers/' },
      { label: 'Gaming Studios', href: '/solutions/gaming-studios/' },
      { label: 'Anime & Manga', href: '/solutions/anime-manga-creators/' },
      { label: 'Animation Studios', href: '/solutions/animation-studios/' },
      { label: 'Software Teams', href: '/solutions/software-engineering/' },
      { label: 'Enterprise & Private AI', href: '/solutions/enterprise-private-ai/' },
    ],
  },
  {
    title: 'Research & Dev',
    links: [
      { label: 'Project Forge', href: '/research/project-forge/' },
      { label: 'Training Methodology', href: '/research/training/' },
      { label: 'Developer Hub', href: '/developers/' },
      { label: 'Documentation', href: '/docs/' },
      { label: 'Releases (Forged)', href: '/forged' },
      { label: 'Trust Center', href: '/trust/' },
    ],
  },
  {
    title: 'Studio & Company',
    links: [
      { label: 'State Lines', href: '/studio/state-lines/' },
      { label: 'Original Productions', href: '/studio/productions/' },
      { label: 'Company & Vision', href: '/company/' },
      { label: 'About FDS', href: '/about' },
      { label: 'Newsroom', href: '/news/' },
      { label: 'Contact & Inquiries', href: '/contact/' },
      { label: 'Support FDS', href: '/support' },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <a href="/" class="footer-mark" aria-label="Forger Digital Solutions home">
        <img src="/images/brand/fds-logo.png" width="34" height="34" alt="" loading="lazy" />
        <span>Forger Digital Solutions</span>
      </a>
      <p class="footer-slogan">Build the tools. Build the worlds.</p>
      <p class="footer-description">
        Independent AI research laboratory, commercial technology company, autonomous software engineering provider, and original entertainment studio based in New Jersey.
      </p>
      <ul class="footer-social" aria-label="Verified Forger Digital Solutions social channels">
        <li><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
        <li><a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        {siteConfig.tiktokUrl && (
          <li><a href={siteConfig.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a></li>
        )}
      </ul>
    </div>

    {columns.map((column) => (
      <nav class="footer-links" aria-label={column.title}>
        <h3>{column.title}</h3>
        <ul>
          {column.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="footer-bottom">
    <div class="footer-legal">
      <a href="/privacy">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="/terms">Terms of Use</a>
      <span aria-hidden="true">·</span>
      <a href="/trust/">Trust Center</a>
      <span aria-hidden="true">·</span>
      <a href="/community-impact">Community Impact</a>
    </div>
    <p class="footer-colophon">
      &copy; {currentYear} Forger Digital Solutions · New Jersey, USA
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: 3.5rem;
    padding: 3.25rem 0 2rem;
    border-top: 1px solid var(--color-border-structural);
    background: var(--color-recessed);
  }

  .footer-container {
    width: min(calc(100% - 2.5rem), var(--content-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(5, minmax(0, 1fr));
    gap: 2rem 1.75rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer-mark img {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: contain;
  }

  .footer-slogan {
    margin: 0.85rem 0 0;
    color: var(--color-brand-silver);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .footer-description {
    max-width: 22rem;
    margin: 0.55rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.95rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-social a {
    color: var(--color-text-subtle);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .footer-social a:hover {
    color: var(--color-text);
  }

  .footer-links h3 {
    margin: 0 0 0.85rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.45rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.84rem;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 2.5rem), var(--content-width));
    margin: 1.25rem auto 0;
    /* Reserve clearance for fixed Kayla Copilot launcher in bottom-right corner */
    padding-inline-end: 14.5rem;
    color: var(--color-text-subtle);
    font-size: 0.78rem;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .footer-legal a {
    color: var(--color-text-subtle);
  }

  .footer-legal a:hover {
    color: var(--color-text);
  }

  .footer-colophon {
    margin: 0;
  }

  @media (max-width: 1120px) {
    .footer-container {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .footer-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-bottom {
      padding-inline-end: 0;
      padding-bottom: 4rem;
    }
  }
</style>
