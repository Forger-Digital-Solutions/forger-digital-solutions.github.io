---
import { siteConfig } from '../config/site';

const { cashAppHandle, cashAppUrl, kofiUrl } = siteConfig;
const hardwareMailtoHref = `mailto:${siteConfig.supportEmail}?subject=${encodeURIComponent(siteConfig.hardwareDonationSubject)}&body=${encodeURIComponent(siteConfig.hardwareDonationBody)}`;
---
<dialog id="fds-support-dialog" class="sdialog" role="dialog" aria-modal="true" aria-labelledby="sdialog-title" aria-describedby="sdialog-desc">
  <div class="sdialog__inner">
    <button type="button" class="sdialog__close" data-sdialog-close aria-label="Close support dialog"><span aria-hidden="true">×</span></button>
    <p class="sdialog__eyebrow">Support FDS</p>
    <h2 id="sdialog-title" class="sdialog__title">Help Forge What Comes Next</h2>
    <p id="sdialog-desc" class="sdialog__lead">
      Forger Digital Solutions is independently building AI, software,
      research, technology, and future community-focused projects.
    </p>
    <div class="sdialog__actions">
      <a href={cashAppUrl} target="_blank" rel="noopener noreferrer" class="saction">
        <span class="saction__title">Support Development</span>
        <span class="saction__desc">Workstations, GPUs, storage, testing equipment, and development services.</span>
        <span class="saction__cta">Cash App — {cashAppHandle}</span>
      </a>
      {kofiUrl && (
        <a href={kofiUrl} target="_blank" rel="noopener noreferrer" class="saction">
          <span class="saction__title">Support on Ko-fi</span>
          <span class="saction__desc">One-off or recurring support for independent research and development.</span>
          <span class="saction__cta">Visit Ko-fi</span>
        </a>
      )}
      <a href={hardwareMailtoHref} class="saction">
        <span class="saction__title">Donate Old Technology</span>
        <span class="saction__desc">Have a laptop, workstation, GPU, server, storage device, or other usable technology?</span>
        <span class="saction__cta">Contact FDS</span>
      </a>
      <a href="/community-impact" class="saction">
        <span class="saction__title">Community Impact</span>
        <span class="saction__desc">Affordable-community concepts, gardens, technology reuse, and future initiatives.</span>
        <span class="saction__cta">Learn About Community Impact</span>
      </a>
    </div>
    <form method="dialog" class="sdialog__form">
      <button type="submit" class="btn btn-primary sdialog__continue">Continue to FDS</button>
      <button type="submit" class="sdialog__later" value="maybe-later">Maybe later</button>
    </form>
  </div>
</dialog>
<style>
  .sdialog { width: min(92vw, 33rem); max-height: min(88dvh, 44rem); padding: 0; border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); overflow: auto; background: var(--color-bg-secondary); color: var(--color-text); box-shadow: var(--shadow-md); }.sdialog::backdrop { background: rgba(4, 5, 7, .74); backdrop-filter: blur(3px); }  .sdialog[open] { animation: sdialog-in .26s ease; }
  @media (prefers-reduced-motion: reduce) { .sdialog[open] { animation: none; } }
  @keyframes sdialog-in { from { opacity: 0; transform: translateY(.75rem) scale(.985); } to { opacity: 1; transform: none; } }
  :global(html.has-open-dialog) { overflow: hidden; }

  .sdialog__inner { position: relative; display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.3rem, 4.5vw, 2rem); }
  .sdialog__close { position: absolute; top: .8rem; right: .8rem; display: inline-flex; align-items: center; justify-content: center; width: 2.2rem; height: 2.2rem; border: 1px solid transparent; border-radius: 50%; background: transparent; color: var(--color-text-muted); font-size: 1.35rem; line-height: 1; cursor: pointer; transition: color .2s ease, border-color .2s ease; }.sdialog__close:hover { color: var(--color-text); border-color: var(--color-border-strong); }
  .sdialog__eyebrow { margin: 0; color: var(--color-accent); font: 700 .7rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .sdialog__title { margin: 0; font-size: clamp(1.5rem, 5vw, 1.9rem); line-height: 1.15; letter-spacing: -.03em; }
  .sdialog__lead { margin: 0; color: var(--color-text-muted); font-size: .95rem; line-height: 1.65; }

  .sdialog__actions { display: grid; gap: .6rem; }
  .saction { display: grid; gap: .18rem; padding: .85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); transition: border-color .2s ease, transform .2s ease; }.saction:hover { border-color: var(--color-accent-secondary); transform: translateY(-1px); }
  .saction__title { color: var(--color-text); font-size: .98rem; font-weight: 750; letter-spacing: -.01em; }
  .saction__desc { color: var(--color-text-muted); font-size: .84rem; line-height: 1.55; }
  .saction__cta { margin-top: .25rem; color: var(--color-accent-secondary); font: 700 .72rem/1 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }

  .sdialog__form { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; align-items: center; justify-content: center; margin-top: .2rem; }
  .sdialog__continue { flex: 1 1 12rem; }
  .sdialog__later { padding: .5rem; border: 0; background: transparent; color: var(--color-text-muted); font-size: .88rem; cursor: pointer; transition: color .2s ease; }.sdialog__later:hover { color: var(--color-text); }
</style>
  <script>
  (function () {
    const DIALOG_ID = 'fds-support-dialog';
    const STORAGE_KEY = 'fds_support_dismissed_at';
    const DEDUP_MS = 24 * 60 * 60 * 1000;
    const TRIGGER = 0.6; // open around ~60% of the homepage journey

    const dialog = document.getElementById(DIALOG_ID) as HTMLDialogElement | null;
    if (!dialog || typeof dialog.showModal !== 'function') return;
    // Homepage-only: the dialog is rendered solely on the homepage, but guard regardless.
    if (location.pathname !== '/') return;

    const now = Date.now();
    const dismissedAt = (() => {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        return raw ? Number(raw) : NaN;
      } catch {
        return NaN;
      }
    })();
    if (!Number.isNaN(dismissedAt) && now - dismissedAt < DEDUP_MS) return;

    let opened = false;
    let ticking = false;

    const progress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    };

    const open = () => {
      if (opened || dialog.open) return;
      opened = true;
      document.documentElement.classList.add('has-open-dialog');
      dialog.showModal();
    };

    const evaluate = () => {
      ticking = false;
      if (opened || dialog.open) return;
      // Require genuine scroll progress so a fresh top-of-page load never pops the dialog.
      if (progress() >= TRIGGER && window.scrollY > 0) open();
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(evaluate);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    // Also evaluate once on load (e.g. a mid-page refresh already past the trigger).
    evaluate();

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('has-open-dialog');
      // Any dismissal (button, backdrop, ESC, X) is remembered so the visitor isn't nagged.
      try {
        window.localStorage.setItem(STORAGE_KEY, String(Date.now()));
      } catch {
        // private browsing / blocked storage — ignore
      }
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && dialog.open) dialog.close();
    });

    dialog.querySelector('[data-sdialog-close]')?.addEventListener('click', () => {
      if (dialog.open) dialog.close();
    });
  })();
  </script>
