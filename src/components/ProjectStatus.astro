---
import type { Project } from '../types';

interface Props {
  status: Project['status'];
}

const { status } = Astro.props;
const statusClass = status.toLowerCase().replaceAll(' ', '-');
---
<span class={`project-status project-status--${statusClass}`}>
  <span class="project-status__dot" aria-hidden="true"></span>
  {status}
</span>

<style>
  .project-status { display: inline-flex; align-items: center; gap: .45rem; width: fit-content; padding: .35rem .6rem; border: 1px solid var(--color-border-strong); border-radius: 999px; color: var(--color-text-muted); background: rgba(255,255,255,.025); font: 700 .67rem/1 var(--font-mono); letter-spacing: .08em; white-space: nowrap; }
  .project-status__dot { width: .42rem; height: .42rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 .18rem color-mix(in srgb, currentColor 12%, transparent); }
  .project-status--active-research { color: var(--color-status-active); }
  .project-status--active-development, .project-status--released { color: #78ce9a; }
  .project-status--private-development { color: var(--color-status-private); }
  .project-status--experimental { color: var(--color-status-experimental); }
  .project-status--planned { color: var(--color-text-subtle); }
  @media (prefers-reduced-motion: no-preference) { .project-status--active-research .project-status__dot, .project-status--active-development .project-status__dot { animation: status-pulse 2.4s ease-in-out infinite; } @keyframes status-pulse { 50% { box-shadow: 0 0 0 .35rem color-mix(in srgb, currentColor 0%, transparent); } } }
</style>
