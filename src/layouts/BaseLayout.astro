---
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KaylaCopilot from '../components/KaylaCopilot.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { buildPageContext } from '../lib/kayla/context';
import type { RegistryAccent } from '../data/registry';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWebp?: string;
  noindex?: boolean;
  robots?: string;
  accent?: RegistryAccent;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, ogImageWebp, noindex, robots, accent, jsonLd } = Astro.props;
const robotsDirective = robots || (noindex ? 'noindex, nofollow' : undefined);
const pageTitle = title ? `${title} | ${siteConfig.name}` : `${siteConfig.name} — Studio Intelligence Hub & Game Engineering AI`;
const pageDesc =
  description ||
  'Forger Digital Solutions builds the Studio Intelligence Hub for Roblox and Unreal teams, specialized AI models, developer software, and original games.';
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;
const primaryOgPath = ogImage || siteConfig.ogImage;
const ogImageUrl = new URL(primaryOgPath, siteConfig.siteUrl).href;
const ogImageType = primaryOgPath.endsWith('.png')
  ? 'image/png'
  : primaryOgPath.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const ogImageWebpUrl = ogImageWebp ? new URL(ogImageWebp, siteConfig.siteUrl).href : undefined;
const kaylaPageContext = buildPageContext(Astro.url.pathname);
const isHomepage = Astro.url.pathname === '/';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  url: siteConfig.siteUrl,
  logo: new URL('/images/brand/fds-logo.png', siteConfig.siteUrl).href,
  founder: { '@type': 'Person', name: siteConfig.author },
  description: pageDesc,
  sameAs: [siteConfig.githubUrl, siteConfig.youtubeUrl, siteConfig.linkedinUrl].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  url: siteConfig.siteUrl,
  publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.siteUrl },
};

const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en" data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {robotsDirective && <meta name="robots" content={robotsDirective} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={siteConfig.author} />
    <meta name="theme-color" content="#08090c" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=fds-r2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=fds-r2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=fds-r2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=fds-r2" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico?v=fds-r2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=fds-r2" />
    <link rel="manifest" href="/site.webmanifest?v=fds-r2" />

    <!-- Open Graph & Social -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    {ogImageType !== 'image/webp' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {ogImageWebpUrl && (
      <>
        <meta property="og:image" content={ogImageWebpUrl} />
        <meta property="og:image:type" content="image/webp" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {isHomepage && <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {extraSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Kayla Copilot page context -->
    <script is:inline define:vars={{ kaylaPageContext }}>
      window.__KAYLA_PAGE_CONTEXT__ = {
        route: kaylaPageContext.route,
        pageType: kaylaPageContext.pageType,
        entity: kaylaPageContext.entity ?? '',
      };
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
    <KaylaCopilot />
    <script>
      // Mark sections immediately revealed for full visibility & CI visual certification compatibility
      const revealTargets = document.querySelectorAll<HTMLElement>(
        '.page-section, .page-head, .doc, .spage-hero, .hw-hero, .ci-hero, .lab-hero, .about-wrap'
      );
      revealTargets.forEach((target) => target.classList.add('is-revealed'));

      // Suspend decorative motion when tab is hidden
      const applyVisibility = () => {
        if (document.hidden) {
          document.documentElement.setAttribute('data-bg-paused', '');
        } else {
          document.documentElement.removeAttribute('data-bg-paused');
        }
      };
      document.addEventListener('visibilitychange', applyVisibility);
      applyVisibility();
    </script>
  </body>
</html>
